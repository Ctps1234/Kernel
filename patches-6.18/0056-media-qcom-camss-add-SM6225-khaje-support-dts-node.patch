--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -649,6 +649,187 @@ static const struct resources_icc icc_res_2290[] = {
 	},
 };
 
+/*
+ * SM6225 (khaje) carries the same sub-IP generations as
+ * QCM2290 (CSIPHY 3ph-1.0, CSID-340, VFE-340 "TFE") but
+ * three units of each. The tables below extend the 2290
+ * ones by the third unit and the resources wrapper keeps
+ * CAMSS_2290 so every code path is identical; the third
+ * CSID/VFE pair is only exercised by a third sensor.
+ * Register-level identity with 2290 is a downstream-data
+ * based assumption, not hardware-verified here.
+ */
+static const struct camss_subdev_resources csiphy_res_6225[] = {
+	/* CSIPHY0 */
+	{
+		.regulators = { "vdd-csiphy-1p2", "vdd-csiphy-1p8" },
+		.clock = { "top_ahb", "ahb", "csiphy0", "csiphy0_timer" },
+		.clock_rate = { { 0 },
+				{ 0 },
+				{ 240000000, 341330000, 384000000 },
