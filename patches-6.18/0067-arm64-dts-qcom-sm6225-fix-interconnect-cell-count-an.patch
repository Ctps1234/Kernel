From 4c9714751fad9e11aed0308d6870ac4cd2b59640 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Sun, 1 Nov 2026 19:06:47 +0000
Subject: [PATCH 67/68] arm64: dts: qcom: sm6225: fix interconnect cell count
 and tags

The RPM interconnect providers were declared with a single
specifier cell, but several consumers (CAMSS, and now USB)
already used the canonical two-cell form with RPM bucket tags
that qcom_icc_xlate_extended parses. The untagged one-cell
consumers (UFS, QUP, GPU, MDP) would misparse the other way.
Align everything with the Bengal upstream convention:
providers advertise two cells and every consumer specifier
carries RPM_ALWAYS_TAG (CAMSS keeps its existing tags).

Found while wiring the USB interconnects; compile and schema
gates never caught the mismatch because nothing validates
phandle argument counts against the provider cell count.

Signed-off-by: Arena Agent <agent@arena.local>
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 84 ++++++++++++++--------------
 1 file changed, 42 insertions(+), 42 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 975fd19e9e60..716eeb9b9b53 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -935,14 +935,14 @@ system_noc: interconnect@1880000 {
 				 <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
 				 <&gcc GCC_SYS_NOC_USB3_PRIM_AXI_CLK>;
 			clock-names = "bus", "bus_a", "cfg_axi", "sys_axi";
-			#interconnect-cells = <1>;
+			#interconnect-cells = <2>;
 
 			clk_virt: interconnect-clk {
 				compatible = "qcom,bengal-clk_virt";
 				clocks = <&rpmcc RPM_SMD_SNOC_CLK>,
 					 <&rpmcc RPM_SMD_SNOC_A_CLK>;
