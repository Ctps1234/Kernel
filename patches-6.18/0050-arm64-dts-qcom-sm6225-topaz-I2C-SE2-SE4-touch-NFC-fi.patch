From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Android Port <arena@arena.ai>
Date: Sat, 31 Oct 2026 18:30:05 +0000
Subject: [PATCH] arm64: dts: qcom: sm6225/topaz: I2C SE2/SE4, touch, NFC; fix
 console UART

Third patch of slice S5:

- SoC: qup pinctrl states (i2c2/i2c4/uart3) and children
  i2c@4a88000 (SE2), serial@4a8c000 (SE3), i2c@4a90000
  (SE4), upstream style, FIFOs only (no GPI DMA yet).
- Correction: the khaje console UART is SE3 (live-FDT
  alias hsuart0 -> qup_uart@4a8c000); slice S1 wrongly
  used SE4, which is the NFC I2C bus on topaz. serial0
  now points to uart3, uart4 stays disabled.
- Board: i2c2 (touch) and i2c4 (NFC) at 400 kHz with the
  SE clock pinned to XO 19.2 MHz (geni_i2c refuses other
  SE rates - hard-won lesson from the sm6225 mainline
  tapas bring-up).
- FocalTech FT5452 touchscreen node (pins/coords from
  the live FDT) + minimal binding. No driver for
  focaltech,fts in this tree yet - import pending.
- ST ST21NFC node (st,st21nfcc-i2c) with irq gpio70 /
  reset gpio69 from the live FDT; clkreq gpio71 and the
  RF clock are outside the upstream binding and remain
  unverified.
---
 .../input/touchscreen/focaltech,fts.yaml      |  85 ++++++++++++++
 .../boot/dts/qcom/sm6225-xiaomi-topaz.dts     | 108 +++++++++++++++++-
 arch/arm64/boot/dts/qcom/sm6225.dtsi          |  87 ++++++++++++++
 3 files changed, 278 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/focaltech,fts.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/focaltech,fts.yaml b/Documentation/devicetree/bindings/input/touchscreen/focaltech,fts.yaml
new file mode 100644
index 000000000..6a39436b9
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/focaltech,fts.yaml
@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/focaltech,fts.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FocalTech FTS I2C touchscreen controller
+
+maintainers:
+  - Porting Team <noreply@localhost>
+
+description:
+  Binding for FocalTech FTS-family capacitive touch controllers
+  (e.g. FT5452) as described by the downstream vendor devicetree
+  usage. There is currently no driver in this tree for this
+  compatible; the binding documents the hardware description the
+  downstream/mainline-port drivers consume (gpios, coordinate
+  range, touch count).
+
+properties:
+  compatible:
+    const: focaltech,fts
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  focaltech,irq-gpio:
+    maxItems: 1
+    description: GPIO connected to the controller IRQ output.
+
+  focaltech,reset-gpio:
+    maxItems: 1
+    description: GPIO connected to the controller reset input.
+
+  focaltech,avdd-gpio:
+    maxItems: 1
+    description: GPIO enabling the controller AVDD supply.
+
+  focaltech,display-coords:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: minimum X
+      - description: minimum Y
+      - description: maximum X
+      - description: maximum Y
+    description: Reported coordinate range of the touch firmware.
+
+  focaltech,max-touch-number:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Maximum number of simultaneous touch points.
+
+  vcc_i2c-supply:
+    description: I2C bus pull-up supply.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@38 {
+            compatible = "focaltech,fts";
+            reg = <0x38>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <80 IRQ_TYPE_EDGE_FALLING>;
+            focaltech,irq-gpio = <&tlmm 80 GPIO_ACTIVE_LOW>;
+            focaltech,reset-gpio = <&tlmm 86 GPIO_ACTIVE_LOW>;
+            focaltech,avdd-gpio = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+            focaltech,display-coords = <0 0 10799 23999>;
+            focaltech,max-touch-number = <10>;
+        };
+    };
diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
index d175aef40..abf2efd17 100644
--- a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
@@ -26,7 +26,7 @@ / {
 	chassis-type = "handset";
 
 	aliases {
-		serial0 = &uart4;
+		serial0 = &uart3;
 	};
 
 	chosen {
@@ -266,6 +266,68 @@ &qupv3_id_0 {
 	status = "okay";
 };
 
+/*
+ * Touchscreen on SE2. The GENI SE clock must be pinned to
+ * XO 19.2 MHz: geni_i2c rejects any SE source that is not
+ * exactly 19.2/32 MHz (lesson from the sm6225 mainline
+ * work on tapas; same bus here).
+ */
+&i2c2 {
+	assigned-clocks = <&gcc GCC_QUPV3_WRAP0_S2_CLK>;
+	assigned-clock-rates = <19200000>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * FocalTech FT5452 (chip id 0x5452), pins/coords from
+	 * the live FDT. NOTE: there is no driver in this tree
+	 * for "focaltech,fts" yet (downstream/Xiaomi driver
+	 * and the mainline port use this compatible); node
+	 * describes the hardware ready for that import.
+	 */
+	touchscreen@38 {
+		compatible = "focaltech,fts";
+		reg = <0x38>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <80 IRQ_TYPE_EDGE_FALLING>;
+		focaltech,irq-gpio = <&tlmm 80 GPIO_ACTIVE_LOW>;
+		focaltech,reset-gpio = <&tlmm 86 GPIO_ACTIVE_LOW>;
+		focaltech,avdd-gpio = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+		focaltech,display-coords = <0 0 10799 23999>;
+		focaltech,max-touch-number = <10>;
+		pinctrl-names = "default", "suspend";
+		pinctrl-0 = <&ts_int_active &ts_reset_active>;
+		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
+		vcc_i2c-supply = <&pm6125_l9>;
+	};
+};
+
+/* NFC (ST ST21NFC) on SE4. */
+&i2c4 {
+	assigned-clocks = <&gcc GCC_QUPV3_WRAP0_S4_CLK>;
+	assigned-clock-rates = <19200000>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Pins from the live FDT (irq gpio70, reset gpio69).
+	 * The clkreq gpio71 and the RF reference clock the
+	 * vendor stack manages are not part of the upstream
+	 * binding; whether the part answers without explicit
+	 * clock control is untested. ese/uicc presence is
+	 * unconfirmed, defaults left off.
+	 */
+	nfc@8 {
+		compatible = "st,st21nfcc-i2c";
+		reg = <0x08>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <70 IRQ_TYPE_LEVEL_HIGH>;
+		reset-gpios = <&tlmm 69 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&nfc_default>;
+	};
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/sm6225/xiaomi/topaz/adsp.mbn";
 	status = "okay";
@@ -402,7 +464,12 @@ wcd937x: audio-codec {
 	};
 };
 
-&uart4 {
+/*
+ * Console comes out on SE3 (per the live FDT hsuart0
+ * alias) - S1 initially wrongly used SE4, which is the
+ * NFC I2C bus on this board. uart4 stays disabled.
+ */
+&uart3 {
 	status = "okay";
 };
 
@@ -476,6 +543,43 @@ &mdss_dsi0_phy {
 };
 
 &tlmm {
+	ts_int_active: ts-int-active-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+		input-enable;
+	};
+
+	ts_int_suspend: ts-int-suspend-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	ts_reset_active: ts-reset-active-state {
+		pins = "gpio86";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	ts_reset_suspend: ts-reset-suspend-state {
+		pins = "gpio86";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	nfc_default: nfc-default-state {
+		pins = "gpio69", "gpio70", "gpio71";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	lcd_reset_active: lcd-reset-active-state {
 		pins = "gpio82";
 		function = "gpio";
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index b646a206d..33642bef2 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -613,6 +613,27 @@ qup_uart4_sleep: qup-uart4-sleep-state {
 				drive-strength = <2>;
 				bias-pull-down;
 			};
+
+			qup_i2c2_default: qup-i2c2-default-state {
+				pins = "gpio6", "gpio7";
+				function = "qup2";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
+			qup_uart3_default: qup-uart3-default-state {
+				pins = "gpio8", "gpio9", "gpio10", "gpio11";
+				function = "qup3";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			qup_i2c4_default: qup-i2c4-default-state {
+				pins = "gpio12", "gpio13";
+				function = "qup4";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
 		};
 
 		gcc: clock-controller@1400000 {
@@ -865,6 +886,72 @@ qupv3_id_0: geniqup@4ac0000 {
 			ranges;
 			status = "disabled";
 
+			/*
+			 * QUP instances used on khaje per downstream
+			 * (GPI DMA not described yet; GENI falls back
+			 * to FIFO mode without dmas).
+			 */
+			i2c2: i2c@4a88000 {
+				compatible = "qcom,geni-i2c";
+				reg = <0x0 0x04a88000 0x0 0x4000>;
+				clock-names = "se";
+				clocks = <&gcc GCC_QUPV3_WRAP0_S2_CLK>;
+				pinctrl-names = "default";
+				pinctrl-0 = <&qup_i2c2_default>;
+				interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>;
+				interconnects = <&clk_virt MASTER_QUP_CORE_0
+						 &clk_virt SLAVE_QUP_CORE_0>,
+						<&bimc MASTER_AMPSS_M0
+						 &config_noc SLAVE_QUP_0>,
+						<&system_noc MASTER_QUP_0
+						 &bimc SLAVE_EBI_CH0>;
+				interconnect-names = "qup-core",
+						     "qup-config",
+						     "qup-memory";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+
+			/* khaje debug UART is SE3 (FDT hsuart0), not SE4. */
+			uart3: serial@4a8c000 {
+				compatible = "qcom,geni-uart";
+				reg = <0x0 0x04a8c000 0x0 0x4000>;
+				interrupts = <GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&gcc GCC_QUPV3_WRAP0_S3_CLK>;
+				clock-names = "se";
+				pinctrl-names = "default";
+				pinctrl-0 = <&qup_uart3_default>;
+				interconnects = <&clk_virt MASTER_QUP_CORE_0
+						 &clk_virt SLAVE_QUP_CORE_0>,
+						<&bimc MASTER_AMPSS_M0
+						 &config_noc SLAVE_QUP_0>;
+				interconnect-names = "qup-core", "qup-config";
+				status = "disabled";
+			};
+
+			i2c4: i2c@4a90000 {
+				compatible = "qcom,geni-i2c";
+				reg = <0x0 0x04a90000 0x0 0x4000>;
+				clock-names = "se";
+				clocks = <&gcc GCC_QUPV3_WRAP0_S4_CLK>;
+				pinctrl-names = "default";
+				pinctrl-0 = <&qup_i2c4_default>;
+				interrupts = <GIC_SPI 331 IRQ_TYPE_LEVEL_HIGH>;
+				interconnects = <&clk_virt MASTER_QUP_CORE_0
+						 &clk_virt SLAVE_QUP_CORE_0>,
+						<&bimc MASTER_AMPSS_M0
+						 &config_noc SLAVE_QUP_0>,
+						<&system_noc MASTER_QUP_0
+						 &bimc SLAVE_EBI_CH0>;
+				interconnect-names = "qup-core",
+						     "qup-config",
+						     "qup-memory";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+
 			uart4: serial@4a90000 {
 				compatible = "qcom,geni-debug-uart";
 				reg = <0x0 0x04a90000 0x0 0x4000>;
-- 
