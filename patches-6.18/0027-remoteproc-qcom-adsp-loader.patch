diff --git a/Documentation/ABI/testing/sysfs-kernel-boot_adsp b/Documentation/ABI/testing/sysfs-kernel-boot_adsp
new file mode 100644
index 000000000..13bf0e69a
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-kernel-boot_adsp
@@ -0,0 +1,31 @@
+What:		/sys/kernel/boot_adsp
+Date:		Oct 2026
+KernelVersion:	6.12
+Contact:	linux-remoteproc@vger.kernel.org
+Description:
+		Compatibility interface created by the Qualcomm ADSP
+		loader driver for userspaces that do not use the generic
+		remoteproc state file. It is present only when the
+		qcom,adsp-loader device has probed and controls the
+		remoteproc referenced by that device.
+
+What:		/sys/kernel/boot_adsp/boot
+Date:		Oct 2026
+KernelVersion:	6.12
+Contact:	linux-remoteproc@vger.kernel.org
+Description:
+		Write-only ADSP boot control. Writing "1" schedules
+		rproc_boot() for the ADSP remoteproc. Writing "0"
+		releases the loader's boot reference through
+		rproc_shutdown(). New userspace should prefer the
+		generic /sys/class/remoteproc/remoteprocN/state
+		interface.
+
+What:		/sys/kernel/boot_adsp/ssr
+Date:		Oct 2026
+KernelVersion:	6.12
+Contact:	linux-remoteproc@vger.kernel.org
+Description:
+		Write-only subsystem restart control. Writing "1"
+		shuts the ADSP remoteproc down and then schedules it
+		to boot again.
diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,adsp-loader.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,adsp-loader.yaml
new file mode 100644
index 000000000..b6e57e1e2
--- /dev/null
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,adsp-loader.yaml
@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/remoteproc/qcom,adsp-loader.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm ADSP loader
+
+maintainers:
+  - Bjorn Andersson <andersson@kernel.org>
+  - Mathieu Poirier <mathieu.poirier@linaro.org>
+
+description: |
+  The Qualcomm ADSP loader is a small compatibility node used by
+  Qualcomm Android platforms to control boot and subsystem restart of
+  the ADSP remoteproc from userspace. It refers to the ADSP remoteproc
+  node and can carry the firmware variant selection data read from
+  the adsp_variant NVMEM cell.
+
+properties:
+  compatible:
+    const: qcom,adsp-loader
+
+  qcom,rproc-handle:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the ADSP remoteproc node.
+
+  qcom,adsp-state:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Initial ADSP state hint recorded in the vendor device tree. The
+      generic remoteproc state remains authoritative.
+
+  nvmem-cells:
+    maxItems: 1
+    description:
+      Reference to the adsp_variant NVMEM cell used to select an
+      entry from adsp-fw-names.
+
+  nvmem-cell-names:
+    items:
+      - const: adsp_variant
+
+  adsp-fw-names:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    minItems: 1
+    maxItems: 4
+    description:
+      Firmware image names indexed through adsp-fw-bit-values. A name
+      is applied to the remoteproc only when it is a complete
+      firmware file name; bare image stems keep the remoteproc
+      driver's default firmware name.
+
+  adsp-fw-bit-values:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 4
+    description:
+      adsp_variant values corresponding to each adsp-fw-names entry.
+
+  adsp-fuse-not-supported:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      When non-zero, firmware selection does not use the ADSP variant
+      fuse and adsp-fw-name is used instead.
+
+  adsp-fw-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description:
+      Firmware image name used when adsp-fuse-not-supported is
+      non-zero.
+
+required:
+  - compatible
+  - qcom,rproc-handle
+
+dependencies:
+  adsp-fw-names: [ adsp-fw-bit-values, nvmem-cells, nvmem-cell-names ]
+  adsp-fw-bit-values: [ adsp-fw-names ]
+  adsp-fw-name: [ adsp-fuse-not-supported ]
+
+additionalProperties: false
+
+examples:
+  - |
+    remoteproc_adsp: remoteproc@ab00000 {
+        reg = <0x0ab00000 0x100>;
+    };
+
+    adsp-loader {
+        compatible = "qcom,adsp-loader";
+        qcom,rproc-handle = <&remoteproc_adsp>;
+        qcom,adsp-state = <0>;
+    };
