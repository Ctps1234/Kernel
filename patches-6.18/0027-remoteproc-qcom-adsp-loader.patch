 obj-$(CONFIG_QCOM_Q6V5_MSS)		+= qcom_q6v5_mss.o
 obj-$(CONFIG_QCOM_Q6V5_PAS)		+= qcom_q6v5_pas.o
 obj-$(CONFIG_QCOM_Q6V5_WCSS)		+= qcom_q6v5_wcss.o
diff --git a/drivers/remoteproc/qcom_adsp_loader.c b/drivers/remoteproc/qcom_adsp_loader.c
new file mode 100644
index 000000000..526b024ab
--- /dev/null
+++ b/drivers/remoteproc/qcom_adsp_loader.c
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm ADSP loader compatibility driver
+ *
+ * The generic remoteproc sysfs interface is the preferred way to boot a
+ * remote processor from userspace. Some Qualcomm Android userspaces,
+ * however, still start the ADSP by writing to the vendor interface at
+ * /sys/kernel/boot_adsp/boot (and request a subsystem restart through
+ * /sys/kernel/boot_adsp/ssr). For example, the SM6225 (Khaje/Bengal)
+ * vendor init scripts write "1" to the boot file during early-boot.
+ *
+ * This driver keeps that small ABI working on top of the generic
+ * remoteproc core. It binds to the vendor qcom,adsp-loader node,
+ * resolves the remoteproc through qcom,rproc-handle and delegates the
+ * actual firmware loading to rproc_boot()/rproc_shutdown(). It does
+ * not implement the vendor AudioReach/SPF readiness check: protection
+ * domain clients observe the audio PD through the normal PDR path.
+ *
+ * The optional NVMEM adsp_variant selection from the vendor node is
+ * carried over. A selected name is applied with rproc_set_firmware()
+ * only when it already names a complete firmware file (.mdt/.mbn).
+ * Bare image stems, such as "adsp2" on Khaje, keep the remoteproc
+ * driver's default firmware name; this matches the effective vendor
+ * behaviour where the selected stem was never applied to the PAS
+ * remoteproc, and avoids inventing a firmware file name in the kernel.
+ */
+
+#include <linux/err.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/remoteproc.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+
+#define QCOM_ADSP_LOADER_MAX_FW_IMAGES	4
+
+struct qcom_adsp_loader {
+	struct device *dev;
+	struct rproc *rproc;
+	struct kobject *kobj;
+	struct work_struct boot_work;
+	struct mutex lock;	/* protects booted and fw_name_warned */
+	const char *fw_name;
+	bool booted;
+	bool fw_name_warned;
+};
+
+static DEFINE_MUTEX(qcom_adsp_loader_lock);
+static struct qcom_adsp_loader *qcom_adsp_loader_dev;
+
+static struct qcom_adsp_loader *qcom_adsp_loader_get(void)
+{
+	struct qcom_adsp_loader *loader;
+
+	mutex_lock(&qcom_adsp_loader_lock);
+	loader = qcom_adsp_loader_dev;
+	mutex_unlock(&qcom_adsp_loader_lock);
+
+	return loader;
+}
+
+static bool qcom_adsp_loader_str_has_suffix(const char *str, const char *suffix)
+{
+	size_t len = strlen(str);
+	size_t suffix_len = strlen(suffix);
+
+	return len >= suffix_len && !strcmp(str + len - suffix_len, suffix);
+}
+
+/* Called with loader->lock held, before rproc_boot(). */
+static int qcom_adsp_loader_apply_fw_name(struct qcom_adsp_loader *loader)
+{
+	int ret;
+
+	if (!loader->fw_name)
+		return 0;
+
+	if (!qcom_adsp_loader_str_has_suffix(loader->fw_name, ".mdt") &&
+	    !qcom_adsp_loader_str_has_suffix(loader->fw_name, ".mbn")) {
+		if (!loader->fw_name_warned) {
+			loader->fw_name_warned = true;
+			dev_warn(loader->dev,
+				 "selected firmware \"%s\" is not a file name, keeping %s\n",
+				 loader->fw_name,
+				 loader->rproc->firmware ?
+					loader->rproc->firmware : "default");
+		}
+		return 0;
+	}
+
+	if (loader->rproc->firmware &&
+	    !strcmp(loader->rproc->firmware, loader->fw_name))
+		return 0;
+
+	ret = rproc_set_firmware(loader->rproc, loader->fw_name);
+	if (ret)
+		dev_err(loader->dev, "failed to set firmware \"%s\": %d\n",
+			loader->fw_name, ret);
+
+	return ret;
+}
+
+/* Called with loader->lock held. */
+static int qcom_adsp_loader_boot_locked(struct qcom_adsp_loader *loader)
+{
+	int ret;
+
+	if (loader->booted)
+		return 0;
+
+	ret = qcom_adsp_loader_apply_fw_name(loader);
+	if (ret)
+		return ret;
+
+	ret = rproc_boot(loader->rproc);
+	if (!ret)
+		loader->booted = true;
+
+	return ret;
+}
+
+/* Called with loader->lock held. */
+static int qcom_adsp_loader_shutdown_locked(struct qcom_adsp_loader *loader)
+{
+	int ret;
+
+	if (!loader->booted)
+		return 0;
+
+	ret = rproc_shutdown(loader->rproc);
+	if (!ret)
+		loader->booted = false;
+
+	return ret;
+}
+
+static void qcom_adsp_loader_boot_work(struct work_struct *work)
+{
+	struct qcom_adsp_loader *loader;
+	int ret;
+
+	loader = container_of(work, struct qcom_adsp_loader, boot_work);
+
+	mutex_lock(&loader->lock);
+	ret = qcom_adsp_loader_boot_locked(loader);
+	mutex_unlock(&loader->lock);
+
+	if (ret)
+		dev_err(loader->dev, "failed to boot %s: %d\n",
+			loader->rproc->name, ret);
+}
+
+static int qcom_adsp_loader_unload(struct qcom_adsp_loader *loader)
+{
+	int ret;
+
+	cancel_work_sync(&loader->boot_work);
+
+	mutex_lock(&loader->lock);
+	ret = qcom_adsp_loader_shutdown_locked(loader);
+	mutex_unlock(&loader->lock);
+
+	if (ret)
+		dev_err(loader->dev, "failed to shut down %s: %d\n",
+			loader->rproc->name, ret);
+
+	return ret;
+}
+
+static ssize_t boot_store(struct kobject *kobj, struct kobj_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct qcom_adsp_loader *loader;
+	int command;
+	int ret;
+
+	loader = qcom_adsp_loader_get();
+	if (!loader)
+		return -ENODEV;
+
+	ret = kstrtoint(buf, 10, &command);
+	if (ret)
+		return ret;
+
+	switch (command) {
+	case 1:
+		schedule_work(&loader->boot_work);
+		return count;
+	case 0:
+		ret = qcom_adsp_loader_unload(loader);
+		return ret ? ret : count;
+	default:
+		return -EINVAL;
+	}
+}
+
+static ssize_t ssr_store(struct kobject *kobj, struct kobj_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct qcom_adsp_loader *loader;
+	int command;
+	int ret;
+
+	loader = qcom_adsp_loader_get();
+	if (!loader)
+		return -ENODEV;
+
+	ret = kstrtoint(buf, 10, &command);
+	if (ret)
+		return ret;
+
+	if (command != 1)
+		return -EINVAL;
+
+	ret = qcom_adsp_loader_unload(loader);
+	if (ret)
+		return ret;
+
+	schedule_work(&loader->boot_work);
+
+	return count;
+}
+
+static struct kobj_attribute boot_attribute =
+	__ATTR(boot, 0220, NULL, boot_store);
+static struct kobj_attribute ssr_attribute =
+	__ATTR(ssr, 0220, NULL, ssr_store);
+
+static struct attribute *qcom_adsp_loader_attrs[] = {
+	&boot_attribute.attr,
+	&ssr_attribute.attr,
+	NULL,
+};
+
+static const struct attribute_group qcom_adsp_loader_group = {
+	.attrs = qcom_adsp_loader_attrs,
+};
+
+static int qcom_adsp_loader_select_fw_name(struct qcom_adsp_loader *loader)
+{
+	struct device *dev = loader->dev;
+	struct device_node *np = dev->of_node;
+	u32 bit_values[QCOM_ADSP_LOADER_MAX_FW_IMAGES];
+	u32 fuse_not_supported = 0;
+	u32 variant;
+	int count;
+	int ret;
+	int i;
+
+	/* Boards without fuse support name the image directly. */
+	if (!of_property_read_u32(np, "adsp-fuse-not-supported",
+				  &fuse_not_supported) && fuse_not_supported) {
+		ret = of_property_read_string(np, "adsp-fw-name",
+					      &loader->fw_name);
+		if (ret && ret != -EINVAL)
+			dev_warn(dev, "failed to read adsp-fw-name: %d\n", ret);
+		return 0;
+	}
+
+	if (!of_property_present(np, "nvmem-cells"))
+		return 0;
+
+	ret = nvmem_cell_read_variable_le_u32(dev, "adsp_variant", &variant);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret) {
+		dev_warn(dev,
+			 "failed to read adsp_variant (%d), keeping default firmware\n",
+			 ret);
+		return 0;
+	}
+
+	count = of_property_count_strings(np, "adsp-fw-names");
+	if (count <= 0)
+		return 0;
+	if (count > QCOM_ADSP_LOADER_MAX_FW_IMAGES) {
+		dev_warn(dev, "too many adsp-fw-names (%d), keeping default firmware\n",
+			 count);
+		return 0;
+	}
+
+	if (of_property_count_u32_elems(np, "adsp-fw-bit-values") < count) {
+		dev_warn(dev, "missing adsp-fw-bit-values, keeping default firmware\n");
+		return 0;
+	}
+
+	ret = of_property_read_u32_array(np, "adsp-fw-bit-values",
+					 bit_values, count);
+	if (ret) {
+		dev_warn(dev,
+			 "failed to read adsp-fw-bit-values (%d), keeping default firmware\n",
+			 ret);
+		return 0;
+	}
+
+	for (i = 0; i < count; i++) {
+		if (bit_values[i] != variant)
+			continue;
+
+		ret = of_property_read_string_index(np, "adsp-fw-names", i,
+						    &loader->fw_name);
+		if (!ret)
+			dev_info(dev, "ADSP variant %u selects firmware \"%s\"\n",
+				 variant, loader->fw_name);
+		return 0;
+	}
+
+	dev_info(dev, "no firmware listed for ADSP variant %u, keeping default\n",
+		 variant);
+
+	return 0;
+}
+
+static int qcom_adsp_loader_probe(struct platform_device *pdev)
+{
+	struct qcom_adsp_loader *loader;
+	u32 adsp_state = 0;
+	phandle rproc_phandle;
+	int ret;
+
+	loader = devm_kzalloc(&pdev->dev, sizeof(*loader), GFP_KERNEL);
+	if (!loader)
+		return -ENOMEM;
+
+	loader->dev = &pdev->dev;
+	mutex_init(&loader->lock);
+	INIT_WORK(&loader->boot_work, qcom_adsp_loader_boot_work);
+
+	ret = of_property_read_u32(pdev->dev.of_node, "qcom,rproc-handle",
+				   &rproc_phandle);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "missing qcom,rproc-handle\n");
+
+	loader->rproc = rproc_get_by_phandle(rproc_phandle);
+	if (!loader->rproc)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "remoteproc not registered yet\n");
+
+	of_property_read_u32(pdev->dev.of_node, "qcom,adsp-state",
+			     &adsp_state);
+	if (adsp_state)
+		dev_dbg(&pdev->dev, "vendor ADSP state hint is %u\n",
+			adsp_state);
+
+	ret = qcom_adsp_loader_select_fw_name(loader);
+	if (ret)
+		goto err_put_rproc;
+
+	mutex_lock(&qcom_adsp_loader_lock);
+	if (qcom_adsp_loader_dev) {
+		mutex_unlock(&qcom_adsp_loader_lock);
+		ret = dev_err_probe(&pdev->dev, -EEXIST,
+				    "/sys/kernel/boot_adsp already registered\n");
+		goto err_put_rproc;
+	}
+	qcom_adsp_loader_dev = loader;
+	mutex_unlock(&qcom_adsp_loader_lock);
+
+	loader->kobj = kobject_create_and_add("boot_adsp", kernel_kobj);
+	if (!loader->kobj) {
+		ret = -ENOMEM;
+		goto err_clear_loader;
+	}
+
+	ret = sysfs_create_group(loader->kobj, &qcom_adsp_loader_group);
+	if (ret)
+		goto err_put_kobj;
+
+	platform_set_drvdata(pdev, loader);
+
+	dev_info(&pdev->dev, "boot control for %s ready\n",
+		 loader->rproc->name);
+
+	return 0;
+
+err_put_kobj:
+	kobject_put(loader->kobj);
+err_clear_loader:
+	mutex_lock(&qcom_adsp_loader_lock);
+	if (qcom_adsp_loader_dev == loader)
+		qcom_adsp_loader_dev = NULL;
+	mutex_unlock(&qcom_adsp_loader_lock);
+err_put_rproc:
+	rproc_put(loader->rproc);
+
+	return ret;
+}
+
+static void qcom_adsp_loader_remove(struct platform_device *pdev)
+{
+	struct qcom_adsp_loader *loader = platform_get_drvdata(pdev);
+	int ret;
+
+	if (!loader)
+		return;
+
+	mutex_lock(&qcom_adsp_loader_lock);
+	if (qcom_adsp_loader_dev == loader)
+		qcom_adsp_loader_dev = NULL;
+	mutex_unlock(&qcom_adsp_loader_lock);
+
+	sysfs_remove_group(loader->kobj, &qcom_adsp_loader_group);
+	kobject_put(loader->kobj);
+
+	ret = qcom_adsp_loader_unload(loader);
+	if (ret)
+		dev_err(&pdev->dev, "failed to shut down %s on remove: %d\n",
+			loader->rproc->name, ret);
+
+	rproc_put(loader->rproc);
+}
+
+static const struct of_device_id qcom_adsp_loader_dt_match[] = {
+	{ .compatible = "qcom,adsp-loader" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qcom_adsp_loader_dt_match);
+
