 	  driver.
 
+config QCOM_ADSP_LOADER
+	tristate "Qualcomm ADSP loader compatibility driver"
+	depends on OF && ARCH_QCOM
+	select NVMEM
+	help
+	  Say y here to preserve the Qualcomm Android ADSP loader ABI
+	  (/sys/kernel/boot_adsp/boot and /sys/kernel/boot_adsp/ssr) on
+	  top of the generic remoteproc core. The driver binds to
+	  qcom,adsp-loader, resolves the ADSP through qcom,rproc-handle
+	  and boots or restarts it with rproc_boot()/rproc_shutdown().
+	  It also carries the optional adsp_variant firmware selection
+	  from the vendor device tree.
+
 config QCOM_Q6V5_MSS
 	tristate "Qualcomm Hexagon V5 self-authenticating modem subsystem support"
 	depends on OF && ARCH_QCOM
diff --git a/drivers/remoteproc/Makefile b/drivers/remoteproc/Makefile
index 1c7598b84..c5cf25242 100644
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -25,6 +25,7 @@ obj-$(CONFIG_QCOM_PIL_INFO)		+= qcom_pil_info.o
 obj-$(CONFIG_QCOM_RPROC_COMMON)		+= qcom_common.o
 obj-$(CONFIG_QCOM_Q6V5_COMMON)		+= qcom_q6v5.o
 obj-$(CONFIG_QCOM_Q6V5_ADSP)		+= qcom_q6v5_adsp.o
