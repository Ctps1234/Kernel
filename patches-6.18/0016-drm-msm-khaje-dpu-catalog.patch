+/* Khaje SDE 6.10 data transcribed from the Topaz FDT and Creek overrides.
+ * Unrepresented Smart DMA v2.5, per-pipe priority, advanced DSPP, QSYNC and
+ * secure-UI features are intentionally not advertised by this catalog.
+ */
+
+#ifndef _DPU_6_10_KHAJE_H
+#define _DPU_6_10_KHAJE_H
+
+static const struct dpu_caps khaje_dpu_caps = {
