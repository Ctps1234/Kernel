+
+static const struct dpu_lm_cfg khaje_lm[] = {
+	{
+		.name = "lm_0", .id = LM_0,
+		.base = 0x44000, .len = 0x320,
+		.features = BIT(DPU_DIM_LAYER) | BIT(DPU_MIXER_COMBINED_ALPHA),
+		.sblk = &qcm2290_lm_sblk,
+		.lm_pair = 0,
+		.pingpong = PINGPONG_0,
+		.dspp = DSPP_0,
+	},
+};
+
+/* The upstream DSPP catalog models PCC, not the other Topaz DSPP blocks. */
+static const struct dpu_dspp_cfg khaje_dspp[] = {
+	{
+		.name = "dspp_0", .id = DSPP_0,
+		.base = 0x54000, .len = 0x1800,
+		.features = BIT(DPU_DSPP_PCC),
+		.sblk = &sdm845_dspp_sblk,
+	},
+};
+
+static const struct dpu_pingpong_cfg khaje_pp[] = {
+	{
+		.name = "pingpong_0", .id = PINGPONG_0,
+		.base = 0x70000, .len = 0xd4,
+		.features = PINGPONG_SM8150_MASK,
+		.sblk = &sdm845_pp_sblk,
+		.merge_3d = 0,
+		.intr_done = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR, 8),
+	},
+};
+
+static const struct dpu_dsc_cfg khaje_dsc[] = {
+	{
+		.name = "dsc_0", .id = DSC_0,
+		.base = 0x80000, .len = 0x140,
+		.features = BIT(DPU_DSC_OUTPUT_CTRL),
+	},
+};
+
+static const struct dpu_intf_cfg khaje_intf[] = {
+	{
+		.name = "intf_1", .id = INTF_1,
+		.base = 0x6a800, .len = 0x2c0,
+		.features = INTF_SC7180_MASK,
+		.type = INTF_DSI,
+		.controller_id = MSM_DSI_CONTROLLER_0,
+		.prog_fetch_lines_worst_case = 24,
+		.intr_underrun = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR, 26),
+		.intr_vsync = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR, 27),
+		.intr_tear_rd_ptr = DPU_IRQ_IDX(MDP_INTF1_TEAR_INTR, 2),
+	},
+};
+
+static const u32 khaje_rt_pri_lvl[] = {3, 3, 4, 4, 5, 5, 6, 6};
+static const u32 khaje_nrt_pri_lvl[] = {3, 3, 3, 3, 3, 3, 3, 3};
+
+static const struct dpu_vbif_cfg khaje_vbif[] = {
+	{
+		.name = "vbif_rt", .id = VBIF_RT,
+		.base = 0, .len = 0x2008,
+		.default_ot_rd_limit = 32,
+		.default_ot_wr_limit = 32,
+		.features = BIT(DPU_VBIF_QOS_REMAP) |
+			BIT(DPU_VBIF_DISABLE_SHAREABLE),
+		.xin_halt_timeout = 0x4000,
+		.qos_rp_remap_size = 0x40,
+		.qos_rt_tbl = {
+			.npriority_lvl = ARRAY_SIZE(khaje_rt_pri_lvl),
+			.priority_lvl = khaje_rt_pri_lvl,
+		},
+		.qos_nrt_tbl = {
+			.npriority_lvl = ARRAY_SIZE(khaje_nrt_pri_lvl),
+			.priority_lvl = khaje_nrt_pri_lvl,
+		},
+		.memtype_count = 14,
+		.memtype = {3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3},
+	},
+};
+
+/* No separate macrotile-QSEED usage exists in the upstream DPU QoS enum. */
+static const struct dpu_qos_lut_entry khaje_qos_linear[] = {
+	{.fl = 0, .lut = 0x0011222222335777},
+};
+
+static const struct dpu_qos_lut_entry khaje_qos_macrotile[] = {
+	{.fl = 0, .lut = 0x0011223344556677},
+};
+
+static const struct dpu_qos_lut_entry khaje_qos_nrt[] = {
+	{.fl = 0, .lut = 0x0},
+};
+
+static const struct dpu_perf_cfg khaje_perf_data = {
+	.max_bw_low = 3200000,
+	.max_bw_high = 4300000,
+	.min_core_ib = 2400000,
+	.min_llcc_ib = 0,
+	.min_dram_ib = 1600000,
+	.min_prefill_lines = 24,
+	.danger_lut_tbl = {0xff, 0xffff, 0x0},
+	.safe_lut_tbl = {0xfff0, 0xff00, 0xffff},
+	.qos_lut_tbl = {
+		{.nentry = ARRAY_SIZE(khaje_qos_linear),
+		 .entries = khaje_qos_linear},
+		{.nentry = ARRAY_SIZE(khaje_qos_macrotile),
+		 .entries = khaje_qos_macrotile},
+		{.nentry = ARRAY_SIZE(khaje_qos_nrt),
+		 .entries = khaje_qos_nrt},
+	},
+	.cdp_cfg = {
+		{.rd_enable = 1, .wr_enable = 1},
+		{.rd_enable = 1, .wr_enable = 0},
+	},
+	.clk_inefficiency_factor = 105,
+	.bw_inefficiency_factor = 120,
+};
+
+static const struct dpu_mdss_version khaje_mdss_ver = {
+	.core_major_ver = 6,
+	.core_minor_ver = 10,
+};
+
+const struct dpu_mdss_cfg dpu_khaje_cfg = {
+	.mdss_ver = &khaje_mdss_ver,
+	.caps = &khaje_dpu_caps,
+	.mdp = &khaje_mdp,
+	.ctl_count = ARRAY_SIZE(khaje_ctl),
+	.ctl = khaje_ctl,
+	.sspp_count = ARRAY_SIZE(khaje_sspp),
+	.sspp = khaje_sspp,
+	.mixer_count = ARRAY_SIZE(khaje_lm),
+	.mixer = khaje_lm,
+	.dspp_count = ARRAY_SIZE(khaje_dspp),
+	.dspp = khaje_dspp,
+	.dsc_count = ARRAY_SIZE(khaje_dsc),
+	.dsc = khaje_dsc,
+	.pingpong_count = ARRAY_SIZE(khaje_pp),
+	.pingpong = khaje_pp,
+	.intf_count = ARRAY_SIZE(khaje_intf),
+	.intf = khaje_intf,
+	.vbif_count = ARRAY_SIZE(khaje_vbif),
+	.vbif = khaje_vbif,
+	.perf = &khaje_perf_data,
+};
+
+#endif /* _DPU_6_10_KHAJE_H */
