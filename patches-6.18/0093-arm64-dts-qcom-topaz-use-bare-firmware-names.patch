From 8379fbdea477c734e748361cec8c0cfc85f80faf Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Wed, 4 Nov 2026 00:21:30 +0000
Subject: [PATCH 93/94] arm64: dts: qcom: topaz: use bare firmware names

Android's ueventd on the stock-derived vendor images
searches a single firmware directory
(/vendor/firmware_mnt/image/), so the qcom/... style
paths do not resolve there. Use the bare names of the
files in the stock firmware layout instead; this also
fixes the ADSP and zap images, which are split .mdt
files downstream, not .mbn.

Signed-off-by: Arena Agent <agent@arena.local>
---
 arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
index d2d5cb97a2be..4e7cc016bfcf 100644
--- a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
@@ -508,7 +508,7 @@ irled@1 {
 };
 
 &remoteproc_adsp {
-	firmware-name = "qcom/sm6225/xiaomi/topaz/adsp.mbn";
+	firmware-name = "adsp.mdt";
 	status = "okay";
 };
 
@@ -519,13 +519,13 @@ &remoteproc_adsp {
  * out of scope for the kernel description.
  */
 &remoteproc_mpss {
-	firmware-name = "qcom/sm6225/xiaomi/topaz/modem.mdt";
+	firmware-name = "modem.mdt";
 	status = "okay";
 };
 
 /* Compute DSP (stock split cdsp.mdt firmware). */
 &remoteproc_cdsp {
-	firmware-name = "qcom/sm6225/xiaomi/topaz/cdsp.mdt";
+	firmware-name = "cdsp.mdt";
 	status = "okay";
 };
 
@@ -882,7 +882,7 @@ &gpu {
 	status = "okay";
 
 	zap-shader {
-		firmware-name = "qcom/sm6225/xiaomi/topaz/a610_zap.mbn";
+		firmware-name = "a610_zap.mdt";
 	};
 };
 
