diff --git a/include/dt-bindings/msm-camera.h b/include/dt-bindings/msm-camera.h
new file mode 100644
index 000000000..f8f2f0f4c
--- /dev/null
+++ b/include/dt-bindings/msm-camera.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Constantes de camera usadas pelas device trees de topaz/tapas (Khaje).
+ *
+ * A base 6.12 nao traz os headers vendor de camera; as DTS importadas
+ * usam apenas o tipo do flash como valor numerico (os demais nomes, como
+ * "CAM_RESET0" ou "CAMIF_MCLK0", aparecem como rotulo de string em
+ * gpio-req-tbl-label). O valor 1 de CAM_FLASH_TYPE_I2C foi conferido
+ * contra o FDT real do aparelho (flash-type = <0x1>).
+ */
+
+#ifndef __MSM_CAMERA_H
+#define __MSM_CAMERA_H
+
+/* Tipos de flash da camera */
+#define CAM_FLASH_TYPE_PMIC 0
+#define CAM_FLASH_TYPE_I2C  1
+#define CAM_FLASH_TYPE_GPIO 2
+
+#endif /* __MSM_CAMERA_H */
