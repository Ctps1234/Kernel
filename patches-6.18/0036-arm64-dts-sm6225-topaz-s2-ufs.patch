From 74ab8652b18eb28d24fbf060ad261b3e4b4e60db Mon Sep 17 00:00:00 2001
From: Arena <arena@local>
Date: Fri, 30 Oct 2026 17:50:46 +0000
Subject: [PATCH] arm64: dts: qcom: sm6225/topaz: add UFS host and QMP PHY (S2)

Slice S2 of the DT plan: ufshc@4804000 (std+ICE, IRQ 356, 2 lanes,
the nine canonical clocks with the live-FDT frequency ranges and the
two interconnect paths) and qcom,sm6225-qmp-ufs-phy@4807000 with the
nine clocks declared by the series' PHY binding, all translated from
the downstream khaje nodes of the same addresses.

Pull the four physical PM6125 LDO rails the storage path needs in
from the board slice: L4 (vdda-phy, 0.88 V), L18 (vdda-pll, 1.232 V),
L11 (vccq2, 1.8 V) and L24 (vcc, 2.96 V), as RPM SMD resources with
the final voltage windows/init values from the live FDT. The board
wires vcc/vccq2 at 800 mA, the PHY supplies, and the UFS reset on
TLMM gpio113 (ufs_reset, active-low), all as the FDT has them.

Add qcom,sm6225-ufshc to qcom,ufs.yaml in the 9-clock group (it has
the second RX lane clock the SM6115 group lacks).

Deliberate gaps for later slices: no power-domains - gcc-khaje
registers no GDSCs yet, downstream routes vdd-hba to the UFS PHY
GDSC; no iommus until the apps SMMU node exists (FDT SID 0x100). The
downstream HS-G3 cap is not expressible in the upstream binding; the
2-lane UFS 2.2 device negotiates G3 anyway. Not boot-tested: CI
dtbs/dtbs_check only.
---
 .../devicetree/bindings/ufs/qcom,ufs.yaml     |   3 +
 .../boot/dts/qcom/sm6225-xiaomi-topaz.dts     |  17 ++
 arch/arm64/boot/dts/qcom/sm6225.dtsi          | 174 ++++++++++++++++++
 3 files changed, 194 insertions(+)

diff --git a/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml b/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
index 1dd41f6d5..7ab3d11e3 100644
--- a/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
+++ b/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
@@ -22,6 +22,7 @@ select:
           - qcom,sdm845-ufshc
           - qcom,sm6115-ufshc
           - qcom,sm6125-ufshc
+          - qcom,sm6225-ufshc
           - qcom,sm6350-ufshc
           - qcom,sm8150-ufshc
   required:
@@ -37,6 +38,7 @@ properties:
           - qcom,sdm845-ufshc
           - qcom,sm6115-ufshc
           - qcom,sm6125-ufshc
+          - qcom,sm6225-ufshc
           - qcom,sm6350-ufshc
           - qcom,sm8150-ufshc
       - const: qcom,ufshc
@@ -68,6 +70,7 @@ allOf:
           contains:
             enum:
               - qcom,sdm845-ufshc
+              - qcom,sm6225-ufshc
               - qcom,sm6350-ufshc
               - qcom,sm8150-ufshc
     then:
diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
index 7b07a10d9..ba9371a7a 100644
--- a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
@@ -14,6 +14,8 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
+
 #include "sm6225.dtsi"
 
 / {
@@ -223,3 +225,18 @@ &qupv3_id_0 {
 &uart4 {
 	status = "okay";
 };
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 113 GPIO_ACTIVE_LOW>;
+	vcc-supply = <&pm6125_l24>;
+	vcc-max-microamp = <800000>;
+	vccq2-supply = <&pm6125_l11>;
+	vccq2-max-microamp = <800000>;
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&pm6125_l4>;
+	vdda-pll-supply = <&pm6125_l18>;
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index d40f127f5..4acc65ae8 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -324,6 +324,86 @@ regulator-s5-level-ao {
 						qcom,use-voltage-level;
 					};
 				};
+
+				/*
+				 * Physical PM6125 LDO rails consumed by
+				 * the UFS HC/PHY (slice S2). Resource
+				 * ids and hw types come from the
+				 * downstream pm6125-rpm-regulator.dtsi;
+				 * voltage windows and init voltages are
+				 * the final values from the live FDT.
+				 */
+				rpm-regulator-ldoa4 {
+					compatible = "qcom,rpm-smd-regulator-resource";
+					qcom,resource-name = "ldoa";
+					qcom,resource-id = <4>;
+					qcom,regulator-type = <0>;
+					qcom,regulator-hw-type = "pmic5-ldo";
+					qcom,hpm-min-load = <10000>;
+
+					pm6125_l4: regulator-l4 {
+						compatible = "qcom,rpm-smd-regulator";
+						regulator-name = "pm6125_l4";
+						qcom,set = <3>;
+						regulator-min-microvolt = <720000>;
+						regulator-max-microvolt = <1050000>;
+						qcom,init-voltage = <880000>;
+					};
+				};
+
+				rpm-regulator-ldoa11 {
+					compatible = "qcom,rpm-smd-regulator-resource";
+					qcom,resource-name = "ldoa";
+					qcom,resource-id = <11>;
+					qcom,regulator-type = <0>;
+					qcom,regulator-hw-type = "pmic5-ldo";
+					qcom,hpm-min-load = <10000>;
+
+					pm6125_l11: regulator-l11 {
+						compatible = "qcom,rpm-smd-regulator";
+						regulator-name = "pm6125_l11";
+						qcom,set = <3>;
+						regulator-min-microvolt = <1700000>;
+						regulator-max-microvolt = <1950000>;
+						qcom,init-voltage = <1800000>;
+					};
+				};
+
+				rpm-regulator-ldoa18 {
+					compatible = "qcom,rpm-smd-regulator-resource";
+					qcom,resource-name = "ldoa";
+					qcom,resource-id = <18>;
+					qcom,regulator-type = <0>;
+					qcom,regulator-hw-type = "pmic5-ldo";
+					qcom,hpm-min-load = <10000>;
+
+					pm6125_l18: regulator-l18 {
+						compatible = "qcom,rpm-smd-regulator";
+						regulator-name = "pm6125_l18";
+						qcom,set = <3>;
+						regulator-min-microvolt = <1100000>;
+						regulator-max-microvolt = <1300000>;
+						qcom,init-voltage = <1232000>;
+					};
+				};
+
+				rpm-regulator-ldoa24 {
+					compatible = "qcom,rpm-smd-regulator-resource";
+					qcom,resource-name = "ldoa";
+					qcom,resource-id = <24>;
+					qcom,regulator-type = <0>;
+					qcom,regulator-hw-type = "pmic5-ldo";
+					qcom,hpm-min-load = <10000>;
+
+					pm6125_l24: regulator-l24 {
+						compatible = "qcom,rpm-smd-regulator";
+						regulator-name = "pm6125_l24";
+						qcom,set = <3>;
+						regulator-min-microvolt = <2700000>;
+						regulator-max-microvolt = <3544000>;
+						qcom,init-voltage = <2960000>;
+					};
+				};
 			};
 		};
 	};
@@ -453,6 +533,100 @@ rpm_msg_ram: sram@45f0000 {
 			reg = <0x0 0x045f0000 0x0 0x7000>;
 		};
 
+		/*
+		 * Slice S2: UFS host + QMP PHY, translated from the
+		 * downstream khaje nodes. Two deliberate gaps, both
+		 * tracked in docs/dt-upstream-sm6225-plan.md: no
+		 * power-domains (the gcc-khaje driver registers no
+		 * GDSCs yet; downstream routes vdd-hba to the UFS PHY
+		 * GDSC) and no iommus (the apps SMMU node lands in its
+		 * own slice; the FDT SID is 0x100). The downstream
+		 * HS-G3 cap has no upstream DT equivalent; the 2-lane
+		 * UFS 2.2 device negotiates G3 on its own.
+		 */
+		ufs_mem_hc: ufshc@4804000 {
+			compatible = "qcom,sm6225-ufshc", "qcom,ufshc",
+				     "jedec,ufs-2.0";
+			reg = <0x0 0x04804000 0x0 0x3000>,
+			      <0x0 0x04810000 0x0 0x8000>;
+			reg-names = "std", "ice";
+			interrupts = <GIC_SPI 356 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&ufs_mem_phy>;
+			phy-names = "ufsphy";
+			lanes-per-direction = <2>;
+			#reset-cells = <1>;
+			resets = <&gcc GCC_UFS_PHY_BCR>;
+			reset-names = "rst";
+
+			clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
+				 <&gcc GCC_SYS_NOC_UFS_PHY_AXI_CLK>,
+				 <&gcc GCC_UFS_PHY_AHB_CLK>,
+				 <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
+				 <&rpmcc RPM_SMD_XO_CLK_SRC>,
+				 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>,
+				 <&gcc GCC_UFS_PHY_ICE_CORE_CLK>;
+			clock-names = "core_clk",
+				      "bus_aggr_clk",
+				      "iface_clk",
+				      "core_clk_unipro",
+				      "ref_clk",
+				      "tx_lane0_sync_clk",
+				      "rx_lane0_sync_clk",
+				      "rx_lane1_sync_clk",
+				      "ice_core_clk";
+
+			freq-table-hz = <50000000 200000000>,
+					<0 0>,
+					<0 0>,
+					<37500000 150000000>,
+					<0 0>,
+					<0 0>,
+					<0 0>,
+					<0 0>,
+					<75000000 300000000>;
+
+			interconnects = <&system_noc MASTER_UFS_MEM
+					 &bimc SLAVE_EBI_CH0>,
+					<&bimc MASTER_AMPSS_M0
+					 &config_noc SLAVE_UFS_MEM_CFG>;
+			interconnect-names = "ufs-ddr", "cpu-ufs";
+
+			status = "disabled";
+		};
+
+		ufs_mem_phy: phy@4807000 {
+			compatible = "qcom,sm6225-qmp-ufs-phy";
+			reg = <0x0 0x04807000 0x0 0xe00>;
+
+			clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>,
+				 <&gcc GCC_UFS_PHY_PHY_AUX_CLK>,
+				 <&gcc GCC_UFS_CLKREF_CLK>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK_SRC>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK_SRC>,
+				 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK_SRC>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>,
+				 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>;
+			clock-names = "ref_clk_src",
+				      "ref_aux_clk",
+				      "qref_clk",
+				      "rx_sym0_mux_clk",
+				      "rx_sym1_mux_clk",
+				      "tx_sym0_mux_clk",
+				      "rx_sym0_phy_clk",
+				      "rx_sym1_phy_clk",
+				      "tx_sym0_phy_clk";
+
+			resets = <&ufs_mem_hc 0>;
+			reset-names = "ufsphy";
+
+			#phy-cells = <0>;
+
+			status = "disabled";
+		};
+
 		qupv3_id_0: geniqup@4ac0000 {
 			compatible = "qcom,geni-se-qup";
 			reg = <0x0 0x04ac0000 0x0 0x2000>;
-- 
2.39.5

