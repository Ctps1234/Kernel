From 88f703bc4aeac79d09411f821a04197c8442d0ba Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Mon, 2 Nov 2026 21:16:14 +0000
Subject: [PATCH 78/80] dt-bindings: remoteproc: add SM6225 MPSS PAS

The khaje modem is booted through the PAS interface with
a single CX proxy power domain, mirroring the existing
SM6225 ADSP PAS binding.

Signed-off-by: Arena Agent <agent@arena.local>
---
 .../remoteproc/qcom,sm6225-mpss-pas.yaml      | 105 ++++++++++++++++++
 1 file changed, 105 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/remoteproc/qcom,sm6225-mpss-pas.yaml

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sm6225-mpss-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sm6225-mpss-pas.yaml
new file mode 100644
index 000000000000..074dc1a660f3
--- /dev/null
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sm6225-mpss-pas.yaml
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/remoteproc/qcom,sm6225-mpss-pas.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM6225 Modem Peripheral Authentication Service
+
+maintainers:
+  - Bjorn Andersson <andersson@kernel.org>
+  - Mathieu Poirier <mathieu.poirier@linaro.org>
+
+description:
+  Qualcomm SM6225 (Khaje) Peripheral Authentication Service loads and
+  boots firmware on the modem Hexagon DSP.
+
+properties:
+  compatible:
+    const: qcom,sm6225-mpss-pas
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: XO clock
+
+  clock-names:
+    items:
+      - const: xo
+
+  power-domains:
+    items:
+      - description: CX power domain
+
+  power-domain-names:
+    items:
+      - const: cx
+
+  interrupts:
+    maxItems: 6
+
+  interrupt-names:
+    maxItems: 6
+
+  memory-region:
+    maxItems: 1
+    description: Reference to the reserved-memory for the Hexagon core
+
+  smd-edge: false
+
+  firmware-name:
+    maxItems: 1
+    description: Firmware name for the Hexagon core
+
+required:
+  - compatible
+  - reg
+  - memory-region
+
+allOf:
+  - $ref: /schemas/remoteproc/qcom,pas-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmcc.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/power/qcom-rpmpd.h>
+
+    remoteproc@6080000 {
+        compatible = "qcom,sm6225-mpss-pas";
+        reg = <0x06080000 0x100>;
+
+        clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>;
+        clock-names = "xo";
+
+        power-domains = <&rpmpd SM6225_VDDCX>;
+        power-domain-names = "cx";
+
+        firmware-name = "qcom/sm6225/modem.mdt";
+
+        interrupts-extended = <&intc GIC_SPI 307 IRQ_TYPE_EDGE_RISING>,
+                              <&modem_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+                              <&modem_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+                              <&modem_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+                              <&modem_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
+                              <&modem_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
+        interrupt-names = "wdog", "fatal", "ready",
+                          "handover", "stop-ack", "shutdown-ack";
+
+        memory-region = <&mpss_mem>;
+
+        qcom,smem-states = <&modem_smp2p_out 0>;
+        qcom,smem-state-names = "stop";
+
+        glink-edge {
+            interrupts = <GIC_SPI 68 IRQ_TYPE_EDGE_RISING>;
+            label = "modem";
+            qcom,remote-pid = <1>;
+            mboxes = <&apcs_glb 12>;
+        };
+    };
-- 
