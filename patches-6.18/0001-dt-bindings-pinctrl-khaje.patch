From b31057e005f2121f57e94a978fbc233bc0348c5a Mon Sep 17 00:00:00 2001
From: Port <port@local>
Date: Thu, 29 Oct 2026 23:00:44 +0000
Subject: [PATCH 01/11] dt-bindings: pinctrl: qcom: add Khaje TLMM binding

Document the Khaje TLMM register window, controller interfaces, GPIO/pin
state structure, and mux names. The function list includes the eGPIO mode
checked against the Qualcomm Platform 5.0 R47 SoC repository.

The binding targets the pinned Android Common 6.12 tree; its function
enumeration matches the companion driver patch.
---
 .../bindings/pinctrl/qcom,khaje-pinctrl.yaml  | 284 ++++++++++++++++++
 1 file changed, 284 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pinctrl/qcom,khaje-pinctrl.yaml

diff --git a/Documentation/devicetree/bindings/pinctrl/qcom,khaje-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/qcom,khaje-pinctrl.yaml
new file mode 100644
index 000000000..cf88977b1
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/qcom,khaje-pinctrl.yaml
@@ -0,0 +1,284 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/qcom,khaje-pinctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Technologies, Inc. Khaje TLMM pin controller
+
+maintainers:
+  - Iskren Chernev <iskren.chernev@gmail.com>
+
+description:
+  Top Level Mode Multiplexer (TLMM) pin controller found on Qualcomm Khaje.
+  The controller exposes one register window containing the West, South and
+  East GPIO banks, the SDC pins and the dedicated UFS reset pin.
+
+properties:
+  compatible:
+    const: qcom,khaje-pinctrl
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  gpio-reserved-ranges: true
+
+patternProperties:
+  "^[A-Za-z0-9,_-]+$":
+    $ref: "#/$defs/qcom-khaje-pin-node"
+
+$defs:
+  qcom-khaje-pin-node:
+    oneOf:
+      - $ref: "#/$defs/qcom-khaje-tlmm-state"
+      - type: object
+        properties:
+          phandle: true
+          linux,phandle: true
+          name: true
+        patternProperties:
+          "^[A-Za-z0-9,_-]+$":
+            $ref: "#/$defs/qcom-khaje-pin-node"
+        additionalProperties: false
+
+  qcom-khaje-tlmm-state:
+    type: object
+    description:
+      Pinctrl node's client devices use subnodes for desired pin configuration.
+      Client device subnodes use standard pinconf and pinmux properties.
+    $ref: qcom,tlmm-common.yaml#/$defs/qcom-tlmm-state
+    unevaluatedProperties: false
+
+    properties:
+      phandle: true
+      linux,phandle: true
+      pins:
+        description:
+          List of GPIO or dedicated pins affected by the properties in this
+          subnode.
+        items:
+          oneOf:
+            - pattern: "^gpio([0-9]|[1-9][0-9]|10[0-9]|11[0-2])$"
+            - enum: [ sdc1_rclk, sdc1_clk, sdc1_cmd, sdc1_data,
+                      sdc2_clk, sdc2_cmd, sdc2_data, ufs_reset ]
+        minItems: 1
+
+      function:
+        description:
+          Select the alternative mux function for the specified pins.
+        enum:
+          - gpio
+          - qup0
+          - usb2phy_ac
+          - ddr_bist
+          - m_voc
+          - phase_flag0
+          - qdss_gpio8
+          - atest_tsens
+          - mpm_pwr
+          - phase_flag1
+          - qdss_gpio9
+          - atest_tsens2
+          - phase_flag2
+          - qdss_gpio10
