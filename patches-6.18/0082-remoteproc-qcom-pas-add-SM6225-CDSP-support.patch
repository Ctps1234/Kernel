From b566f283f57ccb4d98c1fe3b489e56f95875d904 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Mon, 2 Nov 2026 21:39:00 +0000
Subject: [PATCH 82/83] remoteproc: qcom: pas: add SM6225 CDSP support

Add the resource data for the khaje compute DSP PAS:
PAS ID 18, crash-reason SMEM 601 and the CX proxy power
domain from the downstream cdsp_pas node.

Signed-off-by: Arena Agent <agent@arena.local>
---
 drivers/remoteproc/qcom_q6v5_pas.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index d35fcb70daba..774180e77dd8 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -891,6 +891,20 @@ static const struct qcom_pas_data sdm845_adsp_resource_init = {
 	.ssctl_id = 0x14,
 };
 
+static const struct qcom_pas_data sm6225_cdsp_resource = {
+	.crash_reason_smem = 601,
+	.firmware_name = "cdsp.mdt",
+	.pas_id = 18,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"cx",
+		NULL
+	},
+	.ssr_name = "cdsp",
+	.sysmon_name = "cdsp",
+	.ssctl_id = 0x17,
+};
+
 static const struct qcom_pas_data sm6225_mpss_resource = {
 	.crash_reason_smem = 421,
 	.firmware_name = "modem.mdt",
@@ -1558,6 +1572,7 @@ static const struct of_device_id qcom_pas_of_match[] = {
 	{ .compatible = "qcom,sm6115-cdsp-pas", .data = &cdsp_resource_init},
 	{ .compatible = "qcom,sm6115-mpss-pas", .data = &sc8180x_mpss_resource},
 	{ .compatible = "qcom,sm6225-adsp-pas", .data = &sm6225_adsp_resource},
+	{ .compatible = "qcom,sm6225-cdsp-pas", .data = &sm6225_cdsp_resource},
 	{ .compatible = "qcom,sm6225-mpss-pas", .data = &sm6225_mpss_resource},
 	{ .compatible = "qcom,sm6350-adsp-pas", .data = &sm6350_adsp_resource},
 	{ .compatible = "qcom,sm6350-cdsp-pas", .data = &sm6350_cdsp_resource},
-- 
