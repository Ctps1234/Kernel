From 100eef994adf4565f5e09ccb662ee8bc546f6af5 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Mon, 2 Nov 2026 22:10:29 +0000
Subject: [PATCH 85/85] arm64: dts: qcom: sm6225: add IMEM sram

Describe the 4 kiB IMEM page at 0xc125000 from the
downstream khaje DT, as a plain syscon/simple-mfd SRAM.

Signed-off-by: Arena Agent <agent@arena.local>
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index c3cd11f8b4ce..266a0bad71cb 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -2533,6 +2533,16 @@ compute-cb@6 {
 		 * which pulls this node into the display slice; the UFS
 		 * stream is wired retroactively in the same patch.
 		 */
+		imem: sram@c125000 {
+			compatible = "qcom,sm6225-imem", "syscon", "simple-mfd";
+			reg = <0x0 0x0c125000 0x0 0x1000>;
+
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			ranges = <0 0x0 0x0c125000 0x1000>;
+		};
+
 		apps_smmu: iommu@c600000 {
 			compatible = "qcom,sm6225-smmu-500", "qcom,smmu-500", "arm,mmu-500";
 			reg = <0x0 0x0c600000 0x0 0x80000>;
-- 
