From 1e58a53d8acdbd6747423e4620288359c491a82b Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Mon, 2 Nov 2026 22:37:05 +0000
Subject: [PATCH] dt-bindings: add dual SPDX to project-authored khaje headers

Found by a checkpatch audit of the series: these two
binding headers were authored for this port, so license
them the usual way for DT binding files. The Qualcomm
imports keep their original tags.

Signed-off-by: Arena Agent <agent@arena.local>
---
 include/dt-bindings/audio-codec-port-types.h | 1 +
 include/dt-bindings/msm-camera.h             | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/include/dt-bindings/audio-codec-port-types.h b/include/dt-bindings/audio-codec-port-types.h
index 0ee5161082a8..1c91b858c36d 100644
--- a/include/dt-bindings/audio-codec-port-types.h
+++ b/include/dt-bindings/audio-codec-port-types.h
@@ -1,3 +1,4 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
 #ifndef __AUDIO_CODEC_PORT_TYPES_H
 #define __AUDIO_CODEC_PORT_TYPES_H
 
diff --git a/include/dt-bindings/msm-camera.h b/include/dt-bindings/msm-camera.h
index f8f2f0f4c0bc..c73f523bd0b3 100644
--- a/include/dt-bindings/msm-camera.h
+++ b/include/dt-bindings/msm-camera.h
@@ -1,4 +1,4 @@
-/* SPDX-License-Identifier: GPL-2.0-only */
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
 /*
  * Constantes de camera usadas pelas device trees de topaz/tapas (Khaje).
  *
-- 
2.39.5

