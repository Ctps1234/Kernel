From c01ef717a03952612a2094c54fda0b596d77b833 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Sun, 1 Nov 2026 21:18:21 +0000
Subject: [PATCH] arm64: dts: qcom: sm6225: add MPM wakeup controller

Model the MPM wakeup aggregator as on QCM2290: child of the
RPM remoteproc, APSS MPM registers carved out of the RPM
message RAM (which gains the mmio-sram child addressing),
mailbox channel 1 of the APCS global, GIC SPI 197, 96 pins.
The pin map is the Khaje table from the downstream MPM
driver. Wire the consumers that downstream routes through
it: the SPMI arbiter peripheral interrupt (pin 86) and the
DWC3 glue DP/DM/SS wakeups (pins 91, 90, 12).

Signed-off-by: Arena Agent <agent@arena.local>
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 52 +++++++++++++++++++++++-----
 1 file changed, 44 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 9cfd09afbf8a..1cdb7c5b0f30 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -415,6 +415,31 @@ smem: smem {
 	rpm: remoteproc {
 		compatible = "qcom,sm6225-rpm-proc", "qcom,rpm-proc";
 
+		/*
+		 * Wakeup interrupt aggregator. The pin map is the
+		 * Khaje table from the downstream MPM driver
+		 * (mpm_khaje_gic_chip_data): pin2 is left
+		 * unannotated there.
+		 */
+		mpm: interrupt-controller {
+			compatible = "qcom,mpm";
+			qcom,rpm-msg-ram = <&apss_mpm>;
+			interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+			mboxes = <&apcs_glb 1>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			#power-domain-cells = <0>;
+			interrupt-parent = <&intc>;
+			qcom,mpm-pin-count = <96>;
+			qcom,mpm-pin-map = <2 190>,
+					   <5 296>,  /* lpass_irq_out_sdc */
+					   <12 422>, /* usb3_lfps_rxterm_irq */
+					   <24 79>,  /* bi_px_lpi_1_aoss_mx */
+					   <86 183>, /* mpm_wake,spmi_m */
+					   <90 188>, /* eud_p0_dmse_int_mx */
+					   <91 184>; /* eud_p0_dpse_int_mx */
+		};
+
 		glink-edge {
 			compatible = "qcom,glink-rpm";
 
@@ -1088,7 +1113,7 @@ spmi_bus: spmi@1c40000 {
 			      <0x0 0x01c0a000 0x0 0x26000>;
 			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
 			interrupt-names = "periph_irq";
-			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
+			interrupts-extended = <&mpm 86 IRQ_TYPE_LEVEL_HIGH>;
 			qcom,ee = <0>;
 			qcom,channel = <0>;
 			#address-cells = <2>;
@@ -1126,8 +1151,15 @@ bimc: interconnect@4480000 {
 		};
 
 		rpm_msg_ram: sram@45f0000 {
-			compatible = "qcom,rpm-msg-ram";
+			compatible = "qcom,rpm-msg-ram", "mmio-sram";
 			reg = <0x0 0x045f0000 0x0 0x7000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0 0x0 0x045f0000 0x7000>;
+
+			apss_mpm: sram@1b8 {
+				reg = <0x1b8 0x48>;
+			};
 		};
 
 		/*
@@ -1414,10 +1446,8 @@ &clk_virt SLAVE_QUP_CORE_0>,
 		 * yet, so the DWC3 core is capped to high-speed
 		 * on the SNPS Femto PHY and the pipe clock is
 		 * substituted by UTMI, as on other Bengal-class
-		 * SoCs. The DP/DM and SS wakeup lines downstream
-		 * route through the MPM block, which is not
-		 * described yet; only the GIC power event is
-		 * wired.
+		 * SoCs. The DP/DM and SS wakeup lines route
+		 * through the MPM block, as downstream.
 		 */
 		usb_1: usb@4ef8800 {
 			compatible = "qcom,sm6225-dwc3", "qcom,dwc3";
@@ -1440,8 +1470,14 @@ usb_1: usb@4ef8800 {
 					  <&gcc GCC_USB30_PRIM_MASTER_CLK>;
 			assigned-clock-rates = <19200000>, <133333333>;
 
-			interrupts = <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>;
-			interrupt-names = "pwr_event";
+			interrupts-extended = <&intc GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>,
+					       <&mpm 91 IRQ_TYPE_EDGE_RISING>,
+					       <&mpm 90 IRQ_TYPE_EDGE_RISING>,
+					       <&mpm 12 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "pwr_event",
+					  "dp_hs_phy_irq",
+					  "dm_hs_phy_irq",
+					  "ss_phy_irq";
 
 			power-domains = <&gcc GCC_USB30_PRIM_GDSC>;
 
-- 
