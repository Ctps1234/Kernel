From aff72d381a06b197b8c27bc2ad07ba14c0bc8367 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.local>
Date: Wed, 4 Nov 2026 00:21:37 +0000
Subject: [PATCH 94/94] dt-bindings: usb: qcom,dwc3: allow dwc3@ child name;
 rename SM6225 core

The platform device name derived from the DWC3 core
node is userspace ABI on Android: the USB HAL locates
the controller through androidboot.usbcontroller, and
downstream-derived vendor images use "4e00000.dwc3"
for this SoC. The snps,dwc3 core schema does not
restrict the node name, so allow the dwc3@ form in the
glue pattern and rename the SM6225 core node to match,
keeping the label unchanged.

Signed-off-by: Arena Agent <agent@arena.local>
---
 Documentation/devicetree/bindings/usb/qcom,dwc3.yaml | 2 +-
 arch/arm64/boot/dts/qcom/sm6225.dtsi                 | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml b/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml
index 61addcd3dd3f..19c0bbb833de 100644
--- a/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml
+++ b/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml
@@ -157,7 +157,7 @@ properties:
 # Required child node:
 
 patternProperties:
-  "^usb@[0-9a-f]+$":
+  "^(usb|dwc3)@[0-9a-f]+$":
     $ref: snps,dwc3.yaml#
     unevaluatedProperties: false
 
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 6f9d37ce31c7..2d875e873647 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -1703,7 +1703,7 @@ &bimc SLAVE_EBI_CH0>,
 
 			status = "disabled";
 
-			usb_1_dwc3: usb@4e00000 {
+			usb_1_dwc3: dwc3@4e00000 {
 				compatible = "snps,dwc3";
 				reg = <0x0 0x04e00000 0x0 0xe000>;
 				interrupts = <GIC_SPI 255 IRQ_TYPE_LEVEL_HIGH>;
-- 
