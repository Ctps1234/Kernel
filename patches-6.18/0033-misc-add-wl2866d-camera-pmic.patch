diff --git a/Documentation/ABI/testing/misc-wl2866d b/Documentation/ABI/testing/misc-wl2866d
new file mode 100644
index 000000000..ef2bce243
--- /dev/null
+++ b/Documentation/ABI/testing/misc-wl2866d
@@ -0,0 +1,32 @@
+What:		/dev/wl2866d
+Date:		Oct 2026
+KernelVersion:	6.12
+Contact:	linux-kernel@vger.kernel.org
+Description:
+		Root-only register access interface for the WL2866D
+		camera power management IC.  The device is present only
+		after the I2C device has probed successfully.
+
+		Each open file description starts at register 0.  An
+		llseek with SEEK_SET or SEEK_CUR selects the starting
+		register in the range 0-255 and returns the selected
+		register.
+
+		Reads return complete six-byte, uppercase hexadecimal
+		records of the form "RR VV ", where RR is a register
+		address and VV is its value.  The read count is the
+		capacity of the user buffer in bytes.  At most 20
+		registers are returned by one read, and the return
+		value is the number of bytes copied to user space.
+
+		Writes accept one or more records in the same format
+		and write the corresponding registers.  The trailing
+		space in the final record and one trailing newline are
+		optional.
+
+		This is a low-level diagnostic interface inherited from
+		the downstream camera driver.  Normal camera power
+		sequencing is performed in the kernel through
+		wl2866d_camera_power_control().
+
+Users:		Vendor camera diagnostics and factory tests.
diff --git a/Documentation/devicetree/bindings/misc/ovti,wl2866d-i2c.yaml b/Documentation/devicetree/bindings/misc/ovti,wl2866d-i2c.yaml
new file mode 100644
index 000000000..75d40c1a2
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/ovti,wl2866d-i2c.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/ovti,wl2866d-i2c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: WL2866D camera power management IC
+
+maintainers:
+  - Arnd Bergmann <arnd@arndb.de>
+  - Greg Kroah-Hartman <gregkh@linuxfoundation.org>
+
+description: |
+  The WL2866D is an I2C-controlled power management IC used to supply
+  camera sensors.  It provides two digital and two analog outputs.  The
+  vendor device-tree contract carries the register used to identify the
+  device, the expected identification values and a small board-specific
+  register initialization sequence.
+
+properties:
+  compatible:
+    const: ovti,wl2866d-i2c
+
+  reg:
+    maxItems: 1
+
+  en-gpio:
+    maxItems: 1
+    description:
+      GPIO connected to the device enable input.  It is driven low while
+      the driver initializes the device, matching the downstream driver.
+
+  id_reg:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Register address used for device identification.
+
+  id_val:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: First accepted value of the identification register.
+
+  id_val1:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Second accepted value of the identification register.
+
+  init_num:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 16
+    description: Number of register/value pairs in the inits property.
+
+  inits:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 32
+    items:
+      maximum: 255
+    description: |
+      Board-specific register/value pairs written after the driver's
+      default register sequence.  The array must contain exactly twice
+      as many entries as init_num.
+
+required:
+  - compatible
+  - reg
+  - en-gpio
+  - id_reg
+  - id_val
+  - id_val1
+  - init_num
+  - inits
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    gpio: gpio-controller {
+        gpio-controller;
+        #gpio-cells = <2>;
+    };
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        power-controller@28 {
+            compatible = "ovti,wl2866d-i2c";
+            reg = <0x28>;
+            en-gpio = <&gpio 26 GPIO_ACTIVE_HIGH>;
+            id_reg = <3>;
+            id_val = <100>;
+            id_val1 = <85>;
+            init_num = <2>;
+            inits = <4 75 14 15>;
+        };
+    };
