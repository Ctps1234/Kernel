+#ifndef _LINUX_WL2866D_H
+#define _LINUX_WL2866D_H
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+
+/**
+ * enum wl2866d_output - WL2866D camera supply outputs
+ * @WL2866D_OUTPUT_DVDD1: first digital supply output
+ * @WL2866D_OUTPUT_DVDD2: second digital supply output
+ * @WL2866D_OUTPUT_AVDD1: first analog supply output
+ * @WL2866D_OUTPUT_AVDD2: second analog supply output
+ * @WL2866D_OUTPUT_COUNT: number of outputs
+ */
+enum wl2866d_output {
+	WL2866D_OUTPUT_DVDD1,
+	WL2866D_OUTPUT_DVDD2,
+	WL2866D_OUTPUT_AVDD1,
+	WL2866D_OUTPUT_AVDD2,
+	WL2866D_OUTPUT_COUNT,
+};
+
+/* Output names used by the downstream camera stack. */
+#define OUT_DVDD1 WL2866D_OUTPUT_DVDD1
+#define OUT_DVDD2 WL2866D_OUTPUT_DVDD2
+#define OUT_AVDD1 WL2866D_OUTPUT_AVDD1
+#define OUT_AVDD2 WL2866D_OUTPUT_AVDD2
+
+#if IS_ENABLED(CONFIG_WL2866D)
+/**
+ * wl2866d_camera_power_control() - control one WL2866D output
+ * @output: output ID from &enum wl2866d_output
+ * @request: 0 to disable the output, nonzero to enable it; the special
+ *	value 1050000 selects the downstream 1.05 V setting for DVDD1
+ *
+ * Return: 0 on success or a negative errno on failure.
+ */
+int wl2866d_camera_power_control(unsigned int output, int request);
+#else
+static inline int wl2866d_camera_power_control(unsigned int output,
+					       int request)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif /* _LINUX_WL2866D_H */
