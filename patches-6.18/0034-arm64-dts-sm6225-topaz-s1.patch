diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
new file mode 100644
index 000000000..7b07a10d9
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-topaz.dts
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Xiaomi Redmi Note 12 4G (topaz), SM6225.
+ *
+ * S1 of docs/dt-upstream-sm6225-plan.md: board file with memory,
+ * reserved-memory (including the ramoops region the stock kernel
+ * uses) and the debug UART as stdout-path. Memory banks and the
+ * reserved-memory map were copied from the live FDT of a 4 GB
+ * topaz unit; the bootloader rebuilds them per SKU at every boot.
+ * Nothing here is boot-tested yet: this milestone is CI-only
+ * (dtbs/dtbs_check), see docs/hardware-info-needed.md for the
+ * safety constraints on the only available device.
+ */
+
+/dts-v1/;
+
+#include "sm6225.dtsi"
+
+/ {
+	model = "Xiaomi Redmi Note 12 4G";
+	compatible = "xiaomi,topaz", "qcom,sm6225";
+	chassis-type = "handset";
+
+	aliases {
+		serial0 = &uart4;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x3dd00000>,
+		      <0x0 0x80000000 0x0 0x40000000>,
+		      <0x0 0xc0000000 0x0 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		hyp_region@45700000 {
+			no-map;
+			reg = <0x0 0x45700000 0x0 0x600000>;
+		};
+
+		xbl_aop_region@45e00000 {
+			no-map;
+			reg = <0x0 0x45e00000 0x0 0x140000>;
+		};
+
+		sec_apps_region@45fff000 {
+			no-map;
+			reg = <0x0 0x45fff000 0x0 0x1000>;
+		};
+
+		smem_mem: smem_region@46000000 {
+			no-map;
+			reg = <0x0 0x46000000 0x0 0x200000>;
+		};
+
+		cdsp_sec_regions@46200000 {
+			no-map;
+			reg = <0x0 0x46200000 0x0 0x1e00000>;
+		};
+
+		modem_region@4ab00000 {
+			no-map;
+			reg = <0x0 0x4ab00000 0x0 0x6900000>;
+		};
+
+		wlan_msa_region@51900000 {
+			no-map;
+			reg = <0x0 0x51900000 0x0 0x100000>;
+		};
+
+		cdsp_regions@51a00000 {
+			no-map;
+			reg = <0x0 0x51a00000 0x0 0x1a00000>;
+		};
+
+		pil_adsp_region@53800000 {
+			no-map;
+			reg = <0x0 0x53800000 0x0 0x2300000>;
+		};
+
+		ipa_fw_region@55b00000 {
+			no-map;
+			reg = <0x0 0x55b00000 0x0 0x10000>;
+		};
+
+		ipa_gsi_region@55b10000 {
+			no-map;
+			reg = <0x0 0x55b10000 0x0 0x5000>;
+		};
+
+		gpu_region@55b15000 {
+			no-map;
+			reg = <0x0 0x55b15000 0x0 0x2000>;
+		};
+
+		video_region@55b17000 {
+			no-map;
+			reg = <0x0 0x55b17000 0x0 0x700000>;
+		};
+
+		removed_region@60000000 {
+			no-map;
+			reg = <0x0 0x60000000 0x0 0x3900000>;
+		};
+
+		/*
+		 * Same region and layout the stock kernel uses for
+		 * pstore; with CONFIG_PSTORE_RAM=y it is the log
+		 * channel designed for a first on-device test without
+		 * a UART (docs/hardware-info-needed.md).
+		 */
+		ramoops@5d000000 {
+			compatible = "ramoops";
+			reg = <0x0 0x5d000000 0x0 0x200000>;
+			record-size = <0x40000>;
+			console-size = <0x80000>;
+			pmsg-size = <0x100000>;
+		};
+
+		dfps_data_region@5cf00000 {
+			label = "dfps_data_region";
+			reg = <0x0 0x5cf00000 0x0 0x100000>;
+		};
+
+		splash_region@5c000000 {
+			label = "cont_splash_region";
+			reg = <0x0 0x5c000000 0x0 0xf00000>;
+		};
+
+		user_contig_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x1000000>;
+		};
+
+		non_secure_display_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0xa400000>;
+		};
+
+		secure_display_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x5c00000>;
+		};
+
+		qseecom_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x1400000>;
+		};
+
+		qseecom_ta_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x1000000>;
+		};
+
+		adsp_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x800000>;
+		};
+
+		va_md_mem_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			size = <0x0 0x1000000>;
+		};
+
+		mem_dump_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			size = <0x0 0x800000>;
+		};
+
+		linux_cma_region {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x2000000>;
+			linux,cma-default;
+		};
+	};
+};
+
+&sleep_clk {
+	clock-frequency = <32764>;
+};
+
+&xo_board {
+	clock-frequency = <19200000>;
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&uart4 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
new file mode 100644
index 000000000..d40f127f5
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -0,0 +1,503 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Qualcomm SM6225 (Khaje / Bengal) SoC, upstream-style.
+ *
+ * S1 of docs/dt-upstream-sm6225-plan.md: minimal SoC with the debug
+ * UART described. Every address, IRQ and resource here was lifted
+ * from the live FDT of a topaz unit and/or the downstream
+ * khaje/bengal DTS import of this project, then translated to the
+ * upstream bindings (model: sm6115.dtsi from this tree). Nodes such
+ * as UFS, MDSS, LPASS, PMIC SPMI, cpufreq-hw/OPPs and CPU idle
+ * states land in later slices of the same plan.
+ */
+
+#include <dt-bindings/clock/qcom,gcc-khaje.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+#include <dt-bindings/interconnect/qcom,bengal.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/regulator/qcom,rpm-smd-regulator.h>
+
+/ {
+	interrupt-parent = <&intc>;
+
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	chosen { };
+
+	clocks {
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+		};
+
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+		};
+
+		/*
+		 * PHY symbol clock stubs, same values as the downstream
+		 * khaje.dtsi fixed-clocks. Replaced by real QMP PHY
+		 * clocks when the UFS (S2) and USB slices land.
+		 */
+		ufs_phy_rx_symbol_0_clk: ufs-phy-rx-symbol-0-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <1000>;
+			#clock-cells = <0>;
+		};
+
+		ufs_phy_rx_symbol_1_clk: ufs-phy-rx-symbol-1-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <1000>;
+			#clock-cells = <0>;
+		};
+
+		ufs_phy_tx_symbol_0_clk: ufs-phy-tx-symbol-0-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <1000>;
+			#clock-cells = <0>;
+		};
+
+		usb3_phy_wrapper_gcc_usb30_pipe_clk: usb3-phy-pipe-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <1000>;
+			#clock-cells = <0>;
+		};
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0 0x0>;
+			capacity-dmips-mhz = <1024>;
+			enable-method = "psci";
+			next-level-cache = <&l2_0>;
+
+			l2_0: l2-cache {
+				compatible = "cache";
+				cache-level = <2>;
+				cache-unified;
+			};
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0 0x1>;
+			capacity-dmips-mhz = <1024>;
+			enable-method = "psci";
+			next-level-cache = <&l2_0>;
+		};
+
+		cpu2: cpu@2 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0 0x2>;
+			capacity-dmips-mhz = <1024>;
+			enable-method = "psci";
+			next-level-cache = <&l2_0>;
+		};
+
+		cpu3: cpu@3 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0 0x3>;
+			capacity-dmips-mhz = <1024>;
+			enable-method = "psci";
+			next-level-cache = <&l2_0>;
+		};
+
+		cpu4: cpu@100 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a73";
+			reg = <0x0 0x100>;
+			capacity-dmips-mhz = <1638>;
+			enable-method = "psci";
+			next-level-cache = <&l2_1>;
+
+			l2_1: l2-cache {
+				compatible = "cache";
+				cache-level = <2>;
+				cache-unified;
+			};
+		};
+
+		cpu5: cpu@101 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a73";
+			reg = <0x0 0x101>;
+			capacity-dmips-mhz = <1638>;
+			enable-method = "psci";
+			next-level-cache = <&l2_1>;
+		};
+
+		cpu6: cpu@102 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a73";
+			reg = <0x0 0x102>;
+			capacity-dmips-mhz = <1638>;
+			enable-method = "psci";
+			next-level-cache = <&l2_1>;
+		};
+
+		cpu7: cpu@103 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a73";
+			reg = <0x0 0x103>;
+			capacity-dmips-mhz = <1638>;
+			enable-method = "psci";
+			next-level-cache = <&l2_1>;
+		};
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu0>;
+				};
+
+				core1 {
+					cpu = <&cpu1>;
+				};
+
+				core2 {
+					cpu = <&cpu2>;
+				};
+
+				core3 {
+					cpu = <&cpu3>;
+				};
+			};
+
+			cluster1 {
+				core0 {
+					cpu = <&cpu4>;
+				};
+
+				core1 {
+					cpu = <&cpu5>;
+				};
+
+				core2 {
+					cpu = <&cpu6>;
+				};
+
+				core3 {
+					cpu = <&cpu7>;
+				};
+			};
+		};
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 1 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 2 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 3 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 0 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
+	};
+
+	smem: smem {
+		compatible = "qcom,smem";
+		memory-region = <&smem_mem>;
+		hwlocks = <&tcsr_mutex 3>;
+	};
+
+	/*
+	 * RPM over glink. Only the CX (PM6125 S3) and MX (PM6125 S5)
+	 * voltage-level votes consumed by the clock controllers are
+	 * described in this slice; the physical PM6125 rails land with
+	 * the board slice of the plan. Resource names/ids, level
+	 * bounds and qcom,set values come from the downstream
+	 * pm6125-rpm-regulator.dtsi and bengal-regulator.dtsi.
+	 */
+	rpm: remoteproc {
+		compatible = "qcom,sm6225-rpm-proc", "qcom,rpm-proc";
+
+		glink-edge {
+			compatible = "qcom,glink-rpm";
+
+			interrupts = <GIC_SPI 194 IRQ_TYPE_EDGE_RISING>;
+			qcom,rpm-msg-ram = <&rpm_msg_ram>;
+			mboxes = <&apcs_glb 0>;
+
+			rpm_requests: rpm-requests {
+				compatible = "qcom,rpm-sm6225", "qcom,glink-smd-rpm";
+				qcom,glink-channels = "rpm_requests";
+
+				rpmcc: clock-controller {
+					compatible = "qcom,rpmcc-khaje", "qcom,rpmcc";
+					clocks = <&xo_board>;
+					clock-names = "xo";
+					#clock-cells = <1>;
+				};
+
+				rpm-regulator-smpa3 {
+					compatible = "qcom,rpm-smd-regulator-resource";
+					qcom,resource-name = "rwcx";
+					qcom,resource-id = <0>;
+					qcom,regulator-type = <1>;
+					qcom,hpm-min-load = <100000>;
+
+					pm6125_s3_level: regulator-s3-level {
+						compatible = "qcom,rpm-smd-regulator";
+						regulator-name = "pm6125_s3_level";
+						qcom,set = <3>;
+						regulator-min-microvolt =
+							<RPM_SMD_REGULATOR_LEVEL_RETENTION>;
+						regulator-max-microvolt =
+							<RPM_SMD_REGULATOR_LEVEL_BINNING>;
+						qcom,use-voltage-level;
+					};
+
+					regulator-s3-floor-level {
+						compatible = "qcom,rpm-smd-regulator";
+						regulator-name = "pm6125_s3_floor_level";
+						qcom,set = <3>;
+						regulator-min-microvolt =
+							<RPM_SMD_REGULATOR_LEVEL_RETENTION>;
+						regulator-max-microvolt =
