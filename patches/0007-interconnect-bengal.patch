+		((qos->areq_prio << BIMC_QOSGEN_AREQPRIO_SHIFT) &
+		 BIMC_QOSGEN_AREQPRIO_MASK);
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_update_bits(qp->regmap,
+			qp->qos_offset + BIMC_QOSGEN_MPORT_BKE_HEALTH(qos->qos_port, i),
+			BIMC_QOSGEN_PRIOLVL_MASK | BIMC_QOSGEN_AREQPRIO_MASK,
+			value);
