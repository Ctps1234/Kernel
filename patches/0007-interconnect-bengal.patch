Subject: [PATCH 7/11] interconnect: qcom: add Bengal NoC support

Port the Khaje/Bengal interconnect graph to the Android Common 6.12 RPM
interconnect framework. Preserve node IDs, RPM IDs, links, bus geometry,
QoS ports and interface-clock requirements from the pinned Qualcomm R47
reference while keeping the target's qcom_icc and SMD-RPM APIs.

Add Bengal-specific BIMC QoSGEN and QNoC4 QoS programming. Make sparse
provider tables safe by skipping absent node slots during registration and
returning -EINVAL for a translation that resolves to a null slot. Keep the
active 19.2 MHz RPM bus vote and require the system AXI clocks while virtual
MMNRT/MMRT providers program their shared NoC QoS registers. Add a per-node
force_rpm opt-in so Bengal nodes with AP-owned QoS programming still submit
their RPM bandwidth votes without changing other SoCs' behavior.

Static comparison against R47 covered 92 nodes, 36 link arrays, 184 RPM
IDs and 22 QoS boxes, with no mismatches. All 126 Bengal interconnect specs
in the captured active FDT resolve to present provider slots. The seven
AP-owned Bengal nodes with valid RPM master IDs opt into RPM voting. No
compilation or DT schema validation has been run yet.

---
diff --git a/Documentation/devicetree/bindings/interconnect/qcom,bengal.yaml b/Documentation/devicetree/bindings/interconnect/qcom,bengal.yaml
new file mode 100644
index 0000000..64633cc
--- /dev/null
+++ b/Documentation/devicetree/bindings/interconnect/qcom,bengal.yaml
@@ -0,0 +1,193 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interconnect/qcom,bengal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Bengal Network-On-Chip interconnect
+
+maintainers:
+  - Konrad Dybcio <konradybcio@kernel.org>
+
+description:
+  The Qualcomm Bengal interconnect providers manage bandwidth requests for
+  BIMC, configuration and system NoC fabrics, plus virtual QUP, MMNRT, and
+  MMRT providers. Bandwidth requests are sent through the Qualcomm RPM SMD
+  interface. The system NoC additionally requires the GCC AXI interface clocks
+  used to access its registers.
+
+properties:
+  compatible:
+    enum:
+      - qcom,bengal-bimc
+      - qcom,bengal-config_noc
+      - qcom,bengal-system_noc
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    minItems: 2
+    maxItems: 4
+
+  clock-names:
+    minItems: 2
+    items:
+      - const: bus
+      - const: bus_a
+      - const: cfg_axi
+      - const: sys_axi
+
+  '#interconnect-cells':
+    const: 1
+
+patternProperties:
+  '^interconnect-[a-z0-9]+$':
+    type: object
+    description:
+      Virtual providers share the system NoC provider's register space where
+      needed and are populated as child devices of the system NoC provider.
+
+    properties:
+      compatible:
+        enum:
+          - qcom,bengal-clk_virt
+          - qcom,bengal-mmnrt_virt
+          - qcom,bengal-mmrt_virt
+
+      clocks:
+        minItems: 2
+        maxItems: 4
+
+      clock-names:
+        minItems: 2
+        items:
+          - const: bus
+          - const: bus_a
+          - const: cfg_axi
+          - const: sys_axi
+
+      '#interconnect-cells':
+        const: 1
+
+    required:
+      - compatible
+      - '#interconnect-cells'
+
+    allOf:
+      - if:
+          properties:
+            compatible:
+              enum:
+                - qcom,bengal-mmnrt_virt
+                - qcom,bengal-mmrt_virt
+        then:
+          required:
+            - clocks
+            - clock-names
+          properties:
+            clocks:
+              minItems: 4
+            clock-names:
+              minItems: 4
+
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - '#interconnect-cells'
+
+allOf:
+  - $ref: qcom,rpm-common.yaml#
+  - if:
+      properties:
+        compatible:
+          const: qcom,bengal-system_noc
+    then:
+      required:
+        - clocks
+        - clock-names
+      properties:
+        clocks:
+          minItems: 4
+        clock-names:
+          minItems: 4
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmcc.h>
+    #include <dt-bindings/clock/qcom,gcc-khaje.h>
+    #include <dt-bindings/interconnect/qcom,bengal.h>
+
+    / {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        rpmcc: clock-controller-rpm {
+            #clock-cells = <1>;
+        };
+
+        gcc: clock-controller-gcc {
+            #clock-cells = <1>;
+        };
+
+        bimc: interconnect@4480000 {
+            compatible = "qcom,bengal-bimc";
+            reg = <0x04480000 0x80000>;
+            clocks = <&rpmcc RPM_SMD_BIMC_CLK>,
+                     <&rpmcc RPM_SMD_BIMC_A_CLK>;
+            clock-names = "bus", "bus_a";
+            #interconnect-cells = <1>;
+        };
+
+        config_noc: interconnect@1900000 {
+            compatible = "qcom,bengal-config_noc";
+            reg = <0x01900000 0x6200>;
+            clocks = <&rpmcc RPM_SMD_CNOC_CLK>,
+                     <&rpmcc RPM_SMD_CNOC_A_CLK>;
+            clock-names = "bus", "bus_a";
+            #interconnect-cells = <1>;
+        };
+
+        system_noc: interconnect@1880000 {
+            compatible = "qcom,bengal-system_noc";
+            reg = <0x01880000 0x5f080>;
+            clocks = <&rpmcc RPM_SMD_SNOC_CLK>,
+                     <&rpmcc RPM_SMD_SNOC_A_CLK>,
+                     <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
+                     <&gcc GCC_SYS_NOC_USB3_PRIM_AXI_CLK>;
+            clock-names = "bus", "bus_a", "cfg_axi", "sys_axi";
+            #interconnect-cells = <1>;
+
+            clk_virt: interconnect-clk {
+                compatible = "qcom,bengal-clk_virt";
+                clocks = <&rpmcc RPM_SMD_SNOC_CLK>,
+                         <&rpmcc RPM_SMD_SNOC_A_CLK>;
+                clock-names = "bus", "bus_a";
+                #interconnect-cells = <1>;
+            };
+
+            mmnrt_virt: interconnect-mmnrt {
+                compatible = "qcom,bengal-mmnrt_virt";
+                clocks = <&rpmcc RPM_SMD_MMNRT_CLK>,
+                         <&rpmcc RPM_SMD_MMNRT_A_CLK>,
+                         <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
+                         <&gcc GCC_SYS_NOC_USB3_PRIM_AXI_CLK>;
+                clock-names = "bus", "bus_a", "cfg_axi", "sys_axi";
+                #interconnect-cells = <1>;
+            };
+
+            mmrt_virt: interconnect-mmrt {
+                compatible = "qcom,bengal-mmrt_virt";
+                clocks = <&rpmcc RPM_SMD_MMRT_CLK>,
+                         <&rpmcc RPM_SMD_MMRT_A_CLK>,
+                         <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
+                         <&gcc GCC_SYS_NOC_USB3_PRIM_AXI_CLK>;
+                clock-names = "bus", "bus_a", "cfg_axi", "sys_axi";
+                #interconnect-cells = <1>;
+            };
+        };
+    };
