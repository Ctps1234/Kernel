From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Port <port@local>
Date: Sat, 24 Oct 2026 12:00:00 -0300
Subject: [PATCH] drm/msm: read Khaje UBWC decoder version at runtime

Add Khaje-specific MDSS data with the Topaz UBWC encoder revision,
swizzle, static value, bank bit and register-bus vote. Creek identifies
the decoder revision by reading UBWC_DEC_HW_VERSION at MDSS + 0x58;
read and normalize the hardware major/minor in runtime resume instead of
borrowing the static SM6115/SM6375 decoder setting.

Pass the detected version through the existing decoder-specific setup
paths and retain the Creek UBWC 3.0 static-register fields. The new
qcom,khaje-mdss compatible is not enabled by a DTS change in this patch;
parent resource, clock, IRQ and ICC integration still needs validation.

---
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index faa88fd..14344c9 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -179,7 +179,7 @@ static void msm_mdss_setup_ubwc_dec_20(struct msm_mdss *msm_mdss)
 static void msm_mdss_setup_ubwc_dec_30(struct msm_mdss *msm_mdss)
 {
 	const struct msm_mdss_data *data = msm_mdss->mdss_data;
-	u32 value = (data->ubwc_swizzle & 0x1) |
+	u32 value = data->ubwc_static | (data->ubwc_swizzle & 0x1) |
 		    (data->highest_bank_bit & 0x3) << 4 |
 		    (data->macrotile_mode & 0x1) << 12;
 
@@ -192,7 +192,8 @@ static void msm_mdss_setup_ubwc_dec_30(struct msm_mdss *msm_mdss)
 	writel_relaxed(value, msm_mdss->mmio + UBWC_STATIC);
 }
 
-static void msm_mdss_setup_ubwc_dec_40(struct msm_mdss *msm_mdss)
+static void msm_mdss_setup_ubwc_dec_40(struct msm_mdss *msm_mdss,
+				       u32 ubwc_dec_version)
 {
 	const struct msm_mdss_data *data = msm_mdss->mdss_data;
 	u32 value = (data->ubwc_swizzle & 0x7) |
@@ -206,7 +207,7 @@ static void msm_mdss_setup_ubwc_dec_40(struct msm_mdss *msm_mdss)
 		writel_relaxed(1, msm_mdss->mmio + UBWC_CTRL_2);
 		writel_relaxed(0, msm_mdss->mmio + UBWC_PREDICTION_MODE);
 	} else {
-		if (data->ubwc_dec_version == UBWC_4_3)
+		if (ubwc_dec_version == UBWC_4_3)
 			writel_relaxed(3, msm_mdss->mmio + UBWC_CTRL_2);
 		else
 			writel_relaxed(2, msm_mdss->mmio + UBWC_CTRL_2);
@@ -278,6 +279,7 @@ const struct msm_mdss_data *msm_mdss_get_mdss_data(struct device *dev)
 
 static int msm_mdss_enable(struct msm_mdss *msm_mdss)
 {
+	u32 ubwc_dec_version;
 	int ret, i;
 
 	/*
@@ -315,7 +317,14 @@ static int msm_mdss_enable(struct msm_mdss *msm_mdss)
 	 * Decoder version can be read from the UBWC_DEC_HW_VERSION reg,
 	 * UBWC_n and the rest of params comes from hw data.
 	 */
-	switch (msm_mdss->mdss_data->ubwc_dec_version) {
+	ubwc_dec_version = msm_mdss->mdss_data->ubwc_dec_version;
+	if (msm_mdss->mdss_data->ubwc_dec_version_from_reg) {
+		ubwc_dec_version = readl_relaxed(msm_mdss->mmio +
+						 UBWC_DEC_HW_VERSION);
+		ubwc_dec_version &= GENMASK(31, 16);
+	}
+
+	switch (ubwc_dec_version) {
 	case 0: /* no UBWC */
 	case UBWC_1_0:
 		/* do nothing */
@@ -328,11 +337,11 @@ static int msm_mdss_enable(struct msm_mdss *msm_mdss)
 		break;
 	case UBWC_4_0:
 	case UBWC_4_3:
-		msm_mdss_setup_ubwc_dec_40(msm_mdss);
+		msm_mdss_setup_ubwc_dec_40(msm_mdss, ubwc_dec_version);
 		break;
 	default:
 		dev_err(msm_mdss->dev, "Unsupported UBWC decoder version %x\n",
-			msm_mdss->mdss_data->ubwc_dec_version);
+			ubwc_dec_version);
 		dev_err(msm_mdss->dev, "HW_REV: 0x%x\n",
 			readl_relaxed(msm_mdss->mmio + HW_REV));
 		dev_err(msm_mdss->dev, "UBWC_DEC_HW_VERSION: 0x%x\n",
@@ -662,6 +671,15 @@ static const struct msm_mdss_data sm6125_data = {
 	.highest_bank_bit = 1,
 };
 
+static const struct msm_mdss_data khaje_data = {
+	.ubwc_enc_version = UBWC_1_0,
+	.ubwc_dec_version_from_reg = true,
+	.ubwc_swizzle = 7,
+	.ubwc_static = 0x11f,
+	.highest_bank_bit = 1,
+	.reg_bus_bw = 76800,
+};
+
 static const struct msm_mdss_data sm8250_data = {
 	.ubwc_enc_version = UBWC_4_0,
 	.ubwc_dec_version = UBWC_4_0,
@@ -720,6 +738,7 @@ static const struct of_device_id mdss_dt_match[] = {
 	{ .compatible = "qcom,sm6125-mdss", .data = &sm6125_data },
 	{ .compatible = "qcom,sm6350-mdss", .data = &sm6350_data },
 	{ .compatible = "qcom,sm6375-mdss", .data = &sm6350_data },
+	{ .compatible = "qcom,khaje-mdss", .data = &khaje_data },
 	{ .compatible = "qcom,sm7150-mdss", .data = &sm7150_data },
 	{ .compatible = "qcom,sm8150-mdss", .data = &sm8150_data },
 	{ .compatible = "qcom,sm8250-mdss", .data = &sm8250_data },
diff --git a/drivers/gpu/drm/msm/msm_mdss.h b/drivers/gpu/drm/msm/msm_mdss.h
index 3afef4b..039d7b9 100644
--- a/drivers/gpu/drm/msm/msm_mdss.h
+++ b/drivers/gpu/drm/msm/msm_mdss.h
@@ -6,10 +6,13 @@
 #ifndef __MSM_MDSS_H__
 #define __MSM_MDSS_H__
 
+#include <linux/types.h>
+
 struct msm_mdss_data {
 	u32 ubwc_enc_version;
 	/* can be read from register 0x58 */
 	u32 ubwc_dec_version;
+	bool ubwc_dec_version_from_reg;
 	u32 ubwc_swizzle;
 	u32 ubwc_static;
 	u32 highest_bank_bit;
