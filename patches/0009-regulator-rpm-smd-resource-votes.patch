+
+static const struct rpm_regulator_data *
+rpm_smd_find_pm6125_regulator(const char *reg_name, u32 type, u32 id)
+{
+	const struct rpm_regulator_data *rpm_data;
+	const char *name;
+
+	if (strncmp(reg_name, "pm6125_", sizeof("pm6125_") - 1))
+		return NULL;
+
+	name = reg_name + sizeof("pm6125_") - 1;
+	for (rpm_data = rpm_pm6125_regulators; rpm_data->name; rpm_data++)
+		if (!strcmp(name, rpm_data->name) && rpm_data->type == type &&
+		    rpm_data->id == id)
+			return rpm_data;
+
+	return NULL;
+}
+
+static int rpm_smd_pmic_regulator_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct qcom_rpm_smd_resource *resource;
+	struct regulator_config config = {};
+	struct qcom_rpm_reg *vreg;
+	struct regulator_dev *rdev;
+	const struct rpm_regulator_data *rpm_data;
+	const char *reg_name;
+	u32 set, init_uV;
+	int ret;
+
+	resource = dev_get_drvdata(pdev->dev.parent);
+	if (!resource)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "RPM resource parent is not ready\n");
+
+	if (of_property_read_string(np, "regulator-name", &reg_name))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "missing regulator-name\n");
+
+	rpm_data = rpm_smd_find_pm6125_regulator(reg_name, resource->type,
+						 resource->id);
+	if (!rpm_data)
+		return -ENODEV;
+
+	if (of_property_read_u32(np, "qcom,set", &set) || !set ||
+	    (set & ~RPM_SMD_SET_MASK))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "invalid or missing qcom,set\n");
+
+	vreg = devm_kzalloc(&pdev->dev, sizeof(*vreg), GFP_KERNEL);
+	if (!vreg)
+		return -ENOMEM;
+
+	vreg->dev = &pdev->dev;
+	vreg->rpm = resource->rpm;
+	vreg->type = resource->type;
+	vreg->id = resource->id;
+	vreg->set_mask = set;
+
+	memcpy(&vreg->desc, rpm_data->desc, sizeof(vreg->desc));
+	vreg->desc.name = reg_name;
+	vreg->desc.supply_name = NULL;
+	vreg->desc.owner = THIS_MODULE;
+	vreg->desc.type = REGULATOR_VOLTAGE;
+	vreg->desc.of_match = np->name;
+
+	if (of_find_property(np, "qcom,init-voltage", NULL)) {
+		ret = of_property_read_u32(np, "qcom,init-voltage", &init_uV);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret,
+					     "invalid qcom,init-voltage\n");
+		if (init_uV > INT_MAX)
+			return dev_err_probe(&pdev->dev, -ERANGE,
+					     "qcom,init-voltage exceeds signed range\n");
+		vreg->uV = init_uV;
+		vreg->uv_updated = 1;
+	}
+
+	/*
+	 * The nested PMIC resource nodes do not describe regulator input
+	 * supplies, so do not create phantom supply dependencies here.
+	 */
+	config.dev = resource->dev;
+	config.of_node = np;
+	config.driver_data = vreg;
+
+	rdev = devm_regulator_register(&pdev->dev, &vreg->desc, &config);
+	if (IS_ERR(rdev))
+		return dev_err_probe(&pdev->dev, PTR_ERR(rdev),
+				     "failed to register PMIC regulator\n");
+
+	return 0;
+}
+
+static int rpm_smd_resource_type(const char *name, u32 *type)
+{
+	if (!strcmp(name, "rwcx"))
+		*type = QCOM_SMD_RPM_RWCX;
+	else if (!strcmp(name, "rwmx"))
+		*type = QCOM_SMD_RPM_RWMX;
+	else if (!strcmp(name, "rwlc"))
+		*type = QCOM_SMD_RPM_RWLC;
+	else if (!strcmp(name, "rwlm"))
+		*type = QCOM_SMD_RPM_RWLM;
+	else if (!strcmp(name, "smpa"))
+		*type = QCOM_SMD_RPM_SMPA;
+	else if (!strcmp(name, "ldoa"))
+		*type = QCOM_SMD_RPM_LDOA;
+	else
+		return -EINVAL;
+
+	return 0;
+}
+
+static bool rpm_smd_vote_equal(const struct rpm_smd_level_vote *a,
+			       const struct rpm_smd_level_vote *b)
+{
+	return a->enabled == b->enabled &&
+	       !memcmp(a->level, b->level, sizeof(a->level));
+}
+
+static void rpm_smd_resource_aggregate_locked(
+		struct qcom_rpm_smd_resource *resource, unsigned int state,
+		struct rpm_smd_level_vote *vote)
+{
+	struct qcom_rpm_smd_level_regulator *vreg;
+	unsigned int key;
+
+	memset(vote, 0, sizeof(*vote));
+	vote->valid = true;
+
+	list_for_each_entry(vreg, &resource->regulators, node) {
+		if (!(vreg->set_mask & BIT(state)))
+			continue;
+
+		if (vreg->enabled)
+			vote->enabled = true;
+		if (!vreg->enabled && !vreg->always_send_voltage)
+			continue;
+
+		key = vreg->key;
+		vote->level[key] = max_t(u32, vote->level[key], vreg->uV);
+	}
+}
+
+static int rpm_smd_resource_write_state(
+		struct qcom_rpm_smd_resource *resource, unsigned int state,
+		const struct rpm_smd_level_vote *vote)
+{
+	struct clk_smd_rpm_req req[RPM_SMD_LEVEL_KEY_COUNT + 1];
+	unsigned int key, count = 0;
+
+	req[count++] = (struct clk_smd_rpm_req) {
+		.key = cpu_to_le32(QCOM_RPM_KEY_SOFTWARE_ENABLE),
+		.nbytes = cpu_to_le32(sizeof(u32)),
+		.value = cpu_to_le32(vote->enabled),
+	};
+
+	for (key = 0; key < RPM_SMD_LEVEL_KEY_COUNT; key++) {
+		u32 rpm_key;
+
+		if (!(resource->key_mask & BIT(key)))
+			continue;
+
+		rpm_key = key == RPM_SMD_LEVEL_KEY ? RPM_SMD_KEY_VLVL :
+								 RPM_SMD_KEY_VFL;
+		req[count++] = (struct clk_smd_rpm_req) {
+			.key = cpu_to_le32(rpm_key),
+			.nbytes = cpu_to_le32(sizeof(u32)),
+			.value = cpu_to_le32(vote->level[key]),
+		};
+	}
+
+	return qcom_rpm_smd_write(resource->rpm, state, resource->type,
+				  resource->id, req,
+				  sizeof(req[0]) * count);
+}
+
+static int rpm_smd_resource_sync_locked(
+		struct qcom_rpm_smd_resource *resource)
+{
+	struct rpm_smd_level_vote old[QCOM_SMD_RPM_STATE_NUM];
+	struct rpm_smd_level_vote new[QCOM_SMD_RPM_STATE_NUM];
+	bool changed[QCOM_SMD_RPM_STATE_NUM] = {};
+	int state, rollback;
+	int ret;
+
+	for (state = 0; state < QCOM_SMD_RPM_STATE_NUM; state++) {
+		if (!(resource->set_mask & BIT(state)))
+			continue;
+
+		rpm_smd_resource_aggregate_locked(resource, state, &new[state]);
+		old[state] = resource->state[state];
+
+		/* Do not create a zero vote just because voltage was staged before
+		 * the first enable.  A later disable still sends zero because the
+		 * successful enable populated the cache.
+		 */
+		if (!old[state].valid && !new[state].enabled &&
+		    !new[state].level[RPM_SMD_LEVEL_KEY] &&
+		    !new[state].level[RPM_SMD_FLOOR_KEY])
+			continue;
+		if (old[state].valid && rpm_smd_vote_equal(&old[state], &new[state]))
+			continue;
+
+		ret = rpm_smd_resource_write_state(resource, state, &new[state]);
+		if (ret) {
+			struct rpm_smd_level_vote restore = old[state];
+			int restore_ret;
+
+			resource->state[state].valid = false;
+			if (!restore.valid) {
+				memset(&restore, 0, sizeof(restore));
+				restore.valid = true;
+			}
+			restore_ret = rpm_smd_resource_write_state(resource, state,
+								   &restore);
+			if (restore_ret) {
+				dev_warn(resource->dev,
+					 "failed to restore RPM state %d: %d\n",
+					 state, restore_ret);
+			} else {
+				resource->state[state] = restore;
+			}
+			goto rollback;
+		}
+
+		resource->state[state] = new[state];
+		changed[state] = true;
+	}
+
+	return 0;
+
+rollback:
+	for (rollback = state - 1; rollback >= 0; rollback--) {
+		struct rpm_smd_level_vote restore = old[rollback];
+		int restore_ret;
+
+		if (!changed[rollback])
+			continue;
+		if (!restore.valid) {
+			memset(&restore, 0, sizeof(restore));
+			restore.valid = true;
+		}
+
+		restore_ret = rpm_smd_resource_write_state(resource, rollback,
+							   &restore);
+		if (restore_ret) {
+			resource->state[rollback].valid = false;
+			dev_warn(resource->dev,
+				 "failed to roll back RPM state %d: %d\n",
+				 rollback, restore_ret);
+		} else {
+			resource->state[rollback] = restore;
+		}
+	}
+
+	return ret;
+}
+
+static int rpm_smd_level_update(struct qcom_rpm_smd_level_regulator *vreg,
+				bool update_enabled, bool enabled,
+				bool update_voltage, int uV)
+{
+	struct qcom_rpm_smd_resource *resource = vreg->resource;
+	bool old_enabled;
+	int old_uV;
+	int rollback_ret;
+	int ret;
+
+	mutex_lock(&resource->lock);
+	old_enabled = vreg->enabled;
+	old_uV = vreg->uV;
+	if (update_enabled)
+		vreg->enabled = enabled;
+	if (update_voltage)
+		vreg->uV = uV;
+
+	ret = rpm_smd_resource_sync_locked(resource);
+	if (ret) {
+		vreg->enabled = old_enabled;
+		vreg->uV = old_uV;
+		rollback_ret = rpm_smd_resource_sync_locked(resource);
+		if (rollback_ret)
+			dev_warn(resource->dev,
+				 "failed to restore %s vote after RPM error: %d\n",
+				 vreg->desc.name, rollback_ret);
+	}
+	mutex_unlock(&resource->lock);
+
+	return ret;
+}
+
+static int rpm_smd_level_enable(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_smd_level_regulator *vreg = rdev_get_drvdata(rdev);
+
+	return rpm_smd_level_update(vreg, true, true, false, 0);
+}
+
+static int rpm_smd_level_disable(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_smd_level_regulator *vreg = rdev_get_drvdata(rdev);
+
+	return rpm_smd_level_update(vreg, true, false, false, 0);
+}
+
+static int rpm_smd_level_is_enabled(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_smd_level_regulator *vreg = rdev_get_drvdata(rdev);
+	int enabled;
+
+	mutex_lock(&vreg->resource->lock);
+	enabled = vreg->enabled;
+	mutex_unlock(&vreg->resource->lock);
+
+	return enabled;
+}
+
+static int rpm_smd_level_get_voltage(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_smd_level_regulator *vreg = rdev_get_drvdata(rdev);
+	int uV;
+
+	mutex_lock(&vreg->resource->lock);
+	uV = vreg->uV;
+	mutex_unlock(&vreg->resource->lock);
+
+	return uV;
+}
+
+static int rpm_smd_level_set_voltage(struct regulator_dev *rdev, int min_uV,
+				     int max_uV, unsigned int *selector)
+{
+	struct qcom_rpm_smd_level_regulator *vreg = rdev_get_drvdata(rdev);
+	int uV;
+
+	if (max_uV < vreg->min_uV || min_uV > vreg->max_uV)
+		return -EINVAL;
+
+	uV = max(min_uV, vreg->min_uV);
+	if (uV > min(max_uV, vreg->max_uV))
+		return -EINVAL;
+	if (selector)
+		*selector = uV - vreg->min_uV;
+
+	return rpm_smd_level_update(vreg, false, false, true, uV);
+}
+
+static const struct regulator_ops rpm_smd_level_ops = {
+	.enable = rpm_smd_level_enable,
+	.disable = rpm_smd_level_disable,
+	.is_enabled = rpm_smd_level_is_enabled,
+	.list_voltage = regulator_list_voltage_linear,
+	.get_voltage = rpm_smd_level_get_voltage,
+	.set_voltage = rpm_smd_level_set_voltage,
+};
+
+static void rpm_smd_level_regulator_remove(void *data)
+{
+	struct qcom_rpm_smd_level_regulator *vreg = data;
+	struct qcom_rpm_smd_resource *resource = vreg->resource;
+	int ret;
+
+	mutex_lock(&resource->lock);
+	vreg->enabled = false;
+	vreg->always_send_voltage = false;
+	if (!list_empty(&vreg->node))
+		list_del_init(&vreg->node);
+	ret = rpm_smd_resource_sync_locked(resource);
+	mutex_unlock(&resource->lock);
+
+	if (ret)
+		dev_warn(resource->dev, "failed to clear removed regulator vote: %d\n",
+			 ret);
+}
+
+static int rpm_smd_level_regulator_probe(struct platform_device *pdev)
+{
+	struct qcom_rpm_smd_level_regulator *vreg;
+	struct qcom_rpm_smd_resource *resource;
+	struct regulator_config config = {};
+	struct regulator_dev *rdev;
+	struct device_node *np = pdev->dev.of_node;
+	const char *reg_name;
+	u32 min_uV, max_uV, set, initial;
+	int ret;
+
+	resource = dev_get_drvdata(pdev->dev.parent);
+	if (!resource)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "RPM resource parent is not ready\n");
+
+	if (of_property_read_string(np, "regulator-name", &reg_name))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "missing regulator-name\n");
+	if (of_property_read_u32(np, "regulator-min-microvolt", &min_uV) ||
+	    of_property_read_u32(np, "regulator-max-microvolt", &max_uV) ||
+	    min_uV > max_uV || max_uV > INT_MAX)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "invalid regulator level range\n");
+	if (of_property_read_u32(np, "qcom,set", &set) || !set ||
+	    (set & ~RPM_SMD_SET_MASK))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "qcom,set must select active and/or sleep\n");
+
+	vreg = devm_kzalloc(&pdev->dev, sizeof(*vreg), GFP_KERNEL);
+	if (!vreg)
+		return -ENOMEM;
+
+	vreg->resource = resource;
+	vreg->set_mask = set;
+	vreg->min_uV = min_uV;
+	vreg->max_uV = max_uV;
+	vreg->always_send_voltage =
+		of_property_read_bool(np, "qcom,always-send-voltage");
+
+	if (of_property_read_bool(np, "qcom,use-voltage-level") ==
+	    of_property_read_bool(np, "qcom,use-voltage-floor-level"))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "select exactly one RPM level key\n");
+
+	if (of_property_read_bool(np, "qcom,use-voltage-level")) {
+		vreg->key = RPM_SMD_LEVEL_KEY;
+		ret = of_property_read_u32(np, "qcom,init-voltage-level", &initial);
+	} else {
+		vreg->key = RPM_SMD_FLOOR_KEY;
+		ret = of_property_read_u32(np, "qcom,init-voltage-floor-level",
+					   &initial);
+	}
+	if (!ret) {
+		if (initial < min_uV || initial > max_uV)
+			return dev_err_probe(&pdev->dev, -EINVAL,
+					     "initial RPM level is outside range\n");
+		vreg->uV = initial;
+	} else if (ret != -EINVAL) {
+		return ret;
+	}
+
+	vreg->desc.name = reg_name;
+	vreg->desc.of_match = reg_name;
+	vreg->desc.owner = THIS_MODULE;
+	vreg->desc.type = REGULATOR_VOLTAGE;
+	vreg->desc.ops = &rpm_smd_level_ops;
+	vreg->desc.min_uV = min_uV;
+	vreg->desc.uV_step = 1;
+	vreg->desc.n_voltages = max_uV - min_uV + 1;
+	vreg->desc.continuous_voltage_range = true;
+
+	INIT_LIST_HEAD(&vreg->node);
+	mutex_lock(&resource->lock);
+	list_add_tail(&vreg->node, &resource->regulators);
+	resource->set_mask |= set;
+	resource->key_mask |= BIT(vreg->key);
+	mutex_unlock(&resource->lock);
+
+	ret = devm_add_action_or_reset(&pdev->dev,
+				       rpm_smd_level_regulator_remove, vreg);
+	if (ret)
+		return ret;
+
+	config.dev = &pdev->dev;
+	config.of_node = np;
+	config.driver_data = vreg;
+	rdev = devm_regulator_register(&pdev->dev, &vreg->desc, &config);
+	if (IS_ERR(rdev))
+		return dev_err_probe(&pdev->dev, PTR_ERR(rdev),
+				     "failed to register RPM level regulator\n");
+
+	return 0;
+}
+
+static int rpm_smd_regulator_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+
+	/* The compatible is shared by PMIC rails and RPM voltage-level votes. */
+	if (of_property_read_bool(np, "qcom,use-voltage-level") ||
+	    of_property_read_bool(np, "qcom,use-voltage-floor-level"))
+		return rpm_smd_level_regulator_probe(pdev);
+
+	return rpm_smd_pmic_regulator_probe(pdev);
+}
+
+static int rpm_smd_resource_probe(struct platform_device *pdev)
+{
+	struct qcom_rpm_smd_resource *resource;
+	const char *name;
+	struct qcom_smd_rpm *rpm;
+	u32 id;
+	int ret;
+
+	rpm = dev_get_drvdata(pdev->dev.parent);
+	if (!rpm)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "RPM parent is not ready\n");
+
+	if (of_property_read_string(pdev->dev.of_node, "qcom,resource-name",
+				    &name) ||
+	    of_property_read_u32(pdev->dev.of_node, "qcom,resource-id", &id))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "missing RPM resource name or id\n");
+
+	resource = devm_kzalloc(&pdev->dev, sizeof(*resource), GFP_KERNEL);
+	if (!resource)
+		return -ENOMEM;
+
+	ret = rpm_smd_resource_type(name, &resource->type);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "unsupported RPM resource %s\n", name);
+
+	resource->dev = &pdev->dev;
+	resource->rpm = rpm;
+	resource->id = id;
+	mutex_init(&resource->lock);
+	INIT_LIST_HEAD(&resource->regulators);
+	platform_set_drvdata(pdev, resource);
+
+	return devm_of_platform_populate(&pdev->dev);
+}
+
+static const struct of_device_id rpm_smd_resource_match[] = {
+	{ .compatible = "qcom,rpm-smd-regulator-resource" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rpm_smd_resource_match);
+
+static const struct of_device_id rpm_smd_level_regulator_match[] = {
+	{ .compatible = "qcom,rpm-smd-regulator" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rpm_smd_level_regulator_match);
+
+static struct platform_driver rpm_smd_resource_driver = {
+	.probe = rpm_smd_resource_probe,
+	.driver = {
+		.name = "qcom-rpm-smd-regulator-resource",
+		.of_match_table = rpm_smd_resource_match,
+	},
+};
+
+static struct platform_driver rpm_smd_level_regulator_driver = {
+	.probe = rpm_smd_regulator_probe,
+	.driver = {
+		.name = "qcom-rpm-smd-regulator",
+		.of_match_table = rpm_smd_level_regulator_match,
+	},
+};
+
