+int clk_pre_change_regmap(struct clk_hw *hw, unsigned long cur_rate,
+			  unsigned long new_rate)
+{
+	struct clk_regmap *rclk = to_clk_regmap(hw);
+	int old_level = rclk->vdd_data.vdd_level;
+	int new_level, ret;
+
+	if (!rclk->vdd_data.rate_max || !rclk->vdd_data.num_rate_max)
+		return 0;
+
+	new_level = clk_find_vdd_level(hw, &rclk->vdd_data, new_rate);
+	if (new_level < 0)
+		return new_level;
+
+	if (new_level <= old_level) {
+		if (!clk_hw_is_prepared(hw))
+			rclk->vdd_data.vdd_level = new_level;
+		return 0;
+	}
+
+	if (clk_hw_is_prepared(hw)) {
+		ret = clk_vote_vdd_level(&rclk->vdd_data, new_level);
+		if (ret)
+			return ret;
+
+		if (old_level > 0) {
+			ret = clk_unvote_vdd_level(&rclk->vdd_data, old_level);
+			if (ret) {
+				clk_unvote_vdd_level(&rclk->vdd_data, new_level);
+				return ret;
+			}
+		}
+	}
+
+	rclk->vdd_data.vdd_level = new_level;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(clk_pre_change_regmap);
+
+int clk_post_change_regmap(struct clk_hw *hw, unsigned long old_rate,
+			   unsigned long cur_rate)
+{
+	struct clk_regmap *rclk = to_clk_regmap(hw);
+	int old_level = rclk->vdd_data.vdd_level;
+	int new_level, ret;
+
+	if (!rclk->vdd_data.rate_max || !rclk->vdd_data.num_rate_max)
+		return 0;
+
+	new_level = clk_find_vdd_level(hw, &rclk->vdd_data, cur_rate);
+	if (new_level < 0)
+		return new_level;
+	if (new_level >= old_level)
+		return 0;
+
+	if (clk_hw_is_prepared(hw)) {
+		if (new_level > 0) {
+			ret = clk_vote_vdd_level(&rclk->vdd_data, new_level);
+			if (ret)
+				return ret;
+		}
+
+		if (old_level > 0) {
+			ret = clk_unvote_vdd_level(&rclk->vdd_data, old_level);
+			if (ret) {
+				if (new_level > 0)
+					clk_unvote_vdd_level(&rclk->vdd_data,
+							     new_level);
+				return ret;
+			}
+		}
+	}
+
+	rclk->vdd_data.vdd_level = new_level;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(clk_post_change_regmap);
+
+int clk_prepare_regmap(struct clk_hw *hw)
+{
+	struct clk_regmap *rclk = to_clk_regmap(hw);
+	int level, ret;
+
+	if (!rclk->vdd_data.rate_max || !rclk->vdd_data.num_rate_max)
+		return 0;
+
+	level = clk_find_vdd_level(hw, &rclk->vdd_data, clk_hw_get_rate(hw));
+	if (level < 0)
+		return level;
+
+	rclk->vdd_data.vdd_level = level;
+	if (!level)
+		return 0;
+
+	ret = clk_vote_vdd_level(&rclk->vdd_data, level);
+	if (ret)
+		rclk->vdd_data.vdd_level = 0;
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_prepare_regmap);
+
+void clk_unprepare_regmap(struct clk_hw *hw)
+{
+	struct clk_regmap *rclk = to_clk_regmap(hw);
+	int level = rclk->vdd_data.vdd_level;
+	int ret;
+
+	if (!rclk->vdd_data.rate_max || !rclk->vdd_data.num_rate_max || !level)
+		return;
+
+	ret = clk_unvote_vdd_level(&rclk->vdd_data, level);
+	if (ret) {
+		pr_warn("%s: failed to remove voltage vote at level %d: %d\n",
+			clk_hw_get_name(hw), level, ret);
+		return;
+	}
+
+	rclk->vdd_data.vdd_level = 0;
+}
+EXPORT_SYMBOL_GPL(clk_unprepare_regmap);
