+	if (!of_find_property(dev->of_node, "qcom,critical-clocks", NULL) &&
+	    !of_find_property(dev->of_node, "qcom,critical-devices", NULL))
+		return 0;
+
+	enabled = devm_kcalloc(dev, cc->num_rclks, sizeof(*enabled), GFP_KERNEL);
+	if (!enabled && cc->num_rclks)
