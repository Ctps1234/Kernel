new file mode 100644
index 000000000000..364f3dcd4ccb
--- /dev/null
+++ b/drivers/clk/qcom/clk-debug.c
@@ -0,0 +1,516 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal Qualcomm debug-clock mux support for controllers with register
+ * based measurement hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/export.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+
+#include "clk-debug.h"
+
+#define TCXO_DIV_4_HZ		4800000
+#define SAMPLE_TICKS_1_MS	0x1000
+#define SAMPLE_TICKS_27_MS	0x20000
+
+#define XO_DIV4_CNT_DONE	BIT(25)
+#define CNT_EN			BIT(20)
+#define CLR_CNT			BIT(21)
+#define XO_DIV4_TERM_CNT_MASK	GENMASK(19, 0)
+#define MEASURE_CNT		GENMASK(24, 0)
+#define CBCR_ENA		BIT(0)
+
+static DEFINE_MUTEX(clk_debug_lock);
+static LIST_HEAD(clk_debug_mux_list);
+static struct clk_hw *measure;
+
+static bool clk_is_debug_mux(const struct clk_hw *hw)
+{
+	struct clk_debug_mux *mux;
+
+	if (!hw)
+		return false;
+
+	list_for_each_entry(mux, &clk_debug_mux_list, list)
+		if (&mux->hw == hw)
+			return true;
+
+	return false;
+}
+
+static int clk_debug_set_parent(struct clk_hw *hw, struct clk_hw *parent)
+{
+	struct clk *clk, *parent_clk;
+
+	/* Do not pass an unresolved/orphaned parent to the CCF. */
+	if (!hw || !parent)
+		return -EINVAL;
+
+	clk = hw->clk;
+	parent_clk = parent->clk;
+	if (!clk || !parent_clk)
+		return -EINVAL;
+
+	return clk_set_parent(clk, parent_clk);
+}
+
+static int clk_find_and_set_parent(struct clk_hw *mux, struct clk_hw *target)
+{
+	struct clk_hw *parent;
+	int i, ret;
+
+	if (!mux || !target)
+		return -EINVAL;
+	if (mux == target)
+		return 0;
+	if (!clk_is_debug_mux(mux))
+		return -EINVAL;
+
+	for (i = 0; i < clk_hw_get_num_parents(mux); i++) {
+		parent = clk_hw_get_parent_by_index(mux, i);
+		if (!parent)
+			continue;
+
+		if (parent == target)
+			return clk_debug_set_parent(mux, parent);
+
+		if (!clk_is_debug_mux(parent))
+			continue;
+
+		ret = clk_find_and_set_parent(parent, target);
+		if (!ret)
+			return clk_debug_set_parent(mux, parent);
+	}
+
+	return -EINVAL;
+}
+
+static u8 clk_debug_mux_get_parent(struct clk_hw *hw)
+{
+	struct clk_debug_mux *mux = to_clk_measure(hw);
+	struct clk_hw *parent;
+	u32 value;
+	int i, ret;
+
+	if (!mux->regmap || !mux->mux_sels) {
+		parent = clk_hw_get_parent(hw);
+		if (!parent)
+			return 0xff;
+		for (i = 0; i < clk_hw_get_num_parents(hw); i++)
+			if (clk_hw_get_parent_by_index(hw, i) == parent)
+				return i;
+		return 0xff;
+	}
+
+	ret = regmap_read(mux->regmap, mux->debug_offset, &value);
+	if (ret)
+		return 0xff;
+
+	value = (value & mux->src_sel_mask) >> mux->src_sel_shift;
+	for (i = 0; i < clk_hw_get_num_parents(hw) &&
+	     i < mux->num_mux_sels; i++) {
+		parent = clk_hw_get_parent_by_index(hw, i);
+		if (parent && mux->mux_sels[i] == value)
+			return i;
+	}
+
+	return 0xff;
+}
+
+static int clk_debug_mux_set_parent(struct clk_hw *hw, u8 index)
+{
+	struct clk_debug_mux *mux = to_clk_measure(hw);
+	struct clk_hw *parent;
+	int ret;
+
+	if (!mux->mux_sels)
+		return 0;
+	if (index >= mux->num_mux_sels ||
+	    index >= clk_hw_get_num_parents(hw))
+		return -EINVAL;
+
+	parent = clk_hw_get_parent_by_index(hw, index);
+	if (!parent)
+		return -EINVAL;
+	if (!mux->regmap)
+		return -ENODEV;
+
+	ret = regmap_update_bits(mux->regmap, mux->debug_offset,
+				  mux->src_sel_mask,
+				  mux->mux_sels[index] << mux->src_sel_shift);
+	if (ret)
+		return ret;
+
+	if (mux->post_div_offset == U32_MAX)
+		return 0;
+
+	return regmap_update_bits(mux->regmap, mux->post_div_offset,
+				  mux->post_div_mask,
+				  (mux->post_div_val - 1) <<
+				  mux->post_div_shift);
+}
+
+const struct clk_ops clk_debug_mux_ops = {
+	.get_parent = clk_debug_mux_get_parent,
+	.set_parent = clk_debug_mux_set_parent,
+	.debug_init = clk_debug_measure_add,
+	.determine_rate = clk_hw_determine_rate_no_reparent,
+};
+EXPORT_SYMBOL_GPL(clk_debug_mux_ops);
+
+static int clk_dummy_set_rate(struct clk_hw *hw, unsigned long rate,
+			      unsigned long parent_rate)
+{
+	struct clk_dummy *dummy = container_of(hw, struct clk_dummy, hw);
+
+	dummy->rate = rate;
+	return 0;
+}
+
+static long clk_dummy_round_rate(struct clk_hw *hw, unsigned long rate,
+				unsigned long *parent_rate)
+{
+	return rate;
+}
+
+static unsigned long clk_dummy_recalc_rate(struct clk_hw *hw,
+					   unsigned long parent_rate)
+{
+	struct clk_dummy *dummy = container_of(hw, struct clk_dummy, hw);
+
+	return dummy->rate;
+}
+
+const struct clk_ops clk_dummy_ops = {
+	.set_rate = clk_dummy_set_rate,
+	.round_rate = clk_dummy_round_rate,
+	.recalc_rate = clk_dummy_recalc_rate,
+	.debug_init = clk_debug_measure_add,
+};
+EXPORT_SYMBOL_GPL(clk_dummy_ops);
+
+static int clk_debug_mux_enable(struct clk_hw *hw)
+{
+	struct clk_debug_mux *mux;
+	struct clk_hw *parent;
+	u32 value;
+	int ret;
+
+	if (!clk_is_debug_mux(hw))
+		return 0;
+
+	mux = to_clk_measure(hw);
+	parent = clk_hw_get_parent(hw);
+	ret = clk_debug_mux_enable(parent);
+	if (ret)
+		return ret;
+
+	if (mux->cbcr_offset == U32_MAX || !mux->regmap)
+		return 0;
+
+	mux->en_mask = mux->en_mask ?: CBCR_ENA;
+	ret = regmap_read(mux->regmap, mux->cbcr_offset, &value);
+	if (ret)
+		return ret;
+
+	mux->cbcr_enabled_by_measure = !(value & mux->en_mask);
+	if (!mux->cbcr_enabled_by_measure)
+		return 0;
+
+	return regmap_update_bits(mux->regmap, mux->cbcr_offset,
+				  mux->en_mask, mux->en_mask);
+}
+
+static void clk_debug_mux_disable(struct clk_hw *hw)
+{
+	struct clk_debug_mux *mux;
+	struct clk_hw *parent;
+
+	if (!clk_is_debug_mux(hw))
+		return;
+
+	mux = to_clk_measure(hw);
+	if (mux->cbcr_offset != U32_MAX && mux->regmap &&
+	    mux->cbcr_enabled_by_measure) {
+		regmap_update_bits(mux->regmap, mux->cbcr_offset,
+				   mux->en_mask, 0);
+		mux->cbcr_enabled_by_measure = false;
+	}
+
+	parent = clk_hw_get_parent(hw);
+	clk_debug_mux_disable(parent);
+}
+
+static u32 clk_debug_mux_divisor(struct clk_hw *hw)
+{
+	struct clk_debug_mux *mux;
+	int index;
+	u32 divisor;
+
+	if (!clk_is_debug_mux(hw))
+		return 1;
+
+	mux = to_clk_measure(hw);
+	divisor = mux->post_div_val ?: 1;
+	if (mux->pre_div_vals) {
+		index = clk_hw_get_parent_index(hw);
+		if (index >= 0 && index < mux->num_parents)
+			divisor *= mux->pre_div_vals[index];
+	}
+
+	return divisor * clk_debug_mux_divisor(clk_hw_get_parent(hw));
+}
+
+static int clk_debug_run_measurement(unsigned int ticks,
+				     struct regmap *regmap,
+				     u32 ctl_reg, u32 status_reg,
+				     u32 *count)
+{
+	u32 value;
+	int ret;
+
+	ret = regmap_update_bits(regmap, ctl_reg, CNT_EN, 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(regmap, ctl_reg, CLR_CNT, CLR_CNT);
+	if (ret)
+		return ret;
+
+	/* Allow the hardware counter to clear for at least three XO cycles. */
+	udelay(1);
+
+	ret = regmap_update_bits(regmap, ctl_reg, CLR_CNT, 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(regmap, ctl_reg, XO_DIV4_TERM_CNT_MASK,
+				  ticks & XO_DIV4_TERM_CNT_MASK);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(regmap, ctl_reg, CNT_EN, CNT_EN);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(regmap, status_reg, value,
+				       value & XO_DIV4_CNT_DONE, 10, 100000);
+	if (ret)
+		goto disable_counter;
+
+	*count = value & MEASURE_CNT;
+
+ disable_counter:
+	regmap_update_bits(regmap, ctl_reg, CNT_EN, 0);
+	return ret;
+}
+
+static int clk_debug_mux_measure_rate(struct clk_hw *hw,
+				      unsigned long *rate)
+{
+	struct clk_debug_mux *mux = to_clk_measure(hw);
+	struct measure_clk_data *data = mux->priv;
+	u32 xo4, short_count, full_count;
+	u64 value;
+	int ret;
+
+	if (!data || !data->cxo || !mux->regmap)
+		return -EINVAL;
+
+	ret = clk_prepare_enable(data->cxo);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(mux->regmap, data->xo_div4_cbcr, &xo4);
+	if (ret)
+		goto out_disable_xo;
+
+	ret = regmap_update_bits(mux->regmap, data->xo_div4_cbcr,
+				  CBCR_ENA, CBCR_ENA);
+	if (ret)
+		goto out_restore_xo_div4;
+
+	ret = clk_debug_run_measurement(SAMPLE_TICKS_1_MS, mux->regmap,
+					data->ctl_reg, data->status_reg,
+					&short_count);
+	if (ret)
+		goto out_disable_branch;
+
+	ret = clk_debug_run_measurement(SAMPLE_TICKS_27_MS, mux->regmap,
+					data->ctl_reg, data->status_reg,
+					&full_count);
+	if (ret)
+		goto out_disable_branch;
+
+	if (full_count == short_count) {
+		*rate = 0;
+	} else {
+		value = ((u64)full_count * 10 + 15) * TCXO_DIV_4_HZ;
+		do_div(value, (SAMPLE_TICKS_27_MS * 10ULL) + 35);
+		*rate = value * clk_debug_mux_divisor(hw);
+	}
+
+out_disable_branch:
+out_restore_xo_div4:
+	regmap_update_bits(mux->regmap, data->xo_div4_cbcr, CBCR_ENA,
+			   xo4 & CBCR_ENA);
+out_disable_xo:
+	clk_disable_unprepare(data->cxo);
+	return ret;
+}
+
+static int clk_debug_measure_get(void *data, u64 *value)
+{
+	struct clk_hw *hw = data;
+	struct clk_debug_mux *parent_mux;
+	struct clk_hw *parent;
+	unsigned long rate;
+	u32 period;
+	int ret;
+
+	if (!measure || !hw)
+		return -EINVAL;
+
+	mutex_lock(&clk_debug_lock);
+	ret = clk_find_and_set_parent(measure, hw);
+	if (ret)
+		goto out_unlock;
+
+	parent = clk_hw_get_parent(measure);
+	if (parent && clk_is_debug_mux(parent)) {
+		parent_mux = to_clk_measure(parent);
+		if (!parent_mux->mux_sels) {
+			if (!parent_mux->regmap) {
+				ret = -ENODEV;
+				goto out_unlock;
+			}
+			ret = regmap_read(parent_mux->regmap,
+					  parent_mux->period_offset, &period);
+			if (ret)
+				goto out_unlock;
+			if (!period) {
+				ret = -EINVAL;
+				goto out_unlock;
+			}
+			*value = div_u64(1000000000000ULL, period);
+			goto out_unlock;
+		}
+	}
+
+	ret = clk_debug_mux_enable(measure);
+	if (ret)
+		goto out_disable_mux;
+
+	ret = clk_debug_mux_measure_rate(measure, &rate);
+	if (!ret)
+		*value = rate;
+	clk_debug_mux_disable(measure);
+	goto out_unlock;
+
+out_disable_mux:
+	clk_debug_mux_disable(measure);
+out_unlock:
+	mutex_unlock(&clk_debug_lock);
+	return ret;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(clk_measure_fops, clk_debug_measure_get, NULL,
+			 "%llu\n");
+
+void clk_debug_measure_add(struct clk_hw *hw, struct dentry *dentry)
+{
+	debugfs_create_file("clk_measure", 0444, dentry, hw,
+			    &clk_measure_fops);
+}
+EXPORT_SYMBOL_GPL(clk_debug_measure_add);
+
+int clk_debug_measure_register(struct clk_hw *hw)
+{
+	int ret = 0;
+
+	if (!hw)
+		return -EINVAL;
+
+	mutex_lock(&clk_debug_lock);
+	if (!measure)
+		measure = hw;
+	else if (measure != hw)
+		ret = -EBUSY;
+	mutex_unlock(&clk_debug_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_debug_measure_register);
+
+static void clk_debug_mux_unregister(void *data)
+{
+	struct clk_debug_mux *mux = data;
+
+	mutex_lock(&clk_debug_lock);
+	if (!list_empty(&mux->list))
+		list_del_init(&mux->list);
+	if (measure == &mux->hw)
+		measure = NULL;
+	mutex_unlock(&clk_debug_lock);
+}
+
+int devm_clk_register_debug_mux(struct device *dev,
+				struct clk_debug_mux *mux)
+{
+	struct clk *clk;
+	int ret;
+
+	if (!dev || !mux)
+		return -EINVAL;
+
+	INIT_LIST_HEAD(&mux->list);
+	clk = devm_clk_register(dev, &mux->hw);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	mutex_lock(&clk_debug_lock);
+	list_add_tail(&mux->list, &clk_debug_mux_list);
+	mutex_unlock(&clk_debug_lock);
+
+	ret = devm_add_action_or_reset(dev, clk_debug_mux_unregister, mux);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(devm_clk_register_debug_mux);
+
+int map_debug_bases(struct platform_device *pdev, const char *base,
+		    struct clk_debug_mux *mux)
+{
+	struct device_node *np;
+
+	if (!pdev || !base || !mux)
+		return -EINVAL;
+	if (!of_get_property(pdev->dev.of_node, base, NULL))
+		return -EBADR;
+
+	np = of_parse_phandle(pdev->dev.of_node, base, 0);
+	if (!np)
+		return -ENODEV;
+
+	mux->regmap = device_node_to_regmap(np);
+	of_node_put(np);
+	if (IS_ERR(mux->regmap))
+		return PTR_ERR(mux->regmap);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(map_debug_bases);
+
+MODULE_DESCRIPTION("Qualcomm clock debug mux support");
+MODULE_LICENSE("GPL");
diff --git a/drivers/clk/qcom/clk-debug.h b/drivers/clk/qcom/clk-debug.h
new file mode 100644
index 000000000000..c3071c3a82d7
--- /dev/null
+++ b/drivers/clk/qcom/clk-debug.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CLK_DEBUG_H__
+#define __QCOM_CLK_DEBUG_H__
+
+#include <linux/clk-provider.h>
+#include <linux/list.h>
+#include <linux/platform_device.h>
+
+struct clk;
+struct dentry;
+struct regmap;
+
+struct measure_clk_data {
+	struct clk *cxo;
+	u32 ctl_reg;
+	u32 status_reg;
+	u32 xo_div4_cbcr;
+};
+
+struct clk_debug_mux {
+	int *mux_sels;
+	int num_mux_sels;
+	int *pre_div_vals;
+	int num_parents;
+	struct regmap *regmap;
+	void *priv;
+	u32 en_mask;
+	u32 debug_offset;
+	u32 cbcr_offset;
+	u32 src_sel_mask;
+	u32 src_sel_shift;
+	u32 post_div_offset;
+	u32 post_div_mask;
+	u32 post_div_shift;
+	u32 post_div_val;
+	u32 period_offset;
+	bool cbcr_enabled_by_measure;
+	struct clk_hw hw;
+	struct list_head list;
+};
+
+struct mux_regmap_names {
+	struct clk_debug_mux *mux;
+	const char *regmap_name;
+};
+
+struct clk_dummy {
+	unsigned long rate;
+	struct clk_hw hw;
+};
+
+#define to_clk_measure(_hw) container_of(_hw, struct clk_debug_mux, hw)
+
+extern const struct clk_ops clk_debug_mux_ops;
+extern const struct clk_ops clk_dummy_ops;
+
+void clk_debug_measure_add(struct clk_hw *hw, struct dentry *dentry);
+int clk_debug_measure_register(struct clk_hw *hw);
+int devm_clk_register_debug_mux(struct device *dev, struct clk_debug_mux *mux);
+int map_debug_bases(struct platform_device *pdev, const char *base,
+		    struct clk_debug_mux *mux);
+
+#endif /* __QCOM_CLK_DEBUG_H__ */
diff --git a/drivers/clk/qcom/vdd-class.c b/drivers/clk/qcom/vdd-class.c
new file mode 100644
index 000000000000..e615b96474bc
--- /dev/null
+++ b/drivers/clk/qcom/vdd-class.c
@@ -0,0 +1,506 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Regulator-backed voltage-corner voting for Qualcomm clock controllers.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/err.h>
+#include <linux/export.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "vdd-class.h"
+
+static DEFINE_MUTEX(vdd_lock);
+
+static int clk_vdd_class_validate(struct clk_vdd_class *vdd_class,
+				  bool require_regulators)
+{
+	int i;
+
+	if (!vdd_class || !vdd_class->num_levels ||
+	    !vdd_class->num_regulators || !vdd_class->vdd_uv ||
+	    !vdd_class->level_votes || !vdd_class->regulator ||
+	    !vdd_class->regulator_names)
+		return -EINVAL;
+
+	for (i = 0; i < vdd_class->num_regulators; i++) {
+		if (!vdd_class->regulator_names[i])
+			return -EINVAL;
+		if (!require_regulators)
+			continue;
+		if (IS_ERR(vdd_class->regulator[i]))
+			return PTR_ERR(vdd_class->regulator[i]);
+		if (!vdd_class->regulator[i])
+			return -EPROBE_DEFER;
+	}
+
+	return 0;
+}
+
+/* vdd_lock must be held by the caller. */
+static int clk_aggregate_vdd(struct clk_vdd_class *vdd_class)
+{
+	int old_level = vdd_class->cur_level;
+	int new_level = 0;
+	int old_base, new_base;
+	int voltage_done = 0, status_done = 0;
+	bool old_on, new_on;
+	int i, ret;
+
+	for (i = vdd_class->num_levels - 1; i > 0; i--) {
+		if (vdd_class->level_votes[i]) {
+			new_level = i;
+			break;
+		}
+	}
+
+	if (old_level < 0 || old_level > vdd_class->num_levels)
+		return -EINVAL;
+
+	/* Nothing has ever been enabled and there are still no votes. */
+	if (old_level == vdd_class->num_levels && !new_level) {
+		vdd_class->cur_level = 0;
+		return 0;
+	}
+
+	if (old_level == new_level)
+		return 0;
+
+	old_on = old_level > 0 && old_level < vdd_class->num_levels;
+	new_on = new_level > 0;
+	old_base = (old_on ? old_level : 0) * vdd_class->num_regulators;
+	new_base = new_level * vdd_class->num_regulators;
+
+	for (i = 0; i < vdd_class->num_regulators; i++) {
+		ret = regulator_set_voltage(vdd_class->regulator[i],
+					   vdd_class->vdd_uv[new_base + i], INT_MAX);
+		if (ret)
+			goto rollback;
+		voltage_done = i + 1;
+
+		if (!old_on && new_on)
+			ret = regulator_enable(vdd_class->regulator[i]);
+		else if (old_on && !new_on)
+			ret = regulator_disable(vdd_class->regulator[i]);
+		else
+			ret = 0;
+		if (ret)
+			goto rollback;
+		status_done = i + 1;
+	}
+
+	vdd_class->cur_level = new_level;
+	return 0;
+
+rollback:
+	while (status_done > 0) {
+		int rollback_ret;
+
+		i = --status_done;
+		if (!old_on && new_on)
+			rollback_ret = regulator_disable(vdd_class->regulator[i]);
+		else if (old_on && !new_on)
+			rollback_ret = regulator_enable(vdd_class->regulator[i]);
+		else
+			rollback_ret = 0;
+		if (rollback_ret)
+			pr_warn("%s: failed to roll back regulator status: %d\n",
+				vdd_class->class_name, rollback_ret);
+	}
+
+	while (voltage_done > 0) {
+		int rollback_ret;
+
+		i = --voltage_done;
+		rollback_ret = regulator_set_voltage(vdd_class->regulator[i],
+						     vdd_class->vdd_uv[old_base + i],
+						     INT_MAX);
+		if (rollback_ret)
+			pr_warn("%s: failed to roll back voltage: %d\n",
+				vdd_class->class_name, rollback_ret);
+	}
+
+	return ret;
+}
+
+/* vdd_lock must be held by the caller. */
+static int clk_vote_vdd_class_level(struct clk_vdd_class *vdd_class, int level)
+{
+	int ret;
+
+	ret = clk_vdd_class_validate(vdd_class, true);
+	if (ret)
+		return ret;
+	if (level < 0 || level >= vdd_class->num_levels)
+		return -EINVAL;
+	if (vdd_class->level_votes[level] == INT_MAX)
+		return -EOVERFLOW;
+
+	vdd_class->level_votes[level]++;
+	ret = clk_aggregate_vdd(vdd_class);
+	if (ret)
+		vdd_class->level_votes[level]--;
+
+	return ret;
+}
+
+/* vdd_lock must be held by the caller. */
+static int clk_unvote_vdd_class_level(struct clk_vdd_class *vdd_class,
+				       int level)
+{
+	int ret;
+
+	ret = clk_vdd_class_validate(vdd_class, true);
+	if (ret)
+		return ret;
+	if (level < 0 || level >= vdd_class->num_levels)
+		return -EINVAL;
+	if (!vdd_class->level_votes[level]) {
+		pr_warn("%s: unbalanced voltage vote at level %d\n",
+			vdd_class->class_name, level);
+		return -EINVAL;
+	}
+
+	vdd_class->level_votes[level]--;
+	ret = clk_aggregate_vdd(vdd_class);
+	if (ret)
+		vdd_class->level_votes[level]++;
+
+	return ret;
+}
+
+int clk_find_vdd_level(struct clk_hw *hw, struct clk_vdd_class_data *vdd_data,
+		       unsigned long rate)
+{
+	int level;
+
+	if (!vdd_data || !vdd_data->rate_max || !vdd_data->num_rate_max)
+		return -ENODATA;
+
+	/* PLL fractional rounding can differ from the table by a few Hz. */
+	for (level = 0; level < vdd_data->num_rate_max; level++) {
+		if (vdd_data->rate_max[level] &&
+		    DIV_ROUND_CLOSEST_ULL((u64)rate, 1000) <=
+		    DIV_ROUND_CLOSEST_ULL((u64)vdd_data->rate_max[level], 1000))
+			return level;
+	}
+
+	pr_err("%s: rate %lu is above the highest voltage-class Fmax\n",
+	       hw ? clk_hw_get_name(hw) : "clock", rate);
+	return -EINVAL;
+}
+EXPORT_SYMBOL_GPL(clk_find_vdd_level);
+
+static int clk_vdd_data_validate(struct clk_vdd_class_data *vdd_data)
+{
+	if (!vdd_data || vdd_data->num_vdd_classes < 0 ||
+	    (vdd_data->num_vdd_classes && !vdd_data->vdd_classes) ||
+	    (!vdd_data->vdd_class && !vdd_data->num_vdd_classes))
+		return -EINVAL;
+
+	return 0;
+}
+
+int clk_vote_vdd_level(struct clk_vdd_class_data *vdd_data, int level)
+{
+	int i, done = 0, ret;
+
+	ret = clk_vdd_data_validate(vdd_data);
+	if (ret || level < 0)
+		return ret ?: -EINVAL;
+
+	mutex_lock(&vdd_lock);
+	for (i = 0; i < vdd_data->num_vdd_classes; i++) {
+		ret = clk_vote_vdd_class_level(vdd_data->vdd_classes[i], level);
+		if (ret)
+			goto rollback;
+		done++;
+	}
+
+	if (vdd_data->vdd_class) {
+		ret = clk_vote_vdd_class_level(vdd_data->vdd_class, level);
+		if (ret)
+			goto rollback;
+	}
+	mutex_unlock(&vdd_lock);
+	return 0;
+
+rollback:
+	while (done > 0) {
+		int rollback_ret;
+
+		rollback_ret = clk_unvote_vdd_class_level(
+			vdd_data->vdd_classes[--done], level);
+		if (rollback_ret)
+			pr_warn("failed to roll back clock voltage vote: %d\n",
+				rollback_ret);
+	}
+	mutex_unlock(&vdd_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_vote_vdd_level);
+
+int clk_unvote_vdd_level(struct clk_vdd_class_data *vdd_data, int level)
+{
+	int i, done = 0, ret;
+
+	ret = clk_vdd_data_validate(vdd_data);
+	if (ret || level < 0)
+		return ret ?: -EINVAL;
+
+	mutex_lock(&vdd_lock);
+	for (i = 0; i < vdd_data->num_vdd_classes; i++) {
+		ret = clk_unvote_vdd_class_level(vdd_data->vdd_classes[i], level);
+		if (ret)
+			goto rollback;
+		done++;
+	}
+
+	if (vdd_data->vdd_class) {
+		ret = clk_unvote_vdd_class_level(vdd_data->vdd_class, level);
+		if (ret)
+			goto rollback;
+	}
+	mutex_unlock(&vdd_lock);
+	return 0;
+
+rollback:
+	while (done > 0) {
+		int rollback_ret;
+
+		rollback_ret = clk_vote_vdd_class_level(
+			vdd_data->vdd_classes[--done], level);
+		if (rollback_ret)
+			pr_warn("failed to restore clock voltage vote: %d\n",
+				rollback_ret);
+	}
+	mutex_unlock(&vdd_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_unvote_vdd_level);
+
+int clk_get_vdd_voltage(struct clk_vdd_class_data *vdd_data, int vdd_level)
+{
+	struct clk_vdd_class *vdd_class;
+	int i, j, voltage = -EINVAL;
+	int ret;
+
+	ret = clk_vdd_data_validate(vdd_data);
+	if (ret || vdd_level < 0)
+		return ret ?: -EINVAL;
+
+	for (i = 0; i < vdd_data->num_vdd_classes; i++) {
+		vdd_class = vdd_data->vdd_classes[i];
+		if (clk_vdd_class_validate(vdd_class, false) ||
+		    vdd_level >= vdd_class->num_levels)
+			return -EINVAL;
+		for (j = 0; j < vdd_class->num_regulators; j++)
+			voltage = max(voltage,
+				      vdd_class->vdd_uv[vdd_level *
+						vdd_class->num_regulators + j]);
+	}
+
+	vdd_class = vdd_data->vdd_class;
+	if (vdd_class) {
+		if (clk_vdd_class_validate(vdd_class, false) ||
+		    vdd_level >= vdd_class->num_levels)
+			return -EINVAL;
+		for (j = 0; j < vdd_class->num_regulators; j++)
+			voltage = max(voltage,
+				      vdd_class->vdd_uv[vdd_level *
+						vdd_class->num_regulators + j]);
+	}
+
+	return voltage;
+}
+EXPORT_SYMBOL_GPL(clk_get_vdd_voltage);
+
+int clk_regulator_init(struct device *dev, const struct qcom_cc_desc *desc)
+{
+	struct clk_vdd_class *vdd_class;
+	struct regulator *regulator;
+	int i, j, ret;
+
+	if (!desc || (!desc->clk_regulators && desc->num_clk_regulators))
+		return -EINVAL;
+
+	for (i = 0; i < desc->num_clk_regulators; i++) {
+		vdd_class = desc->clk_regulators[i];
+		ret = clk_vdd_class_validate(vdd_class, false);
+		if (ret)
+			goto err_reset;
+
+		for (j = 0; j < vdd_class->num_regulators; j++) {
+			if (vdd_class->regulator[j]) {
+				ret = -EBUSY;
+				goto err_reset;
+			}
+
+			regulator = devm_regulator_get(dev,
+						       vdd_class->regulator_names[j]);
+			if (IS_ERR(regulator)) {
+				ret = PTR_ERR(regulator);
+				if (ret != -EPROBE_DEFER)
+					dev_err(dev, "%s: failed to get %s regulator: %d\n",
+						__func__, vdd_class->regulator_names[j], ret);
+				goto err_reset;
+			}
+			vdd_class->regulator[j] = regulator;
+		}
+	}
+
+	mutex_lock(&vdd_lock);
+	for (i = 0; i < desc->num_clk_regulators; i++) {
+		vdd_class = desc->clk_regulators[i];
+		memset(vdd_class->level_votes, 0,
+		       sizeof(*vdd_class->level_votes) * vdd_class->num_levels);
+		vdd_class->cur_level = vdd_class->num_levels;
+		vdd_class->proxy_vote = false;
+	}
+	mutex_unlock(&vdd_lock);
+	return 0;
+
+err_reset:
+	for (i = 0; i < desc->num_clk_regulators; i++) {
+		vdd_class = desc->clk_regulators[i];
+		if (!vdd_class || !vdd_class->regulator)
+			continue;
+		for (j = 0; j < vdd_class->num_regulators; j++)
+			vdd_class->regulator[j] = NULL;
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_regulator_init);
+
+void clk_regulator_deinit(const struct qcom_cc_desc *desc)
+{
+	struct clk_vdd_class *vdd_class;
+	int i, j;
+
+	if (!desc || !desc->clk_regulators)
+		return;
+
+	mutex_lock(&vdd_lock);
+	for (i = 0; i < desc->num_clk_regulators; i++) {
+		vdd_class = desc->clk_regulators[i];
+		if (!vdd_class)
+			continue;
+		for (j = 0; j < vdd_class->num_regulators; j++)
+			vdd_class->regulator[j] = NULL;
+		if (vdd_class->level_votes)
+			memset(vdd_class->level_votes, 0,
+			       sizeof(*vdd_class->level_votes) * vdd_class->num_levels);
+		vdd_class->cur_level = vdd_class->num_levels;
+		vdd_class->proxy_vote = false;
+	}
+	mutex_unlock(&vdd_lock);
+}
+EXPORT_SYMBOL_GPL(clk_regulator_deinit);
+
+int clk_vdd_proxy_vote(struct device *dev, const struct qcom_cc_desc *desc)
+{
+	struct clk_vdd_class **voted;
+	struct clk_vdd_class *vdd_class;
+	int i, num_voted = 0, ret;
+
+	if (!desc || !desc->num_clk_regulators)
+		return 0;
+	if (!desc->clk_regulators)
+		return -EINVAL;
+
+	voted = kcalloc(desc->num_clk_regulators, sizeof(*voted), GFP_KERNEL);
+	if (!voted)
+		return -ENOMEM;
+
+	for (i = 0; i < desc->num_clk_regulators; i++) {
+		vdd_class = desc->clk_regulators[i];
+		if (!vdd_class) {
+			ret = -EINVAL;
+			goto rollback;
+		}
+
+		mutex_lock(&vdd_lock);
+		if (vdd_class->proxy_vote) {
+			mutex_unlock(&vdd_lock);
+			continue;
+		}
+		ret = clk_vote_vdd_class_level(vdd_class,
+					       vdd_class->num_levels - 1);
+		if (!ret) {
+			vdd_class->proxy_vote = true;
+			voted[num_voted++] = vdd_class;
+		}
+		mutex_unlock(&vdd_lock);
+		if (ret)
+			goto rollback;
+	}
+
+	kfree(voted);
+	return 0;
+
+rollback:
+	while (num_voted > 0) {
+		int rollback_ret;
+
+		vdd_class = voted[--num_voted];
+		mutex_lock(&vdd_lock);
+		rollback_ret = clk_unvote_vdd_class_level(
+			vdd_class, vdd_class->num_levels - 1);
+		if (!rollback_ret)
+			vdd_class->proxy_vote = false;
+		mutex_unlock(&vdd_lock);
+		if (rollback_ret)
+			dev_warn(dev, "%s: failed to roll back proxy vote: %d\n",
+				 __func__, rollback_ret);
+	}
+	kfree(voted);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_vdd_proxy_vote);
+
+int clk_vdd_proxy_unvote(struct device *dev, const struct qcom_cc_desc *desc)
+{
+	struct clk_vdd_class *vdd_class;
+	int i, ret, first_error = 0;
+
+	if (!desc || !desc->num_clk_regulators)
+		return 0;
+	if (!desc->clk_regulators)
+		return -EINVAL;
+
+	for (i = 0; i < desc->num_clk_regulators; i++) {
+		vdd_class = desc->clk_regulators[i];
+		if (!vdd_class)
+			return -EINVAL;
+
+		mutex_lock(&vdd_lock);
+		if (!vdd_class->proxy_vote) {
+			mutex_unlock(&vdd_lock);
+			continue;
+		}
+		ret = clk_unvote_vdd_class_level(vdd_class,
+						 vdd_class->num_levels - 1);
+		if (!ret)
+			vdd_class->proxy_vote = false;
+		mutex_unlock(&vdd_lock);
+
+		if (ret) {
+			if (!first_error)
+				first_error = ret;
+			if (dev)
+				dev_warn(dev, "%s: failed to remove proxy vote: %d\n",
+					 __func__, ret);
+			else
+				pr_warn("%s: failed to remove proxy vote: %d\n",
+					__func__, ret);
+		}
+	}
+
+	return first_error;
+}
+EXPORT_SYMBOL_GPL(clk_vdd_proxy_unvote);
diff --git a/drivers/clk/qcom/vdd-class.h b/drivers/clk/qcom/vdd-class.h
new file mode 100644
index 000000000000..45519baa7a82
--- /dev/null
+++ b/drivers/clk/qcom/vdd-class.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CLK_VDD_CLASS_H__
+#define __QCOM_CLK_VDD_CLASS_H__
+
+#include <linux/clk-provider.h>
+#include <linux/device.h>
+#include <linux/regulator/consumer.h>
+
+#include "common.h"
+
+/**
+ * struct clk_vdd_class - regulator-backed voltage-corner aggregation
+ * @class_name: diagnostic name
+ * @regulator: regulator handles, one per supply in the class
+ * @regulator_names: names used to acquire the handles
+ * @num_regulators: number of supplies in the class
+ * @vdd_uv: voltage request for each level and supply, level-major
+ * @level_votes: reference count for each level
+ * @num_levels: number of entries in @vdd_uv and @level_votes
+ * @cur_level: currently aggregated level, or @num_levels when off
+ * @proxy_vote: whether qcom_cc holds its temporary maximum-level vote
+ */
+struct clk_vdd_class {
+	const char *class_name;
+	struct regulator **regulator;
+	const char **regulator_names;
+	int num_regulators;
+	int *vdd_uv;
+	int *level_votes;
+	int num_levels;
+	int cur_level;
+	bool proxy_vote;
+};
+
+/**
+ * struct clk_vdd_class_data - voltage requirements for a clock
+ * @vdd_class: primary voltage class
+ * @vdd_classes: additional classes voted together with @vdd_class
+ * @rate_max: maximum rate supported at each voltage level, in Hz
+ * @num_rate_max: number of entries in @rate_max
+ * @vdd_level: cached level currently held by this clock
+ * @num_vdd_classes: number of entries in @vdd_classes
+ */
+struct clk_vdd_class_data {
+	struct clk_vdd_class *vdd_class;
+	struct clk_vdd_class **vdd_classes;
+	unsigned long *rate_max;
+	int num_rate_max;
+	int vdd_level;
+	int num_vdd_classes;
+};
+
+#define DEFINE_VDD_REGULATORS(_name, _num_levels, _num_regulators, _vdd_uv) \
+	struct clk_vdd_class _name = { \
+		.class_name = #_name, \
+		.regulator_names = (const char *[_num_regulators]) { #_name }, \
+		.regulator = (struct regulator *[_num_regulators]) { }, \
+		.num_regulators = (_num_regulators), \
+		.vdd_uv = (_vdd_uv), \
+		.level_votes = (int[_num_levels]) { }, \
+		.num_levels = (_num_levels), \
+		.cur_level = (_num_levels), \
+	}
+
+#define DEFINE_VDD_REGS_INIT(_name, _num_regulators) \
+	struct clk_vdd_class _name = { \
+		.class_name = #_name, \
+		.regulator = (struct regulator *[_num_regulators]) { }, \
+		.num_regulators = (_num_regulators), \
+	}
+
+int clk_find_vdd_level(struct clk_hw *hw, struct clk_vdd_class_data *vdd_data,
+		       unsigned long rate);
+int clk_vote_vdd_level(struct clk_vdd_class_data *vdd_data, int level);
+int clk_unvote_vdd_level(struct clk_vdd_class_data *vdd_data, int level);
+int clk_get_vdd_voltage(struct clk_vdd_class_data *vdd_data, int vdd_level);
+int clk_regulator_init(struct device *dev, const struct qcom_cc_desc *desc);
+void clk_regulator_deinit(const struct qcom_cc_desc *desc);
+int clk_vdd_proxy_vote(struct device *dev, const struct qcom_cc_desc *desc);
+int clk_vdd_proxy_unvote(struct device *dev, const struct qcom_cc_desc *desc);
+
+#endif /* __QCOM_CLK_VDD_CLASS_H__ */
