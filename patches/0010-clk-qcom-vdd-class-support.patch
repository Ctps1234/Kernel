+int qcom_cc_update_regmap_sequence(
+		struct device *dev, struct regmap *regmap,
+		const struct qcom_cc_regmap_update *updates, size_t num_updates)
+{
+	u32 *old_values;
+	size_t i, j;
+	int ret, rollback_ret;
+
+	if (!regmap || (!updates && num_updates))
+		return -EINVAL;
+	if (!num_updates)
+		return 0;
+
+	old_values = kcalloc(num_updates, sizeof(*old_values), GFP_KERNEL);
+	if (!old_values)
+		return -ENOMEM;
+
+	for (i = 0; i < num_updates; i++) {
+		ret = regmap_read(regmap, updates[i].reg, &old_values[i]);
+		if (ret) {
+			dev_err_probe(dev, ret, "failed to read register %#x\n",
+				      updates[i].reg);
+			goto out;
+		}
+	}
+
+	for (i = 0; i < num_updates; i++) {
+		ret = regmap_update_bits(regmap, updates[i].reg,
+					 updates[i].mask, updates[i].val);
+		if (!ret)
+			continue;
+
+		dev_err_probe(dev, ret, "failed to update register %#x\n",
+			      updates[i].reg);
+		for (j = i + 1; j > 0; j--) {
+			size_t index = j - 1;
+
+			rollback_ret = regmap_update_bits(regmap,
+							  updates[index].reg,
+							  updates[index].mask,
+							  old_values[index] &
+							  updates[index].mask);
+			if (rollback_ret)
+				dev_warn(dev,
+					 "failed to restore register %#x: %d\n",
+					 updates[index].reg, rollback_ret);
+		}
+		goto out;
+	}
+
+	ret = 0;
+out:
+	kfree(old_values);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_cc_update_regmap_sequence);
