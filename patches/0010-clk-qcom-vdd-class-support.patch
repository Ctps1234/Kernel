+static int qcom_cc_enable_critical_device(struct device *dev,
+					  struct qcom_cc *cc,
+					  struct device_node *np,
+					  bool *enabled)
+{
+	struct device_node *parent;
+	struct of_phandle_args args;
+	bool found = false;
+	int count, i, ret;
+
+	while (np) {
+		if (of_find_property(np, "clocks", NULL)) {
+			count = of_count_phandle_with_args(np, "clocks",
+							   "#clock-cells");
+			if (count < 0) {
+				ret = dev_err_probe(dev, count,
+						    "failed to parse clocks for critical device %pOF\n",
+						    np);
+				goto out_put_node;
+			}
+
+			for (i = 0; i < count; i++) {
+				ret = of_parse_phandle_with_args(np, "clocks",
+								 "#clock-cells", i, &args);
+				if (ret)
+					goto out_put_node;
+
+				if (args.np == dev->of_node) {
+					found = true;
+					if (!args.args_count)
+						ret = -EINVAL;
+					else
+						ret = qcom_cc_enable_critical_clk(dev, cc,
+									 enabled,
+									 args.args[0]);
+				} else {
+					ret = 0;
+				}
+
+				of_node_put(args.np);
+				if (ret)
+					goto out_put_node;
+			}
+		}
+
+		parent = of_get_parent(np);
+		of_node_put(np);
+		np = parent;
+	}
+
+	if (!found)
+		return dev_err_probe(dev, -ENOENT,
+				     "critical device has no clocks from this controller\n");
+
