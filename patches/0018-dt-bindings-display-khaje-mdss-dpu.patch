From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Port <port@local>
Date: Sun, 25 Oct 2026 12:00:00 -0300
Subject: [PATCH] dt-bindings: display/msm: add SM6225 (Khaje) MDSS/DPU

Document the qcom,khaje-mdss and qcom,khaje-dpu compatibles introduced
by the Khaje DPU catalog and MDSS data patches. The schemas follow the
SM6115 (Bengal) pattern, which shares the display block addresses,
MDSS IRQ (SPI 186), VBIF window and apps SMMU stream IDs (0x420/0x421)
with the live Topaz FDT (qcom,sde-kms, mdp_phys 0x5e00000, vbif_phys
0x5eb0000). Clock and interconnect specifiers use the Khaje GCC/DISPCC
and Bengal ICC providers ported earlier in this series.

The examples describe the upstream MDSS parent + DPU child hierarchy
with the Topaz resource map. They intentionally reference the MDSS
GDSC as dispcc power-domain index 0: the Khaje dispcc driver does not
register that power domain yet (the vendor tree uses a separate
qcom,gdsc regulator-style node at 0x5f03000), so no DTS is switched
over by this patch. DSI controller/PHY child patterns are also left
for the DSI integration step.

---
diff --git a/Documentation/devicetree/bindings/display/msm/qcom,khaje-dpu.yaml b/Documentation/devicetree/bindings/display/msm/qcom,khaje-dpu.yaml
new file mode 100644
index 000000000..1b9920726
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/msm/qcom,khaje-dpu.yaml
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/msm/qcom,khaje-dpu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Display DPU on SM6225 (Khaje)
+
+maintainers:
+  - Dmitry Baryshkov <dmitry.baryshkov@linaro.org>
+  - Rob Clark <robdclark@gmail.com>
+
+$ref: /schemas/display/msm/dpu-common.yaml#
+
+properties:
+  compatible:
+    const: qcom,khaje-dpu
+
+  reg:
+    items:
+      - description: MDP register set
+      - description: VBIF register set
+
+  reg-names:
+    items:
+      - const: mdp
+      - const: vbif
+
+  clocks:
+    items:
+      - description: Display AXI
+      - description: Display AHB
+      - description: Display core
+      - description: Display lut
+      - description: Display rotator
+      - description: Display vsync
+
+  clock-names:
+    items:
+      - const: bus
+      - const: iface
+      - const: core
+      - const: lut
+      - const: rot
+      - const: vsync
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,gcc-khaje.h>
+    #include <dt-bindings/clock/qcom,dispcc-khaje.h>
+
+    display-controller@5e01000 {
+        compatible = "qcom,khaje-dpu";
+        reg = <0x05e01000 0x8f000>,
+              <0x05eb0000 0x2008>;
+        reg-names = "mdp", "vbif";
+
+        clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
+                 <&dispcc DISP_CC_MDSS_AHB_CLK>,
+                 <&dispcc DISP_CC_MDSS_MDP_CLK>,
+                 <&dispcc DISP_CC_MDSS_MDP_LUT_CLK>,
+                 <&dispcc DISP_CC_MDSS_ROT_CLK>,
+                 <&dispcc DISP_CC_MDSS_VSYNC_CLK>;
+        clock-names = "bus", "iface", "core", "lut", "rot", "vsync";
+
+        operating-points-v2 = <&mdp_opp_table>;
+        power-domains = <&dispcc 0>;
+
+        interrupt-parent = <&mdss>;
+        interrupts = <0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+                endpoint {
+                    remote-endpoint = <&dsi0_in>;
+                };
+            };
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/display/msm/qcom,khaje-mdss.yaml b/Documentation/devicetree/bindings/display/msm/qcom,khaje-mdss.yaml
new file mode 100644
index 000000000..badd43b66
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/msm/qcom,khaje-mdss.yaml
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/msm/qcom,khaje-mdss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM6225 (Khaje) Display MDSS
+
+maintainers:
+  - Dmitry Baryshkov <dmitry.baryshkov@linaro.org>
+  - Rob Clark <robdclark@gmail.com>
+
+description:
+  Device tree bindings for MSM Mobile Display Subsystem (MDSS) that
+  encapsulates sub-blocks like DPU display controller and DSI on the
+  SM6225 (Khaje) SoC.
+
+$ref: /schemas/display/msm/mdss-common.yaml#
+
+properties:
+  compatible:
+    const: qcom,khaje-mdss
+
+  clocks:
+    items:
+      - description: Display AHB clock from gcc
+      - description: Display AXI clock
+      - description: Display core clock
+
+  iommus:
+    maxItems: 2
+
+  interconnects:
+    items:
+      - description: Interconnect path from mdp0 port to the data bus
+      - description: Interconnect path from CPU to the reg bus
+
+  interconnect-names:
+    items:
+      - const: mdp0-mem
+      - const: cpu-cfg
+
+patternProperties:
+  "^display-controller@[0-9a-f]+$":
+    type: object
+    additionalProperties: true
+
+    properties:
+      compatible:
+        const: qcom,khaje-dpu
+
+required:
+  - compatible
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,gcc-khaje.h>
+    #include <dt-bindings/clock/qcom,dispcc-khaje.h>
+    #include <dt-bindings/interconnect/qcom,bengal.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    mdss: display-subsystem@5e00000 {
+        #address-cells = <1>;
+        #size-cells = <1>;
+        compatible = "qcom,khaje-mdss";
+        reg = <0x05e00000 0x1000>;
+        reg-names = "mdss";
+
+        /* MDSS GDSC, to be provided by the dispcc driver */
+        power-domains = <&dispcc 0>;
+
+        clocks = <&gcc GCC_DISP_AHB_CLK>,
+                 <&gcc GCC_DISP_HF_AXI_CLK>,
+                 <&dispcc DISP_CC_MDSS_MDP_CLK>;
+
+        interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-controller;
+        #interrupt-cells = <1>;
+
+        iommus = <&apps_smmu 0x420 0x2>,
+                 <&apps_smmu 0x421 0x0>;
+
+        interconnects = <&mmrt_virt MASTER_MDP_PORT0 &bimc SLAVE_EBI_CH0>,
+                        <&bimc MASTER_AMPSS_M0 &config_noc SLAVE_DISPLAY_CFG>;
+        interconnect-names = "mdp0-mem", "cpu-cfg";
+
+        ranges;
+
+        display-controller@5e01000 {
+            compatible = "qcom,khaje-dpu";
+            reg = <0x05e01000 0x8f000>,
+                  <0x05eb0000 0x2008>;
+            reg-names = "mdp", "vbif";
+
+            clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
+                     <&dispcc DISP_CC_MDSS_AHB_CLK>,
+                     <&dispcc DISP_CC_MDSS_MDP_CLK>,
+                     <&dispcc DISP_CC_MDSS_MDP_LUT_CLK>,
+                     <&dispcc DISP_CC_MDSS_ROT_CLK>,
+                     <&dispcc DISP_CC_MDSS_VSYNC_CLK>;
+            clock-names = "bus", "iface", "core", "lut", "rot", "vsync";
+
+            operating-points-v2 = <&mdp_opp_table>;
+            power-domains = <&dispcc 0>;
+
+            interrupt-parent = <&mdss>;
+            interrupts = <0>;
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+                    endpoint {
+                        remote-endpoint = <&dsi0_in>;
+                    };
+                };
+            };
+        };
+    };
+...
