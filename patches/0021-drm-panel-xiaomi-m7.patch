From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Port <port@local>
Date: Sun, 25 Oct 2026 13:30:00 -0300
Subject: [PATCH] drm/panel: add Xiaomi M7 38 0C 0A AMOLED panel driver

Add a driver for the 1080x2400 AMOLED panel of the Redmi Note 12 4G
(topaz), vendor node dsi_panel_m7_38_0c_0a_fhdp_video. The on/off DSI
command sequences are transcribed from the shipping device tree of
the unit (the same data the live FDT carries, DSC fields already
reconciled to 8/8) using the generator in the porting tree; the DSC
Picture Parameter Set is rebuilt from struct drm_dsc_config (DSC
1.1, 8 bpp/8 bpc, two 540x20 slices, block prediction) rather than
copying the vendor PPS long packet.

Single fixed 120 Hz video mode (porches from the vendor timing),
11-bit DCS brightness, vddio supply, reset and optional enable
GPIOs. DFPS porch switching (90/60 Hz), HBM/doze/flat-mode commands
and ESD recovery from the vendor definition are not implemented.
Compile-validated only; not enabled by any production DTS and not
run on hardware.

---
diff --git a/Documentation/devicetree/bindings/display/panel/xiaomi,m7-38-0c-0a.yaml b/Documentation/devicetree/bindings/display/panel/xiaomi,m7-38-0c-0a.yaml
new file mode 100644
index 000000000..828b85c00
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/xiaomi,m7-38-0c-0a.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/xiaomi,m7-38-0c-0a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi M7 38 0C 0A AMOLED DSI panel
+
+maintainers:
+  - Dmitry Baryshkov <dmitry.baryshkov@linaro.org>
+
+description:
+  The M7 38 0C 0A is a 1080x2400 AMOLED DSI video-mode panel used in
+  the Redmi Note 12 4G (topaz). It runs in DSC mode (8 bpp / 8 bpc,
+  two 540x20 slices) and controls brightness via DCS (11-bit).
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,m7-38-0c-0a
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: I/O voltage rail (1.8 V)
+
+  port: true
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vddio-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "xiaomi,m7-38-0c-0a";
+            reg = <0>;
+
+            reset-gpios = <&tlmm 82 GPIO_ACTIVE_LOW>;
+            vddio-supply = <&vreg_l18a>;
+
+            port {
+                panel_in_0: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+
+...
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index d3a9a9faf..72889f604 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -941,6 +941,18 @@ config DRM_PANEL_TRULY_NT35597_WQXGA
 	  Say Y here if you want to enable support for Truly NT35597 WQXGA Dual DSI
 	  Video Mode panel
 
+config DRM_PANEL_XIAOMI_M7
+	tristate "Xiaomi M7 38 0C 0A AMOLED DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DP_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here if you want to enable support for the Xiaomi
+	  M7 38 0C 0A 1080x2400 AMOLED DSI panel found in the
+	  Redmi Note 12 4G (topaz).
+
 config DRM_PANEL_VISIONOX_R66451
 	tristate "Visionox R66451"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 987a08702..6ebcfa7ea 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -97,6 +97,7 @@ obj-$(CONFIG_DRM_PANEL_TPO_TPG110) += panel-tpo-tpg110.o
 obj-$(CONFIG_DRM_PANEL_TRULY_NT35597_WQXGA) += panel-truly-nt35597.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_RM69299) += panel-visionox-rm69299.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_VTDR6130) += panel-visionox-vtdr6130.o
+obj-$(CONFIG_DRM_PANEL_XIAOMI_M7) += panel-xiaomi-m7.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-m7.c b/drivers/gpu/drm/panel/panel-xiaomi-m7.c
new file mode 100644
index 000000000..84168fb6e
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-xiaomi-m7.c
@@ -0,0 +1,372 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DRM driver for the Xiaomi M7 38 0C 0A AMOLED DSI panel found in the
+ * Redmi Note 12 4G (topaz). The init/shutdown command sequences were
+ * transcribed from the vendor panel device tree of the shipping unit
+ * (dsi_panel_m7_38_0c_0a_fhdp_video) with
+ * tools/extract_m7_panel_seq.py; the vendor DSC Picture Parameter Set
+ * long packet is regenerated from struct drm_dsc_config instead of
+ * being copied byte for byte.
+ *
+ * Bring-up status: compile-validated only. Single fixed 120 Hz mode;
+ * vendor DFPS (120/90/60 through vfp changes), HBM/doze dispparam
+ * commands and ESD handling are not implemented yet, and nothing here
+ * has been run on hardware.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct m7_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data supplies[1];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
+};
+
+static inline struct m7_panel *to_m7_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct m7_panel, panel);
+}
+
+static void m7_reset(struct m7_panel *ctx)
+{
+	/* vendor reset-sequence <0 10 1 10> (values are logical here) */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static void m7_on(struct m7_panel *ctx, struct mipi_dsi_multi_context *dsi_ctx)
+{
+	struct drm_dsc_picture_parameter_set pps;
+
+	dsi_ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf1, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xd0, 0x08);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x25, 0xf2);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf2, 0x50);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x2f, 0xf2);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf2, 0x27);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf1, 0xa5, 0xa5);
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 32);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb2, 0x01, 0x31);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xdf, 0x09, 0x30, 0x95, 0x43, 0xa9, 0x43, 0xa9);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x9d, 0x01);
+	/* PPS: regenerado de drm_dsc_config (vendor: pacote 0x9e) */
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(dsi_ctx, &pps);
+	mipi_dsi_compression_mode_ext_multi(dsi_ctx, true,
+					    MIPI_DSI_COMPRESSION_DSC, 0);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x60, 0x01);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf7, 0x0b);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x40, 0xf2);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf2, 0x03);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x11, 0xfe);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfe, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x0d, 0xb2);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb2, 0x05);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x0c, 0xb2);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb2, 0x30);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf7, 0x0b);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xe1, 0x93);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x06, 0xf4);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf4, 0x1f);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x53, 0x28);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x51, 0x00, 0x00);
+	mipi_dsi_msleep(dsi_ctx, 100);
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+
+}
+
+static void m7_off(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	dsi_ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 150);
+
+}
+
+static int m7_prepare(struct drm_panel *panel)
+{
+	struct m7_panel *ctx = to_m7_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return ret;
+
+	/* vendor supply-post-on-sleep is 20 ms */
+	usleep_range(20000, 21000);
+
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+
+	m7_reset(ctx);
+
+	m7_on(ctx, &dsi_ctx);
+
+	if (dsi_ctx.accum_err) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	}
+
+	return dsi_ctx.accum_err;
+}
+
+static int m7_disable(struct drm_panel *panel)
+{
+	struct m7_panel *ctx = to_m7_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	m7_off(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int m7_unprepare(struct drm_panel *panel)
+{
+	struct m7_panel *ctx = to_m7_panel(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	return 0;
+}
+
+/*
+ * Fixed 120 Hz mode from the vendor timing: 1080x2400, horizontal
+ * porches 120/120/28, vertical porches 20/10/2. DFPS 90/60 Hz are
+ * reached by the vendor stack through vfp changes and are not wired
+ * up yet.
+ */
+static const struct drm_display_mode m7_mode = {
+	.clock = (1080 + 120 + 28 + 120) * (2400 + 20 + 2 + 10) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 120,
+	.hsync_end = 1080 + 120 + 28,
+	.htotal = 1080 + 120 + 28 + 120,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 20,
+	.vsync_end = 2400 + 20 + 2,
+	.vtotal = 2400 + 20 + 2 + 10,
+	.width_mm = 70,
+	.height_mm = 155,
+};
+
+static int m7_get_modes(struct drm_panel *panel,
+			struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &m7_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs m7_panel_funcs = {
+	.prepare = m7_prepare,
+	.unprepare = m7_unprepare,
+	.disable = m7_disable,
+	.get_modes = m7_get_modes,
+};
+
+static int m7_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static int m7_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops m7_bl_ops = {
+	.update_status = m7_bl_update_status,
+	.get_brightness = m7_bl_get_brightness,
+};
+
+static struct backlight_device *m7_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	/* vendor DCS brightness range is 11 bit, max level 2047 */
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 1023,
+		.max_brightness = 2047,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &m7_bl_ops, &props);
+}
+
+static int m7_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct m7_panel *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->supplies[0].supply = "vddio";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->enable_gpio = devm_gpiod_get_optional(dev, "enable",
+						   GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+		MIPI_DSI_MODE_VIDEO_BURST |
+		MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_init(&ctx->panel, dev, &m7_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = m7_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 20;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void m7_remove(struct mipi_dsi_device *dsi)
+{
+	struct m7_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id m7_of_match[] = {
+	{ .compatible = "xiaomi,m7-38-0c-0a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, m7_of_match);
+
+static struct mipi_dsi_driver m7_driver = {
+	.probe = m7_probe,
+	.remove = m7_remove,
+	.driver = {
+		.name = "panel-xiaomi-m7",
+		.of_match_table = m7_of_match,
+	},
+};
+module_mipi_dsi_driver(m7_driver);
+
+MODULE_DESCRIPTION("DRM driver for Xiaomi M7 38 0C 0A AMOLED DSI panel");
+MODULE_LICENSE("GPL");
