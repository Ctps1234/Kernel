+  Some downstream RPM implementations group PMIC regulators and generic
+  voltage-level votes under qcom,rpm-smd-regulator-resource nodes. The resource
+  node supplies the RPM resource type and ID and populates its children. Both
+  physical PMIC regulators and voltage-level votes use the compatible
+  qcom,rpm-smd-regulator; the qcom,use-voltage-level and
+  qcom,use-voltage-floor-level properties select the level-vote form. A
+  physical PM6125 regulator child is matched against its regulator-name and
+  the containing resource type and ID.
+
 maintainers:
   - Andy Gross <agross@kernel.org>
   - Bjorn Andersson <bjorn.andersson@linaro.org>
 
+$defs:
+  rpm-smd-regulator:
+    type: object
+    properties:
+      compatible:
+        const: qcom,rpm-smd-regulator
+
+      regulator-name:
+        $ref: /schemas/types.yaml#/definitions/string
+
+      qcom,set:
+        description: Bitmask selecting active and/or sleep RPM states.
+        enum: [1, 2, 3]
+
+      qcom,init-voltage:
+        description: Initial voltage vote in microvolts for a physical PMIC rail.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
+      qcom,use-voltage-level:
+        description: Use the RPM vlvl key for a generic voltage-level vote.
+        type: boolean
+
+      qcom,use-voltage-floor-level:
+        description: Use the RPM vfl key for a generic voltage-floor vote.
+        type: boolean
+
+      qcom,init-voltage-level:
+        description: Initial voltage-level vote sent with the RPM vlvl key.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
+      qcom,init-voltage-floor-level:
+        description: Initial voltage-floor vote sent with the RPM vfl key.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
+      qcom,always-send-voltage:
+        description: Keep this regulator's voltage key in the aggregate when disabled.
+        type: boolean
+
+    required:
+      - compatible
+      - regulator-name
+      - qcom,set
+
+    allOf:
+      - $ref: regulator.yaml#
+      - if:
+          anyOf:
+            - required: [qcom,use-voltage-level]
+            - required: [qcom,use-voltage-floor-level]
+        then:
+          required:
+            - regulator-min-microvolt
+            - regulator-max-microvolt
+          oneOf:
+            - required: [qcom,use-voltage-level]
+              not:
+                required: [qcom,use-voltage-floor-level]
+            - required: [qcom,use-voltage-floor-level]
+              not:
+                required: [qcom,use-voltage-level]
+        else:
+          not:
+            anyOf:
+              - required: [qcom,init-voltage-level]
+              - required: [qcom,init-voltage-floor-level]
+
+    unevaluatedProperties: false
+
+  rpm-smd-regulator-cooling-device:
+    type: object
+    properties:
+      compatible:
+        const: qcom,regulator-cooling-device
+
+      regulator-cdev-supply:
+        $ref: /schemas/types.yaml#/definitions/phandle
+
+      regulator-levels:
+        $ref: /schemas/types.yaml#/definitions/uint32-array
+
+      '#cooling-cells':
+        const: 2
+
+    required:
+      - compatible
+      - regulator-cdev-supply
+      - regulator-levels
+      - '#cooling-cells'
+
+    additionalProperties: false
+
