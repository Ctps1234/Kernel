diff --git a/Documentation/devicetree/bindings/clock/qcom,khaje-debugcc.yaml b/Documentation/devicetree/bindings/clock/qcom,khaje-debugcc.yaml
new file mode 100644
index 000000000..5510fab9b
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/qcom,khaje-debugcc.yaml
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/qcom,khaje-debugcc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Khaje Debug Clock Controller
+
+maintainers:
+  - Taniya Das <quic_tdas@quicinc.com>
+
+description: |
+  Qualcomm Khaje debug clock controller provides debug mux clocks and the
+  frequency-measurement interface for SM6225 clock controllers.
+
+properties:
+  compatible:
+    const: qcom,khaje-debugcc
+
+  clocks:
+    items:
+      - description: RPM XO clock source
+      - description: GCC clock-controller reference
+      - description: Display clock-controller reference
+      - description: GPU clock-controller reference
+    minItems: 4
+    maxItems: 4
+
+  clock-names:
+    items:
+      - const: xo_clk_src
+      - const: gcc
+      - const: dispcc
+      - const: gpucc
+    minItems: 4
+    maxItems: 4
+
+  qcom,gcc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: GCC regmap provider
+
+  qcom,dispcc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Display clock-controller regmap provider
+
+  qcom,gpucc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: GPU clock-controller regmap provider
+
+  qcom,mccc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Memory-controller regmap provider
+
+  qcom,apsscc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Application-processor subsystem regmap provider
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - clocks
+  - clock-names
+  - qcom,gcc
+  - qcom,dispcc
+  - qcom,gpucc
+  - qcom,mccc
+  - qcom,apsscc
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmcc.h>
+    clock-controller {
+      compatible = "qcom,khaje-debugcc";
+      clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>, <&gcc 0>,
+               <&dispcc 0>, <&gpucc 0>;
+      clock-names = "xo_clk_src", "gcc", "dispcc", "gpucc";
+      qcom,gcc = <&gcc>;
+      qcom,dispcc = <&dispcc>;
+      qcom,gpucc = <&gpucc>;
+      qcom,mccc = <&mccc>;
+      qcom,apsscc = <&apsscc>;
+      #clock-cells = <1>;
+    };
+...
