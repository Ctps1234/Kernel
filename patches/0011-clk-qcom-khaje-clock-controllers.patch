+    maxItems: 7
+
+  vdd_cx-supply:
+    description: CX voltage-corner regulator
+
+  vdd_mx-supply:
+    description: MX voltage-corner regulator
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - '#clock-cells'
+  - '#reset-cells'
+  - vdd_cx-supply
+  - vdd_mx-supply
+
+allOf:
+  - $ref: qcom,gcc.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmcc.h>
+    #include <dt-bindings/clock/qcom,gcc-khaje.h>
+    clock-controller@1400000 {
+      compatible = "qcom,khaje-gcc", "syscon";
+      reg = <0x01400000 0x001f0000>;
+      reg-names = "cc_base";
+      clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>,
+               <&rpmcc RPM_SMD_XO_A_CLK_SRC>,
+               <&sleep_clk>,
+               <&ufs_phy_rx_symbol_0_clk>,
+               <&ufs_phy_rx_symbol_1_clk>,
+               <&ufs_phy_tx_symbol_0_clk>,
+               <&usb3_phy_wrapper_pipe_clk>;
+      clock-names = "bi_tcxo", "bi_tcxo_ao", "sleep_clk",
+                    "ufs_phy_rx_symbol_0_clk", "ufs_phy_rx_symbol_1_clk",
+                    "ufs_phy_tx_symbol_0_clk",
+                    "usb3_phy_wrapper_gcc_usb30_pipe_clk";
+      vdd_cx-supply = <&vdd_cx>;
+      vdd_mx-supply = <&vdd_mx>;
+      #clock-cells = <1>;
+      #reset-cells = <1>;
+    };
+...
