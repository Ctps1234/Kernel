+static int gcc_khaje_pre_probe(struct device *dev, struct regmap *regmap)
+{
+	static const struct qcom_cc_regmap_update always_on_updates[] = {
+		{ .reg = 0x17028, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x2b004, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x1702c, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x36004, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x17008, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x1700c, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x2b06c, .mask = BIT(0), .val = BIT(0) },
+		{ .reg = 0x3a00c, .mask = BIT(0), .val = BIT(0) },
+	};
+	int ret;
+
+	ret = qcom_cc_update_regmap_sequence(dev, regmap, always_on_updates,
+					     ARRAY_SIZE(always_on_updates));
+	if (ret)
+		return ret;
+
+	ret = clk_lucid_pll_configure(&gpll10, regmap, &gpll10_config);
+	if (ret)
+		return ret;
+	ret = clk_lucid_pll_configure(&gpll11, regmap, &gpll11_config);
+	if (ret)
+		return ret;
+	ret = clk_lucid_pll_configure(&gpll8, regmap, &gpll8_config);
+	if (ret)
+		return ret;
+	ret = clk_zonda_pll_configure(&gpll9, regmap, &gpll9_config);
+	if (ret)
+		return ret;
+
+	return qcom_cc_register_rcg_dfs(regmap, gcc_dfs_clocks,
+					ARRAY_SIZE(gcc_dfs_clocks));
