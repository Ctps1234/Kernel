Subject: [PATCH 4/11] clk: qcom: add Khaje RPM SMD clock support

Add the Khaje RPM clock descriptor, reusing shared SMD-RPM clock objects
in the pinned Android Common 6.12 target. Preserve Khaje's resource IDs,
including SNOC on BUS_CLK ID 2, CNOC on BUS_CLK ID 1, and RF_CLK1/2 on
XO-buffer IDs 4/5.

The downstream Khaje driver also sends an active-set-only INT_MAX BIMC
vote and keeps XO, CNOC, SNOC, and QUP active. Express those votes through
the target's SMD-RPM transport and CCF APIs rather than carrying over the
vendor msm_rpm_send_message path.

Cache required keepalive rates before preparing the clocks, and fail the
provider probe if an essential RPM clock or interconnect child cannot be
registered.

This does not port Khaje clk_vdd_class handling, the Bengal interconnect
provider, or any DTS/DTBO source.

---
diff --git a/drivers/clk/qcom/clk-smd-rpm.c b/drivers/clk/qcom/clk-smd-rpm.c
index 45c5255bc..cc3194ed5 100644
--- a/drivers/clk/qcom/clk-smd-rpm.c
+++ b/drivers/clk/qcom/clk-smd-rpm.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/clk-provider.h>
+#include <linux/clk.h>
 #include <linux/err.h>
 #include <linux/export.h>
 #include <linux/init.h>
@@ -170,9 +171,18 @@ struct clk_smd_rpm {
 	unsigned long rate;
 };
 
+struct rpm_smd_clk_keepalive {
+	struct clk_smd_rpm *clk;
+	unsigned long rate;
+};
+
 struct rpm_smd_clk_desc {
 	struct clk_smd_rpm **clks;
 	size_t num_clks;
+	const struct clk_smd_rpm ** const active_handoff_clks;
+	size_t num_active_handoff_clks;
+	const struct rpm_smd_clk_keepalive *keepalive_clks;
+	size_t num_keepalive_clks;
 
 	/*
 	 * Interconnect clocks are managed by the icc framework, this driver
@@ -186,6 +196,19 @@ struct rpm_smd_clk_desc {
 
 static DEFINE_MUTEX(rpm_smd_clk_lock);
 
+static int clk_smd_rpm_handoff_active(const struct clk_smd_rpm *r)
+{
+	struct clk_smd_rpm_req req = {
+		.key = cpu_to_le32(r->rpm_key),
+		.nbytes = cpu_to_le32(sizeof(u32)),
+		.value = cpu_to_le32(r->branch ? 1 : INT_MAX),
+	};
+
+	return qcom_rpm_smd_write(rpmcc_smd_rpm, QCOM_SMD_RPM_ACTIVE_STATE,
+				  r->rpm_res_type, r->rpm_clk_id, &req,
+				  sizeof(req));
+}
+
 static int clk_smd_rpm_handoff(const struct clk_smd_rpm *r)
 {
 	int ret;
@@ -195,18 +218,13 @@ static int clk_smd_rpm_handoff(const struct clk_smd_rpm *r)
 		.value = cpu_to_le32(r->branch ? 1 : INT_MAX),
 	};
 
-	ret = qcom_rpm_smd_write(rpmcc_smd_rpm, QCOM_SMD_RPM_ACTIVE_STATE,
-				 r->rpm_res_type, r->rpm_clk_id, &req,
-				 sizeof(req));
-	if (ret)
-		return ret;
-	ret = qcom_rpm_smd_write(rpmcc_smd_rpm, QCOM_SMD_RPM_SLEEP_STATE,
-				 r->rpm_res_type, r->rpm_clk_id, &req,
-				 sizeof(req));
+	ret = clk_smd_rpm_handoff_active(r);
 	if (ret)
 		return ret;
 
-	return 0;
+	return qcom_rpm_smd_write(rpmcc_smd_rpm, QCOM_SMD_RPM_SLEEP_STATE,
+				  r->rpm_res_type, r->rpm_clk_id, &req,
+				  sizeof(req));
 }
 
 static int clk_smd_rpm_set_rate_active(struct clk_smd_rpm *r,
@@ -347,8 +365,10 @@ static int clk_smd_rpm_set_rate(struct clk_hw *hw, unsigned long rate,
 
 	mutex_lock(&rpm_smd_clk_lock);
 
-	if (!r->enabled)
+	if (!r->enabled) {
+		r->rate = rate;
 		goto out;
+	}
 
 	to_active_sleep(r, rate, &this_rate, &this_sleep_rate);
 
@@ -1117,6 +1137,59 @@ static const struct rpm_smd_clk_desc rpm_clk_sm6125 = {
 	.num_icc_clks = ARRAY_SIZE(sm_qnoc_icc_clks)
 };
 
+/* Khaje */
+static struct clk_smd_rpm *khaje_clks[] = {
+	[RPM_SMD_XO_CLK_SRC] = &clk_smd_rpm_branch_bi_tcxo,
+	[RPM_SMD_XO_A_CLK_SRC] = &clk_smd_rpm_branch_bi_tcxo_a,
+	[RPM_SMD_SNOC_CLK] = &clk_smd_rpm_bus_2_snoc_clk,
+	[RPM_SMD_SNOC_A_CLK] = &clk_smd_rpm_bus_2_snoc_a_clk,
+	[RPM_SMD_BIMC_CLK] = &clk_smd_rpm_bimc_clk,
+	[RPM_SMD_BIMC_A_CLK] = &clk_smd_rpm_bimc_a_clk,
+	[RPM_SMD_QDSS_CLK] = &clk_smd_rpm_branch_qdss_clk,
+	[RPM_SMD_QDSS_A_CLK] = &clk_smd_rpm_branch_qdss_a_clk,
+	[RPM_SMD_RF_CLK1] = &clk_smd_rpm_rf_clk1,
+	[RPM_SMD_RF_CLK1_A] = &clk_smd_rpm_rf_clk1_a,
+	[RPM_SMD_RF_CLK2] = &clk_smd_rpm_rf_clk2,
+	[RPM_SMD_RF_CLK2_A] = &clk_smd_rpm_rf_clk2_a,
+	[RPM_SMD_CNOC_CLK] = &clk_smd_rpm_bus_1_cnoc_clk,
+	[RPM_SMD_CNOC_A_CLK] = &clk_smd_rpm_bus_1_cnoc_a_clk,
+	[RPM_SMD_IPA_CLK] = &clk_smd_rpm_ipa_clk,
+	[RPM_SMD_IPA_A_CLK] = &clk_smd_rpm_ipa_a_clk,
+	[RPM_SMD_CE1_CLK] = &clk_smd_rpm_ce1_clk,
+	[RPM_SMD_CE1_A_CLK] = &clk_smd_rpm_ce1_a_clk,
+	[RPM_SMD_QUP_CLK] = &clk_smd_rpm_qup_clk,
+	[RPM_SMD_QUP_A_CLK] = &clk_smd_rpm_qup_a_clk,
+	[RPM_SMD_MMRT_CLK] = &clk_smd_rpm_mmrt_clk,
+	[RPM_SMD_MMRT_A_CLK] = &clk_smd_rpm_mmrt_a_clk,
+	[RPM_SMD_MMNRT_CLK] = &clk_smd_rpm_mmnrt_clk,
+	[RPM_SMD_MMNRT_A_CLK] = &clk_smd_rpm_mmnrt_a_clk,
+	[RPM_SMD_SNOC_PERIPH_CLK] = &clk_smd_rpm_bus_0_snoc_periph_clk,
+	[RPM_SMD_SNOC_PERIPH_A_CLK] = &clk_smd_rpm_bus_0_snoc_periph_a_clk,
+	[RPM_SMD_SNOC_LPASS_CLK] = &clk_smd_rpm_bus_5_snoc_lpass_clk,
+	[RPM_SMD_SNOC_LPASS_A_CLK] = &clk_smd_rpm_bus_5_snoc_lpass_a_clk,
+};
+
+/* The downstream Khaje driver votes for BIMC in the active set only. */
+static const struct clk_smd_rpm *khaje_active_handoff_clks[] = {
+	&clk_smd_rpm_bimc_clk,
+};
+
+static const struct rpm_smd_clk_keepalive khaje_keepalive_clks[] = {
+	{ .clk = &clk_smd_rpm_branch_bi_tcxo_a },
+	{ .clk = &clk_smd_rpm_bus_1_cnoc_a_clk, .rate = 19200000 },
+	{ .clk = &clk_smd_rpm_bus_2_snoc_a_clk, .rate = 19200000 },
+	{ .clk = &clk_smd_rpm_qup_a_clk, .rate = 19200000 },
+};
+
+static const struct rpm_smd_clk_desc rpm_clk_khaje = {
+	.clks = khaje_clks,
+	.num_clks = ARRAY_SIZE(khaje_clks),
+	.active_handoff_clks = khaje_active_handoff_clks,
+	.num_active_handoff_clks = ARRAY_SIZE(khaje_active_handoff_clks),
+	.keepalive_clks = khaje_keepalive_clks,
+	.num_keepalive_clks = ARRAY_SIZE(khaje_keepalive_clks),
+};
+
 /* SM6115 */
 static struct clk_smd_rpm *sm6115_clks[] = {
 	[RPM_SMD_XO_CLK_SRC] = &clk_smd_rpm_branch_bi_tcxo,
@@ -1228,6 +1301,7 @@ static const struct of_device_id rpm_smd_clk_match_table[] = {
 	{ .compatible = "qcom,rpmcc-sdm660",  .data = &rpm_clk_sdm660  },
 	{ .compatible = "qcom,rpmcc-sm6115",  .data = &rpm_clk_sm6115  },
 	{ .compatible = "qcom,rpmcc-sm6125",  .data = &rpm_clk_sm6125  },
+	{ .compatible = "qcom,rpmcc-khaje",  .data = &rpm_clk_khaje  },
 	{ .compatible = "qcom,rpmcc-sm6375",  .data = &rpm_clk_sm6375  },
 	{ }
 };
@@ -1254,6 +1328,50 @@ static void rpm_smd_unregister_icc(void *data)
 	platform_device_unregister(icc_pdev);
 }
 
+static bool rpm_smd_clk_active_handoff(const struct rpm_smd_clk_desc *desc,
+				       const struct clk_smd_rpm *clk)
+{
+	size_t i;
+
+	for (i = 0; i < desc->num_active_handoff_clks; i++) {
+		if (desc->active_handoff_clks[i] == clk)
+			return true;
+	}
+
+	return false;
+}
+
+static void rpm_smd_clk_disable_keepalive(void *data)
+{
+	clk_disable_unprepare(data);
+}
+
+static int rpm_smd_clk_enable_keepalive(struct device *dev,
+					const struct rpm_smd_clk_keepalive *keepalive)
+{
+	struct clk *clk;
+	int ret;
+
+	clk = devm_clk_hw_get_clk(dev, &keepalive->clk->hw, "keepalive");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	/* Cache the desired rate before prepare so the first RPM vote is
+	 * the minimum keepalive rate, not the clock's generic initial maximum.
+	 */
+	if (keepalive->rate) {
+		ret = clk_set_rate(clk, keepalive->rate);
+		if (ret)
+			return ret;
+	}
+
+	ret = clk_prepare_enable(clk);
+	if (ret)
+		return ret;
+
+	return devm_add_action_or_reset(dev, rpm_smd_clk_disable_keepalive, clk);
+}
+
 static int rpm_smd_clk_probe(struct platform_device *pdev)
 {
 	int ret;
@@ -1285,7 +1403,10 @@ static int rpm_smd_clk_probe(struct platform_device *pdev)
 		if (!rpm_smd_clks[i])
 			continue;
 
-		ret = clk_smd_rpm_handoff(rpm_smd_clks[i]);
+		if (rpm_smd_clk_active_handoff(desc, rpm_smd_clks[i]))
+			ret = clk_smd_rpm_handoff_active(rpm_smd_clks[i]);
+		else
+			ret = clk_smd_rpm_handoff(rpm_smd_clks[i]);
 		if (ret)
 			goto err;
 	}
@@ -1322,14 +1443,26 @@ static int rpm_smd_clk_probe(struct platform_device *pdev)
 	icc_pdev = platform_device_register_data(pdev->dev.parent,
 						 "icc_smd_rpm", -1, NULL, 0);
 	if (IS_ERR(icc_pdev)) {
-		dev_err(&pdev->dev, "Failed to register icc_smd_rpm device: %pE\n",
-			icc_pdev);
-		/* No need to unregister clocks because of this */
-	} else {
-		ret = devm_add_action_or_reset(&pdev->dev, rpm_smd_unregister_icc,
-					       icc_pdev);
-		if (ret)
+		ret = PTR_ERR(icc_pdev);
+		dev_err(&pdev->dev, "Failed to register icc_smd_rpm device: %d\n",
+			ret);
+		goto err;
+	}
+
+	ret = devm_add_action_or_reset(&pdev->dev, rpm_smd_unregister_icc,
+				       icc_pdev);
+	if (ret)
+		goto err;
+
+	for (i = 0; i < desc->num_keepalive_clks; i++) {
+		ret = rpm_smd_clk_enable_keepalive(&pdev->dev,
+						   &desc->keepalive_clks[i]);
+		if (ret) {
+			dev_err(&pdev->dev,
+				"Failed to enable RPM keepalive clock %zu: %d\n",
+				i, ret);
 			goto err;
+		}
 	}
 
 	return 0;
