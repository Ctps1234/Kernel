From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Port <port@local>
Date: Sun, 18 Oct 2026 00:00:00 -0300
Subject: [PATCH] dt-bindings: ufs: document SM6225 host resources

The Khaje/SM6225 UFS host uses the generic qcom,ufshc driver with a
SoC-specific compatible fallback. Its nine-clock order differs from the
existing Qualcomm tuples. Document it, along with the two resource names used
by the target drivers: MCQ looks up ufs_mem, while Qualcomm ICE looks up ice.

Require the clocks, PHY, and named interconnect paths that the 6.12 host driver
acquires during probe. Downstream-only properties without a target consumer
are omitted from the port DTS; standard interconnect, clock, supply, reset,
IOMMU, and frequency properties remain.

---
--- a/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
+++ b/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
@@ -34,6 +34,7 @@
           - qcom,sdm845-ufshc
           - qcom,sm6115-ufshc
           - qcom,sm6125-ufshc
+          - qcom,sm6225-ufshc
           - qcom,sm6350-ufshc
           - qcom,sm8150-ufshc
           - qcom,sm8250-ufshc
@@ -87,7 +88,9 @@
 
   reg-names:
     items:
-      - const: std
+      - enum:
+          - std
+          - ufs_mem
       - const: ice
 
   required-opps:
@@ -182,6 +185,7 @@
           contains:
             enum:
               - qcom,sdm845-ufshc
+              - qcom,sm6225-ufshc
               - qcom,sm6350-ufshc
               - qcom,sm8150-ufshc
     then:
@@ -265,6 +269,32 @@
           minItems: 2
       required:
         - reg-names
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,sm6225-ufshc
+    then:
+      properties:
+        reg-names:
+          items:
+            - const: ufs_mem
+            - const: ice
+      required:
+        - clocks
+        - clock-names
+        - interconnects
+        - interconnect-names
+        - phys
+        - phy-names
+        - reg-names
+    else:
+      properties:
+        reg-names:
+          items:
+            - const: std
+            - const: ice
 
     # TODO: define clock bindings for qcom,msm8994-ufshc
 
@@ -352,3 +382,29 @@
             qcom,ice = <&ice>;
         };
     };
+  - |
+    soc {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        ufshc@4804000 {
+            compatible = "qcom,sm6225-ufshc", "qcom,ufshc",
+                         "jedec,ufs-2.0";
+            reg = <0x4804000 0x3000>, <0x4810000 0x8000>;
+            reg-names = "ufs_mem", "ice";
+            interrupts = <0 356 4>;
+            phys = <&ufsphy_mem>;
+            phy-names = "ufsphy";
+            interconnects = <&system_noc 0 &bimc 0>,
+                            <&bimc 0 &config_noc 0>;
+            interconnect-names = "ufs-ddr", "cpu-ufs";
+
+            clock-names = "core_clk", "bus_aggr_clk", "iface_clk",
+                          "core_clk_unipro", "ref_clk", "tx_lane0_sync_clk",
+                          "rx_lane0_sync_clk", "rx_lane1_sync_clk",
+                          "ice_core_clk";
+            clocks = <&gcc 0>, <&gcc 1>, <&gcc 2>,
+                     <&gcc 3>, <&rpmcc 0>, <&gcc 5>,
+                     <&gcc 6>, <&gcc 7>, <&gcc 4>;
+        };
+    };
