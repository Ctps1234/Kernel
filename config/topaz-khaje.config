# Configuração mínima do port Khaje (SM6225) para topaz/tapas.
#
# Fragmento aplicado sobre o defconfig GKI da base Android Common 6.12
# fixada (0efd3abd3c356d644ea49f6ed37e9830b78d34e3), depois de
# `make defconfig` + `scripts/kconfig/merge_config.sh` + `make olddefconfig`.
#
# Habilita os drivers e serviços portados pela série 0001–0017:
#   PINCTRL_KHAJE             (0002) TLMM Khaje
#   COMMON_CLK_QCOM           (0010/0011) framework de clocks Qualcomm
#   SM_GCC_6225               (0011) GCC Khaje
#   SM_DISPCC_6225            (0011) DISPCC Khaje
#   SM_GPUCC_6225             (0011) GPUCC Khaje
#   SM_DEBUGCC_6225           (0011) debugcc Khaje
#   INTERCONNECT_QCOM_BENGAL  (0007) fabrics Bengal
#   REGULATOR_QCOM_SMD_RPM    (0009) regulador RPM-SMD com votos
#   PHY_QCOM_QMP_UFS          (0006) PHY UFS QMP SM6225
#   QCOM_PANEL_EVENT_NOTIFIER (0015) API de eventos do painel DRM
#   DRM_MSM_DPU               (0016) catálogo DPU Khaje 6.10
#   DRM_MSM_MDSS              (0017) dados MDSS/UBWC Khaje (via DPU)
#
# ARCH_QCOM é pré-requisito de COMMON_CLK_QCOM e INTERCONNECT_QCOM na base
# 6.12 (ambas as opções dependem de ARCH_QCOM).
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SMD_RPM=y

CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_6225=y
CONFIG_SM_DISPCC_6225=y
CONFIG_SM_GPUCC_6225=y
CONFIG_SM_DEBUGCC_6225=y

CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_KHAJE=y

CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BENGAL=y

CONFIG_REGULATOR_QCOM_SMD_RPM=y

CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Helper de eventos consumido por clientes de painel; ainda sem produtor DSI.
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=y

# Display embutido (0015–0017). O defconfig arm64 da base deixa DRM e
# DRM_MSM como =m; nesse estado o `make Image` do CI nao compila nem
# linka o catalogo DPU Khaje (0016) nem os dados MDSS/UBWC (0017), e o
# notifier 0015 (tristate, depends on DRM) seria rebaixado para =m.
# DRM_MSM embutido tambem e o formato desejado para console/display
# inicial neste bring-up. DRM_MSM_DPU seleciona DRM_MSM_MDSS.
#
# LLCC/OCMEM nao tem nos no DTS/FDT Khaje avaliado (o catalogo usa
# min_llcc_ib=0) e vem =m no defconfig; pelas dependencias
# `QCOM_LLCC || QCOM_LLCC=n` (idem OCMEM) isso travaria DRM_MSM em =m.
# Desliga-los aqui destrava o =y sem embutir drivers sem hardware alvo.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y

# Backlight embutido: o defconfig o deixa =m e travaria os drivers de
# painel (depends on BACKLIGHT_CLASS_DEVICE) fora do Image. O painel
# M7 _0a (0021) entra embutido para compilar/linkar junto ao stack.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_XIAOMI_M7=y
# CONFIG_QCOM_LLCC is not set
# CONFIG_QCOM_OCMEM is not set

# --- Boot minimo (fase B2) e paridade de armazenamento (fase B1) ------------
#
# Host UFS da Qualcomm: é boot-critical. Como módulo, ele não entra antes
# de o sistema de arquivos ser montado e o aparelho não sobe. O driver
# drivers/ufs/host/ufs-qcom.c casa com o compatible "qcom,ufshc" usado no
# DTS (khaje.dtsi), portanto nenhuma mudança de device-tree é necessária.
CONFIG_SCSI_UFS_QCOM=y

# Device-mapper embutido: base do dm-verity/dm-crypt das partições Android.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# Filesystems usados pelo Android: f2fs em /data, EROFS em /system e /vendor.
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y

# Gadget USB embutido: o adbd usa a função ffs sem depender de insmod a
# partir da ramdisk.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# Backend de pstore em bloco: preserva o log de crash em reboot/panic.
# A base 6.12 pinada nao traz o backend ramoops (fs/pstore/ramops.c), e sim o
# pstore/blk, que e o usado pelo Android (particao "ram").
CONFIG_PSTORE_BLK=y

# Touchscreen FocalTech FT3519T do painel M7 _0a (patch 0022): driver
# upstream edt-ft5x06 com o compatible focaltech,ft3519 e o desempaque
# de coordenadas de 15 bits. O IC esta no QUPv3 SE2; o barramento sobe
# pelo GENI upstream (QCOM_GENI_SE + I2C_QCOM_GENI). Tudo embutido para
# compilar/linkar no Image junto ao stack de display; o no DTS continua
# no prototipo desabilitado (device-tree/test/khaje-touch-upstream.dtsi).
CONFIG_I2C=y
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# Fundacao de audio: ADSP PAS upstream (patch 0026) e o loader de
# compatibilidade qcom,adsp-loader (patch 0027). O PAS cobre o
# remoteproc do Hexagon de audio com auto_boot=false no recurso SM6225;
# o loader preserva /sys/kernel/boot_adsp/{boot,ssr}, que o init vendor
# escreve no early-boot, sobre rproc_boot()/rproc_shutdown(). O QFPROM
# entra embutido para a leitura da celula NVMEM adsp_variant nao deixar
# o loader preso em probe deferido. QCOM_SYSMON e
# RPMSG_QCOM_GLINK_SMEM precisam ficar =y junto porque, como =m no
# defconfig, travariam QCOM_Q6V5_PAS fora do Image. Os nos continuam
# somente no prototipo desabilitado
# (device-tree/test/khaje-adsp-upstream.dtsi); nao ha codecs nem card.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_ADSP_LOADER=y

# Cadeia GPR/QDSP6 upstream sobre o ADSP (somente o prototipo
# desabilitado em device-tree/test/khaje-adsp-upstream.dtsi).
# QCOM_APR e o transporte APR/GPR e seleciona QCOM_PDR_HELPERS;
# QRTR/QRTR_SMD entram embutidos porque PDR/QMI usa esse transporte
# e eles vem =m no defconfig. SND_SOC_QDSP6 seleciona Q6APM/Q6PRM
# (promptless) e tambem os servicos legados Q6; isto nao inclui
# maquina Bengal, WCD937x/Bolero, macros LPASS nem SoundWire.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_APR=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y
