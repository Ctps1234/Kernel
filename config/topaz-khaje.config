# Configuração mínima do port Khaje (SM6225) para topaz/tapas.
#
# Fragmento aplicado sobre o defconfig GKI da base Android Common 6.12
# fixada (0efd3abd3c356d644ea49f6ed37e9830b78d34e3), depois de
# `make defconfig` + `scripts/kconfig/merge_config.sh` + `make olddefconfig`.
#
# Habilita os drivers e serviços portados pela série 0001–0015:
#   PINCTRL_KHAJE             (0002) TLMM Khaje
#   COMMON_CLK_QCOM           (0010/0011) framework de clocks Qualcomm
#   SM_GCC_6225               (0011) GCC Khaje
#   SM_DISPCC_6225            (0011) DISPCC Khaje
#   SM_GPUCC_6225             (0011) GPUCC Khaje
#   SM_DEBUGCC_6225           (0011) debugcc Khaje
#   INTERCONNECT_QCOM_BENGAL  (0007) fabrics Bengal
#   REGULATOR_QCOM_SMD_RPM    (0009) regulador RPM-SMD com votos
#   PHY_QCOM_QMP_UFS          (0006) PHY UFS QMP SM6225
#   QCOM_PANEL_EVENT_NOTIFIER (0015) API de eventos do painel DRM
#
# ARCH_QCOM é pré-requisito de COMMON_CLK_QCOM e INTERCONNECT_QCOM na base
# 6.12 (ambas as opções dependem de ARCH_QCOM).
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SMD_RPM=y

CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_6225=y
CONFIG_SM_DISPCC_6225=y
CONFIG_SM_GPUCC_6225=y
CONFIG_SM_DEBUGCC_6225=y

CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_KHAJE=y

CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BENGAL=y

CONFIG_REGULATOR_QCOM_SMD_RPM=y

CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Helper de eventos consumido por clientes de painel; ainda sem produtor DSI.
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=y

# --- Boot mínimo (fase B2) e paridade de armazenamento (fase B1) ------------
#
# Host UFS da Qualcomm: é boot-critical. Como módulo, ele não entra antes
# de o sistema de arquivos ser montado e o aparelho não sobe. O driver
# drivers/ufs/host/ufs-qcom.c casa com o compatible "qcom,ufshc" usado no
# DTS (khaje.dtsi), portanto nenhuma mudança de device-tree é necessária.
CONFIG_SCSI_UFS_QCOM=y

# Device-mapper embutido: base do dm-verity/dm-crypt das partições Android.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# Filesystems usados pelo Android: f2fs em /data, EROFS em /system e /vendor.
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y

# Gadget USB embutido: o adbd usa a função ffs sem depender de insmod a
# partir da ramdisk.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# Backend de pstore em bloco: preserva o log de crash em reboot/panic.
# A base 6.12 pinada nao traz o backend ramoops (fs/pstore/ramops.c), e sim o
# pstore/blk, que e o usado pelo Android (particao "ram").
CONFIG_PSTORE_BLK=y
