&tlmm {
	sc8551_int_default {
		mux {
			pins = "gpio84";
			function = "gpio";
		};
		config {
			pins = "gpio84";
			drive-strength = <0x00000002>;
			bias-pull-up;
			input-enable;
		};
	};
};

&qupv3_se1_i2c {
	status = "okay";
	#address-cells = <0x00000001>;
	#size-cells = <0x00000000>;
	sc8551_standalone: sc8551-charger@66 {
		#io-channel-cells = <0x00000001>;
		compatible = "sc,sc8551-standalone";
		reg = <0x00000066>;
		irq-gpios = <&tlmm 0x00000054 0x00000000>;
		sc,sc8551,bat-therm-disable = <0x00000000>;
		sc,sc8551,bus-therm-disable = <0x00000000>;
		sc,sc8551,bat-ovp-threshold = <0x000011ad>;
		sc,sc8551,bat-ovp-alarm-threshold = <0x00001130>;
		sc,sc8551,bat-ocp-threshold = <0x00001f40>;
		sc,sc8551,bat-ocp-alarm-threshold = <0x00001d4c>;
		sc,sc8551,bus-ovp-threshold = <0x00002ee0>;
		sc,sc8551,bus-ovp-alarm-threshold = <0x00002af8>;
		sc,sc8551,bus-ocp-threshold = <0x00000ea6>;
		sc,sc8551,bus-ocp-alarm-threshold = <0x00000dac>;
		sc,sc8551,bat-ucp-alarm-threshold = <0x000007d0>;
		sc,sc8551,bat-therm-threshold = <0x00000015>;
		sc,sc8551,bus-therm-threshold = <0x00000015>;
		sc,sc8551,die-therm-threshold = <0x0000007d>;
		sc,sc8551,ac-ovp-threshold = <0x0000000c>;
		sc,sc8551,sense-resistor-mohm = <0x00000005>;
	};
	ln8000_charger: ln8000_charger@51 {
		#io-channel-cells = <0x00000001>;
		compatible = "lionsemi,ln8000-master";
		reg = <0x00000051>;
		irq-gpios = <&tlmm 0x00000054 0x00000000>;
		ln8000_charger,bat-ovp-threshold = <0x000011c6>;
		ln8000_charger,bat-ovp-alarm-threshold = <0x000011ad>;
		ln8000_charger,bus-ovp-threshold = <0x000032c8>;
		ln8000_charger,bus-ovp-alarm-threshold = <0x00002af8>;
		ln8000_charger,bus-ocp-threshold = <0x00000ea6>;
		ln8000_charger,bus-ocp-alarm-threshold = <0x00000dac>;
		ln8000_charger,ntc-alarm-cfg = <0x000000e2>;
		ln8000_charger,ext_ovp_ctrl = <0x00000000>;
		ln8000_charger,tdie-prot-disable;
		ln8000_charger,tbus-mon-disable;
		ln8000_charger,tbat-mon-disable;
	};
};

&soc {
	nopmi_chg: qcom,nopmi-chg {
