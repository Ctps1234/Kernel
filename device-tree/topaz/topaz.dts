/dts-v1/;

/*
 * DT da placa topaz (Redmi Note 12 4G), gerada por tools/curate_dt.py.
 * Fontes: topaz-overlay.dtso (sha256 d2cc07730af939f1...) e
 * topaz-live-reference.dts (memory). Nao revisado por upstream.
 * Nao flashar. A memoria e preenchida pelo bootloader.
 */

#include "khaje.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. KHAJE IDP nopmi topaz";
	compatible = "qcom,khaje-idp", "qcom,khaje", "qcom,idp";
	qcom,msm-id = <0x00000206 0x00010000>;
	qcom,board-id = <0x00030022 0x00000000>;
	qcom,pmic-id = <0x0000002d 0x00000000 0x00000000 0x00000000>;
};

/ {
	memory@40000000 {
		device_type = "memory";
		reg = <0x00000000 0x40000000 0x00000000 0x3dd00000 0x00000000 0xc0000000 0x00000000 0x80000000 0x00000000 0x80000000 0x00000000 0x40000000>;
	};
};

&thermal_zones {
	pm6125-tz {
		cooling-maps {
			trip0_cpu0 {
				trip = <&pm6125_trip0>;
				cooling-device = <&CPU0 0x00000007 0x00000007>;
			};
			trip0_cpu4 {
				trip = <&pm6125_trip0>;
				cooling-device = <&CPU4 0x00000006 0xffffffff>;
			};
			trip1_cpu1 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu1_pause 0x00000001 0x00000001>;
			};
			trip1_cpu2 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu2_pause 0x00000001 0x00000001>;
			};
			trip1_cpu3 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu3_pause 0x00000001 0x00000001>;
			};
			trip1_cpu4 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu4_pause 0x00000001 0x00000001>;
			};
			trip1_cpu5 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu5_pause 0x00000001 0x00000001>;
			};
			trip1_cpu6 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu6_pause 0x00000001 0x00000001>;
			};
			trip1_cpu7 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu7_pause 0x00000001 0x00000001>;
			};
		};
	};
};

&soc {
	fpc1020 {
		status = "okay";
		compatible = "fpc,fpc1020";
		interrupt-parent = <&tlmm>;
		interrupts = <0x00000053 0x00000000>;
		fpc,gpio_rst = <&tlmm 0x00000068 0x00000000>;
		fpc,gpio_irq = <&tlmm 0x00000053 0x00000000>;
		fpc,gpio_vdd_for_plsensor = <&tlmm 0x00000041 0x00000000>;
		vcc_spi-supply = <&pm6125_l9>;
		vdd_io-supply = <&pm6125_l9>;
		vdd_ana-supply = <&pm6125_l9>;
		fpc,enable-on-boot;
		pinctrl-names = "fpc1020_reset_reset", "fpc1020_reset_active", "fpc1020_irq_active";
		pinctrl-0 = <&msm_gpio_104>;
		pinctrl-1 = <&msm_gpio_104_output_high>;
		pinctrl-2 = <&msm_gpio_83>;
	};
	goodix_fp {
		compatible = "goodix,fingerprint";
		interrupt-parent = <&tlmm>;
		interrupt = <0x00000053 0x00000000>;
		vcc_spi_supply = <&pm6125_l9>;
		vcc_ana_supply = <&pm6125_l9>;
		vdd_io-supply = <&pm6125_l9>;
		fp-gpio-irq = <&tlmm 0x00000053 0x00000000>;
		fp-gpio-reset = <&tlmm 0x00000068 0x00000000>;
		fp-gpio-pwr = <&tlmm 0x00000041 0x00000000>;
		pinctrl-names = "goodix_reset_outputlow", "goodix_reset_outputhigh", "goodix_pwr_outputlow", "goodix_pwr_outputhigh";
		pinctrl-0 = <&msm_gpio_104>;
		pinctrl-1 = <&msm_gpio_104_output_high>;
		pinctrl-2 = <&msm_gpio_65>;
		pinctrl-3 = <&msm_gpio_65_output_high>;
		status = "okay";
	};
};

&tlmm {
	msm_gpio_104: msm_gpio_104 {
		mux {
			pins = "gpio104";
			function = "gpio";
		};
		config {
			pins = "gpio104";
			drive-strength = <0x00000002>;
			bias-disable;
			output-low;
		};
	};
	msm_gpio_104_output_high: msm_gpio_104_output_high {
		mux {
			pins = "gpio104";
			function = "gpio";
		};
		config {
			pins = "gpio104";
			drive-strength = <0x00000002>;
			bias-disable;
			output-high;
		};
	};
	msm_gpio_83: msm_gpio_83 {
		mux {
			pins = "gpio83";
			function = "gpio";
		};
		config {
			pins = "gpio83";
			drive-strength = <0x00000002>;
			bias-pull-down;
		};
	};
	msm_gpio_65: msm_gpio_65 {
		mux {
			pins = "gpio65";
			function = "gpio";
		};
		config {
			pins = "gpio65";
			drive-strength = <0x00000002>;
			bias-disable;
			output-low;
		};
	};
	msm_gpio_65_output_high: msm_gpio_65_output_high {
		mux {
			pins = "gpio65";
			function = "gpio";
		};
		config {
			pins = "gpio65";
			drive-strength = <0x00000002>;
			bias-disable;
			output-high;
		};
	};
};

&pm6125_vadc {
	pinctrl-0 = <&camera_therm_default &emmc_therm_default &rf_pa1_therm_default>;
	rf_pa1_therm {
		reg = <0x00000055>;
		label = "rf_pa1_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <0x000000c8>;
		qcom,pre-scaling = <0x00000001 0x00000001>;
	};
};

&pm6125_adc_tm {
	status = "okay";
	rf_pa1_therm {
		reg = <0x00000003>;
		io-channels = <&pm6125_vadc 0x00000055>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <0x000000c8>;
	};
};

&thermal_zones {
	rf-pa1-therm-usr {
		polling-delay-passive = <0x00000000>;
		polling-delay = <0x00000000>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm6125_adc_tm 0x00000003>;
		wake-capable-sensor;
		trips {
			active-config0 {
				temperature = <0x0001e848>;
				hysteresis = <0x000003e8>;
				type = "passive";
			};
		};
	};
};

&pm6125_gpios {
	oled_vci {
		oled_vci_default {
			pins = "gpio9";
			function = "normal";
			input-disable;
			power-source = <0x00000000>;
			bias-disable;
			output-high;
			qcom,drive-strength = <0x00000002>;
		};
		oled_vci_suspend {
			pins = "gpio9";
			function = "normal";
			input-disable;
			power-source = <0x00000000>;
			bias-disable;
			output-low;
			qcom,drive-strength = <0x00000002>;
		};
	};
	rf_pa1_therm {
		rf_pa1_therm_default: rf_pa1_therm_default {
			pins = "gpio7";
			bias-high-impedance;
		};
	};
	vib_out_gpio8 {
		vib_out_gpio8_default: vib_out_gpio8_default {
			pins = "gpio8";
			function = "normal";
			bias-pull-up;
			power-source = <0x00000000>;
		};
	};
	key_vol_up {
		key_vol_up_default: key_vol_up_default {
			pins = "gpio5";
			function = "normal";
			input-enable;
			bias-pull-up;
			power-source = <0x00000000>;
		};
	};
	eldo9_pin {
		usb_eldo9: gpio@c000 {
			pins = "gpio1";
			function = "normal";
			qcom,drive-strength = <0x00000002>;
			power-source = <0x00000000>;
			bias-disable;
			output-high;
		};
	};
};

&soc {
	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;
		vol_up {
			label = "volume_up";
			gpios = <&pm6125_gpios 0x00000005 0x00000001>;
			linux,input-type = <0x00000001>;
			linux,code = <0x00000073>;
			linux,can-disable;
			debounce-interval = <0x0000000f>;
			gpio-key,wakeup;
		};
	};
	ant_check {
		compatible = "ant_check";
		interrupt-parent = <&tlmm>;
		ant_check_gpio = <&tlmm 0x0000006b 0x00000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&ant_check_default>;
	};
	ant_check_div {
		compatible = "ant_check_div";
		interrupt-parent = <&tlmm>;
		ant_check_div_gpio = <&tlmm 0x00000019 0x00000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&ant_check_div_default>;
	};
	vibrator_gpio {
		status = "okay";
		compatible = "qcom,qpnp-vibrator-ldo-tz";
		pinctrl-names = "default";
		pinctrl-0 = <&vib_out_gpio8_default>;
		vib,en-gpio = <&pm6125_gpios 0x00000008 0x00000001>;
	};
	vdda_usb_ss_dp_core: vdda_usb_ss_dp_core {
		compatible = "regulator-fixed";
		regulator-name = "vdd_supply";
		regulator-min-microvolt = <0x000d6d80>;
		regulator-max-microvolt = <0x000d6d80>;
		enable-active-high;
		gpio = <&pm6125_gpios 0x00000001 0x00000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_eldo9>;
	};
};

&usb_qmp_dp_phy {
	vdd-supply = <&vdda_usb_ss_dp_core>;
};

&sdhc_1 {
	vdd-supply = <&L24A>;
	qcom,vdd-voltage-level = <0x002d2a80 0x002d2a80>;
	qcom,vdd-current-level = <0x00000000 0x0008b290>;
	vdd-io-supply = <&L11A>;
	qcom,vdd-io-always-on;
	qcom,vdd-io-lpm-sup;
	qcom,vdd-io-voltage-level = <0x001b7740 0x001b7740>;
	qcom,vdd-io-current-level = <0x00000000 0x0004f588>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc1_on>;
	pinctrl-1 = <&sdc1_off>;
	status = "okay";
};

&sdhc_2 {
	vdd-supply = <&L22A>;
	qcom,vdd-voltage-level = <0x002d2a80 0x002d2a80>;
	qcom,vdd-current-level = <0x00000000 0x000c3500>;
	vdd-io-supply = <&L5A>;
	qcom,vdd-io-voltage-level = <0x001b7740 0x002d2a80>;
	qcom,vdd-io-current-level = <0x00000000 0x000055f0>;
	vdd-io-bias-supply = <&L7A>;
	qcom,vdd-io-bias-voltage-level = <0x00132a40 0x00132a40>;
	qcom,vdd-io-bias-current-level = <0x00000000 0x00001770>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;
	cd-gpios = <&tlmm 0x00000058 0x00000001>;
	status = "okay";
};

&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4-khaje";
	vdda-phy-supply = <&L4A>;
	vdda-pll-supply = <&L18A>;
	vdda-phy-max-microamp = <0x00014ec4>;
	vdda-pll-max-microamp = <0x0000477c>;
	status = "okay";
};

&ufshc_mem {
	vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
	vdd-hba-fixed-regulator;
	vcc-supply = <&L24A>;
	vcc-max-microamp = <0x000c3500>;
	vccq2-supply = <&L11A>;
	vccq2-max-microamp = <0x000c3500>;
	qcom,vddp-ref-clk-supply = <&L18A>;
	qcom,vddp-ref-clk-max-microamp = <0x00000064>;
	reset-gpios = <&tlmm 0x00000071 0x00000001>;
	reset-names = "rst";
	status = "okay";
};

&pm6125_pwm {
	status = "okay";
};

&qupv3_se2_i2c {
	status = "okay";
	qcom,i2c-touch-active = "synaptics,tcm-i2c";
	synaptics_tcm@20 {
		compatible = "synaptics,tcm-i2c";
		reg = <0x00000020>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x00000050 0x00002008>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-2 = <&ts_release>;
		synaptics,irq-gpio = <&tlmm 0x00000050 0x00002008>;
		synaptics,irq-on-state = <0x00000000>;
		synaptics,reset-gpio = <&tlmm 0x00000056 0x00000000>;
		synaptics,reset-on-state = <0x00000000>;
		synaptics,reset-active-ms = <0x00000014>;
		synaptics,reset-delay-ms = <0x000000c8>;
		synaptics,power-delay-ms = <0x000000c8>;
		synaptics,ubl-i2c-addr = <0x00000020>;
		synaptics,extend_report;
		synaptics,firmware-name = "synaptics_firmware_k.img";
	};
	novatek@62 {
		reg = <0x00000062>;
		status = "okay";
		interrupt-parent = <&tlmm>;
		interrupts = <0x00000050 0x00002008>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-2 = <&ts_release>;
		novatek,reset-gpio = <&tlmm 0x00000056 0x00000000>;
		novatek,irq-gpio = <&tlmm 0x00000050 0x00002008>;
	};
};

&qupv3_se2_i2c {
	synaptics_tcm@20 {
		status = "disabled";
	};
	novatek@62 {
		status = "disabled";
	};
};

&tlmm {
	rt1711h_int_n: rt1711h_int_n {
		mux {
			pins = "gpio93";
			function = "gpio";
		};
		config {
			pins = "gpio93";
			drive-strength = <0x00000002>;
			bias-pull-up;
		};
	};
};

&qupv3_se1_i2c {
	rt1711h@4e {
		compatible = "richtek,rt1711h";
		reg = <0x0000004e>;
		status = "okay";
		#io-channel-cells = <0x00000001>;
		tcpc-dual,supported_modes = <0x00000000>;
		rt-tcpc,name = "type_c_port0";
		rt-tcpc,role_def = <0x00000005>;
		rt-tcpc,rp_level = <0x00000001>;
		rt-tcpc,vconn_supply = <0x00000001>;
		rt1711pd,intr_gpio = <&tlmm 0x0000005d 0x00000000>;
		rt1711pd,intr_gpio_num = <0x0000005d>;
		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_int_n>;
		pd-data {
			pd,vid = <0x000029cf>;
			pd,pid = <0x00001711>;
			pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
			pd,mfrs = "RichtekTCPC";
			pd,charging_policy = <0x00000031>;
			pd,source-pdo-size = <0x00000001>;
			pd,source-pdo-data = <0x00019032>;
			pd,sink-pdo-size = <0x00000001>;
			pd,sink-pdo-data = <0x000190c8>;
			pd,id-vdo-size = <0x00000006>;
			pd,id-vdo-data = <0xd14029cf 0x00000000 0x17110000 0x61000000 0x00000000 0x41000000>;
			bat,nr = <0x00000001>;
			pd,country_nr = <0x00000000>;
			bat-info0 {
				bat,vid = <0x000029cf>;
				bat,pid = <0x00001711>;
				bat,mfrs = "bat1";
				bat,design_cap = <0x00000bb8>;
			};
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			local_usb_comm;
			local_no_suspend;
			local_vconn_supply;
			attempt_enter_dp_mode;
			attempt_discover_cable;
			attempt_discover_id;
			pr_check = <0x00000000>;
			dr_check = <0x00000000>;
		};
		displayport {
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			typec,receptacle;
			ufp_d {
			};
			dfp_d {
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
			};
		};
	};
};

&soc {
	rpm: rt-pd-manager {
		compatible = "richtek,rt-pd-manager";
		#io-channel-cells = <0x00000001>;
		io-channels = <&nopmi_chg 0x0000000a &nopmi_chg 0x00000004 &nopmi_chg 0x0000000c &nopmi_chg 0x0000000b &nopmi_chg 0x00000000 &nopmi_chg 0x00000003 &nopmi_chg 0x0000001f &nopmi_chg 0x0000001e &rpm 0x000000ab>;
		io-channel-names = "usb_real_type", "pd_active", "pd_voltage_min", "pd_voltage_max", "pd_current_max", "typec_cc_orientation", "pd_usb_suspend_supported", "pd_in_hard_reset", "cc_chip_id";
	};
	xm_pd_adapter {
		compatible = "xiaomi,pd_adapter";
		adapter_name = "pd_adapter";
	};
};

&usb0 {
	extcon = <&rpm &eud>;
};

&tlmm {
	bq2589x_int_default: bq2589x_int_default {
		mux {
			pins = "gpio105";
			function = "gpio";
		};
		config {
			pins = "gpio105";
			drive-strength = <0x00000002>;
			bias-pull-up;
			input-enable;
		};
	};
	bq2589x_usb_switch_default: bq2589x_usb_switch_default {
		mux {
			pins = "gpio66";
			function = "gpio";
		};
		config {
			pins = "gpio66";
			drive-strength = <0x00000002>;
			bias-disable;
			output-low;
		};
	};
};

&qupv3_se1_i2c {
	status = "okay";
	#address-cells = <0x00000001>;
	#size-cells = <0x00000000>;
	bq2589x: bq2589x@6A {
		#io-channel-cells = <0x00000001>;
		compatible = "ti,bq2589x-1";
		reg = <0x0000006a>;
		#address-cells = <0x00000001>;
		#size-cells = <0x00000000>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x00000069 0x00000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&bq2589x_int_default &bq2589x_usb_switch_default>;
		intr-gpio = <&tlmm 0x00000069 0x00000000>;
		usb-switch1 = <&tlmm 0x00000042 0x00000000>;
		dpdm-supply = <&usb2_phy0>;
		ti,bq2589x,vbus-volt-high-level = <0x000021fc>;
		ti,bq2589x,vbus-volt-low-level = <0x00001130>;
		ti,bq2589x,vbat-min-volt-to-tuneup = <0x00000bb8>;
		ti,bq2589x,charge-voltage = <0x00001162>;
		ti,bq2589x,charge-current = <0x000007d0>;
		ti,bq2589x,charge-current-1500 = <0x000005dc>;
		ti,bq2589x,charge-current-1000 = <0x000003e8>;
		ti,bq2589x,charge-current-500 = <0x000001f4>;
		ti,bq2589x,charge-current-3500 = <0x00000dac>;
		ti,bq2589x,input-current-2000 = <0x000007d0>;
		ti,bq2589x,term-current = <0x00000100>;
		ti,bq2589x,enable-auto-dpdm;
		ti,bq2589x,enable-termination;
		ti,bq2589x,enable-ico;
		ti,bq2589x,use-absolute-vindpm;
		io-channels = <&maxim_ds28e16 0x0000008b &sm5602 0x000000a2 &sm5602 0x000000b0 &nopmi_chg 0x0000008e &nopmi_chg 0x0000000a &nopmi_chg 0x00000004 &nopmi_chg 0x00000003 &nopmi_chg 0x00000001 &nopmi_chg 0x000000af>;
		io-channel-names = "ds_chip_ok", "fastcharge_mode", "fg_monitor_work", "mtbf_cur", "usb_real_type", "pd_active", "typec_cc_orientation", "typec_mode", "ffc_disable";
	};
	sm5602: sm5602@71 {
		#io-channel-cells = <0x00000001>;
		compatible = "sm,sm5602";
		reg = <0x00000071>;
		sm,en_temp_ex;
		sm,en_batt_det;
		sm,iocv_man_mode;
		sm,misc = <0x00000800>;
		sm,aging_ctrl = <0x00000121>;
		sm,cycle_cfg = <0x00007000>;
		sm,rsns = <0x00000000>;
		sm,fg_irq_set = <0x000007ff>;
		sm,low_soc1 = <0x00000001>;
		sm,low_soc2 = <0x0000000f>;
		sm,v_l_alarm = <0x00000d48>;
		sm,v_h_alarm = <0x00001162>;
		sm,battery_table_num = <0x00000000>;
		sm,param_version = <0x00000006>;
		sm,t_l_alarm_in = <0x00000036>;
		sm,t_h_alarm_in = <0x00000001>;
		sm,t_l_alarm_ex = <0x0000d3d8>;
		sm,t_h_alarm_ex = <0x00009245>;
		sm,shutdown-delay-enable;
