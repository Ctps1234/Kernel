			compatible = "arm,gic-v3";
			#interrupt-cells = <0x00000003>;
			interrupt-controller;
			interrupt-parent = <&intc>;
			#redistributor-regions = <0x00000001>;
			redistributor-stride = <0x00000000 0x00020000>;
			reg = <0x0f200000 0x00010000 0x0f300000 0x00100000>;
			interrupts = <0x00000001 0x00000009 0x00000004>;
			phandle = <0x00000001>;
		};
		clk_virt: interconnect {
			compatible = "qcom,bengal-clk_virt";
			qcom,keepalive;
			#interconnect-cells = <0x00000001>;
			clock-names = "bus", "bus_a";
			clocks = <&rpmcc 0x0000006a &rpmcc 0x0000006b>;
			phandle = <0x00000101>;
		};
		system_noc: interconnect@1880000 {
			compatible = "qcom,bengal-system_noc";
