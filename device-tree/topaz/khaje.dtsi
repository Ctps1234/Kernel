	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
		CPU_PD0: cpu-pd0 {
			#power-domain-cells = <0x00000000>;
			power-domains = <&CLUSTER_PD0>;
			phandle = <0x00000003>;
		};
		CPU_PD1: cpu-pd1 {
			#power-domain-cells = <0x00000000>;
			power-domains = <&CLUSTER_PD0>;
