			power-domains = <&CLUSTER_PD2>;
			domain-idle-states = <0x0000001c>;
			phandle = <0x00000019>;
		};
		CLUSTER_PD1: cluster-pd1 {
			#power-domain-cells = <0x00000000>;
			power-domains = <&CLUSTER_PD2>;
			domain-idle-states = <0x0000001d>;
			phandle = <0x0000001a>;
		};
		CLUSTER_PD2: cluster-pd2 {
