/*
 * DT da SoC Khaje (subconjunto curado) gerada por tools/curate_dt.py.
 * Fonte: khaje-base-reference.dts, sha256 a0517193be3da264...
 * Nao revisado por upstream nem validado em hardware. Nao flashar.
 * Licenca: a definir antes de submissao (base Qualcomm, revisar).
 */

/ {
	model = "Qualcomm Technologies, Inc. Khaje SoC";
	compatible = "qcom,khaje";
	qcom,msm-id = <0x00000206 0x00010000>;
	interrupt-parent = <&intc>;
	#address-cells = <0x00000002>;
	#size-cells = <0x00000002>;
	qcom,board-id = <0x00000000 0x00000000>;
	aliases {
		ufshc1 = "/soc/ufshc@4804000";
		serial0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a90000";
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a8c000";
		spi0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/spi@4a80000";
